+def _canonicalize_args(args: Any) -> Any:
+    """Canonicalize tool call arguments for fingerprinting.
+
+    - Sort dict keys recursively
+    - Convert tuples to lists
+    - Trim whitespace from strings
+    - Preserve numeric and boolean types
+    """
+    if isinstance(args, dict):
+        return {k: _canonicalize_args(v) for k, v in sorted(args.items())}
+    elif isinstance(args, (list, tuple)):
+        return [_canonicalize_args(item) for item in args]
+    elif isinstance(args, str):
+        return args.strip()
+    else:
+        # Preserve numeric, boolean, None, etc.
+        return args
+
