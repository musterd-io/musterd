+func TestMuxHandleFuncPatternValidation(t *testing.T) {
+	testCases := []struct {
+		name           string
+		pattern        string
+		shouldPanic    bool
+		method         string // Method to be used for the test request
+		path           string // Path to be used for the test request
+		expectedBody   string // Expected response body
+		expectedStatus int    // Expected HTTP status code
+	}{
+		// Valid patterns
+		{
+			name:           "Valid pattern without HTTP method",
+			pattern:        "/api/users",
+			shouldPanic:    false,
+			method:         "GET",
+			path:           "/api/users",
+			expectedBody:   "all methods",
+			expectedStatus: http.StatusOK,
+		},
+		{
+			name:           "Valid pattern with HTTP GET",
+			pattern:        "GET /api/users/{id}",
+			shouldPanic:    false,
+			method:         "GET",
+			path:           "/api/users/123",
+			expectedBody:   "get user",
+			expectedStatus: http.StatusOK,
+		},
+		{
+			name:           "Valid pattern with HTTP POST",
+			pattern:        "POST /api/products",
+			shouldPanic:    false,
+			method:         "POST",
+			path:           "/api/products",
+			expectedBody:   "create product",
+			expectedStatus: http.StatusOK,
+		},
+		{
+			name:           "Valid pattern with HTTP DELETE and wildcard",
+			pattern:        "DELETE /admin/*",
+			shouldPanic:    false,
+			method:         "DELETE",
+			path:           "/admin/users/123",
+			expectedBody:   "delete admin",
+			expectedStatus: http.StatusOK,
+		},
+		{
+			name:           "Valid pattern with HTTP PUT and prefix",
+			pattern:        "PUT /api/v1/*",
+			shouldPanic:    false,
+			method:         "PUT",
+			path:           "/api/v1/resource",
+			expectedBody:   "put resource",
+			expectedStatus: http.StatusOK,
+		},
+		// Invalid patterns
+		{
+			name:        "Invalid pattern with unsupported method",
+			pattern:     "INVALID /api/endpoint",
+			shouldPanic: true,
+		},
+		{
+			name:        "Invalid pattern missing space",
+			pattern:     "GET/api/users",
+			shouldPanic: true,
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			defer func() {
+				if r := recover(); r != nil && !tc.shouldPanic {
+					t.Errorf("Unexpected panic for pattern %s", tc.pattern)
+				}
+			}()
+
+			r := NewRouter()
+			r.HandleFunc(tc.pattern, func(w http.ResponseWriter, r *http.Request) {
+				w.Write([]byte(tc.expectedBody))
+			})
+
+			if !tc.shouldPanic {
+				// Use testRequest for valid patterns
+				ts := httptest.NewServer(r)
+				defer ts.Close()
+
+				resp, body := testRequest(t, ts, tc.method, tc.path, nil)
+				if body != tc.expectedBody || resp.StatusCode != tc.expectedStatus {
+					t.Errorf("Expected status %d and body %s; got status %d and body %s for pattern %s",
+						tc.expectedStatus, tc.expectedBody, resp.StatusCode, body, tc.pattern)
+				}
+			}
+		})
+	}
+}
