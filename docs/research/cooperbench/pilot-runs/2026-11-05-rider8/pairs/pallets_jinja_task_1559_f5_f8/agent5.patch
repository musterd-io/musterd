+"""Test the conditional translation extension."""
+from jinja2 import Environment
+from jinja2.ext import ConditionalTranslationExtension
+
+
+def test_ctrans_basic():
+    """Test basic conditional translation rendering."""
+    env = Environment(extensions=[ConditionalTranslationExtension])
+
+    # Mock gettext function
+    def simple_gettext(message):
+        return f"Translated: {message}"
+
+    env.globals['gettext'] = simple_gettext
+
+    # Test with condition=True
+    template = env.from_string("{% ctrans condition=show, message='Hello' %}")
+    result = template.render(show=True)
+    assert result == "Translated: Hello", f"Expected 'Translated: Hello', got '{result}'"
+
+    # Test with condition=False
+    result = template.render(show=False)
+    assert result == "", f"Expected empty string, got '{result}'"
+
+    print("✓ Basic conditional translation test passed")
+
+
+def test_ctrans_with_variables():
+    """Test conditional translation with variable substitution."""
+    env = Environment(extensions=[ConditionalTranslationExtension])
+
+    def simple_gettext(message):
+        return message
+
+    env.globals['gettext'] = simple_gettext
+
+    # Test with variables
+    template = env.from_string("{% ctrans condition=show, message='Hello %(name)s', name=user %}")
+    result = template.render(show=True, user="Alice")
+    assert "Alice" in result, f"Expected 'Alice' in result, got '{result}'"
+
+    result = template.render(show=False, user="Alice")
+    assert result == "", f"Expected empty string, got '{result}'"
+
+    print("✓ Conditional translation with variables test passed")
+
+
+def test_ctrans_expression_condition():
+    """Test conditional translation with complex expressions."""
+    env = Environment(extensions=[ConditionalTranslationExtension])
+
+    def simple_gettext(message):
+        return f"Translated: {message}"
+
+    env.globals['gettext'] = simple_gettext
+
+    # Test with expression
+    template = env.from_string("{% ctrans condition=count > 5, message='Many items' %}")
+    result = template.render(count=10)
+    assert result == "Translated: Many items", f"Expected translation, got '{result}'"
+
+    result = template.render(count=3)
+    assert result == "", f"Expected empty string, got '{result}'"
+
+    print("✓ Conditional translation with expression test passed")
+
+
+if __name__ == "__main__":
+    test_ctrans_basic()
+    test_ctrans_with_variables()
+    test_ctrans_expression_condition()
+    print("\n✓ All tests passed!")
