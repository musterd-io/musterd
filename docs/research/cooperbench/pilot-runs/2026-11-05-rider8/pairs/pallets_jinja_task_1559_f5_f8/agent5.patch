+class ConditionalTranslationExtension(Extension):
+    """Adds a `ctrans` tag for conditional translation rendering.
+
+    The ctrans tag conditionally renders translations based on runtime boolean
+    expressions. The condition is evaluated synchronously after parsing but
+    before translation rendering.
+
+    Example usage:
+        {% ctrans condition=user.locale == 'en', message='Hello' %}
+        {% ctrans condition=show_greeting, message=greeting_text %}
+    """
+
+    tags = {"ctrans"}
+
+    def parse(self, parser: "Parser") -> nodes.Output:
+        """Parse the ctrans tag.
+
+        Syntax: {% ctrans condition=<expr>, message=<expr> %}
+
+        Returns an Output node with a conditional expression.
+        """
+        lineno = next(parser.stream).lineno
+
+        condition = None
+        message = None
+        variables: t.Dict[str, nodes.Expr] = {}
+        first_arg = True
+
+        # Parse the arguments
+        while parser.stream.current.type != "block_end":
+            if not first_arg:
+                parser.stream.expect("comma")
+            first_arg = False
+
+            token = parser.stream.expect("name")
+            parser.stream.expect("assign")
+
+            if token.value == "condition":
+                condition = parser.parse_expression(with_condexpr=False)
+            elif token.value == "message":
+                message = parser.parse_expression(with_condexpr=False)
+            else:
+                # Collect other variables for message formatting
+                variables[token.value] = parser.parse_expression(with_condexpr=False)
+
+        # Validate required parameters
+        if condition is None:
+            parser.fail(
+                "ctrans tag requires 'condition' parameter",
+                lineno,
+                exc=TemplateSyntaxError,
+            )
+
+        if message is None:
+            parser.fail(
+                "ctrans tag requires 'message' parameter",
+                lineno,
+                exc=TemplateSyntaxError,
+            )
+
+        # Create the translation call
+        gettext_call = nodes.Call(
+            nodes.Name("gettext", "load"),
+            [message],
+            [],
+            None,
+            None,
+        )
+
+        # Apply variable substitution if variables are provided
+        if variables:
+            gettext_call = nodes.MarkSafeIfAutoescape(gettext_call)
+            gettext_call = nodes.Mod(
+                gettext_call,
+                nodes.Dict(
+                    [
+                        nodes.Pair(nodes.Const(key), value)
+                        for key, value in variables.items()
+                    ]
+                ),
+            )
+        else:
+            gettext_call = nodes.MarkSafeIfAutoescape(gettext_call)
+
+        # Create a conditional expression: gettext_call if condition else ''
+        cond_expr = nodes.CondExpr(condition, gettext_call, nodes.Const(""), lineno=lineno)
+
+        return nodes.Output([cond_expr], lineno=lineno)
+
