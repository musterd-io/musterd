+        # For other unexpected node types, provide a generic error
+        if not isinstance(expr, allowed_types):
+            parser.fail(
+                f"Variable {name!r} uses an expression type incompatible with translation contexts",
+                lineno,
+                exc=TemplateSyntaxError,
+            )
