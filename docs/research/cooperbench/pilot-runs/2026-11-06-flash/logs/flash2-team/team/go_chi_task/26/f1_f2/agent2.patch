new file mode 100644
index 0000000..3520a26
--- /dev/null
+++ b/metrics.go
@@ -0,0 +1,57 @@
+package chi
+
+import (
+	"context"
+	"net/http"
+	"time"
+)
+
+// MetricsCollector receives a notification for every request that is matched
+// to a route by a Mux, along with the time it took to serve it.
+type MetricsCollector interface {
+	RecordHit(ctx context.Context, r *http.Request, duration time.Duration)
+}
+
+// RouteMetric describes a single route hit.
+type RouteMetric struct {
+	Pattern  string            // matched route pattern, e.g. "/users/{id}"
+	Method   string            // HTTP method of the request
+	Path     string            // request URL path
+	Duration time.Duration     // time taken to serve the request
+	Params   map[string]string // URL parameters keyed by name, e.g. {"id": "123"}
+}
+
+// SimpleMetricsCollector is a MetricsCollector that builds a RouteMetric for
+// every hit and passes it to the OnHit callback.
+type SimpleMetricsCollector struct {
+	OnHit func(RouteMetric)
+}
+
+// RecordHit implements the MetricsCollector interface.
+func (s *SimpleMetricsCollector) RecordHit(ctx context.Context, r *http.Request, duration time.Duration) {
+	if s == nil || s.OnHit == nil {
+		return
+	}
+
+	metric := RouteMetric{
+		Method:   r.Method,
+		Path:     r.URL.Path,
+		Duration: duration,
+		Params:   map[string]string{},
+	}
+
+	rctx, _ := ctx.Value(RouteCtxKey).(*Context)
+	if rctx == nil {
+		rctx = RouteContext(r.Context())
+	}
+	if rctx != nil {
+		metric.Pattern = rctx.RoutePattern()
+		for i, key := range rctx.URLParams.Keys {
+			if i < len(rctx.URLParams.Values) {
+				metric.Params[key] = rctx.URLParams.Values[i]
+			}
+		}
+	}
+
+	s.OnHit(metric)
+}
diff --git a/metrics_test.go b/metrics_test.go
new file mode 100644
index 0000000..06e6f58
--- /dev/null
+++ b/metrics_test.go
@@ -0,0 +1,36 @@
+package chi
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestMetricsCollector(t *testing.T) {
+	var got []RouteMetric
+	r := NewRouter()
+	r.SetMetricsCollector(&SimpleMetricsCollector{OnHit: func(m RouteMetric) { got = append(got, m) }})
+	r.Get("/users/{id}", func(w http.ResponseWriter, r *http.Request) { w.Write([]byte("ok")) })
+
+	ts := httptest.NewServer(r)
+	defer ts.Close()
+
+	if _, body := testRequest(t, ts, "GET", "/users/123", nil); body != "ok" {
+		t.Fatalf("unexpected body %q", body)
+	}
+	testRequest(t, ts, "GET", "/missing", nil)
+
+	if len(got) != 1 {
+		t.Fatalf("expected 1 metric, got %d", len(got))
+	}
+	m := got[0]
+	if m.Pattern != "/users/{id}" || m.Method != "GET" || m.Path != "/users/123" {
+		t.Fatalf("unexpected metric %+v", m)
+	}
+	if m.Params["id"] != "123" {
+		t.Fatalf("unexpected params %v", m.Params)
+	}
+	if m.Duration < 0 {
+		t.Fatalf("negative duration")
+	}
+}
