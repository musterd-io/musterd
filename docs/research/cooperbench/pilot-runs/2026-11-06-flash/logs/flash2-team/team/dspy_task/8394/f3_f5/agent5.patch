+# On-disk blob format: b"DSPC" magic + 1 codec byte + (possibly compressed) pickle payload.
+MAGIC_HEADER = b"DSPC"
+_CODEC_TO_BYTE = {None: b"\x00", "gzip": b"\x01", "zlib": b"\x02"}
+_BYTE_TO_CODEC = {v[0]: k for k, v in _CODEC_TO_BYTE.items()}
+
+
+def _validate_codec(codec: Optional[str]) -> Optional[str]:
+    if codec not in _CODEC_TO_BYTE:
+        raise ValueError(f"Unsupported compression codec: {codec!r}. Expected one of 'gzip', 'zlib', or None.")
+    return codec
+
+
+def _encode_value(value: Any, codec: Optional[str]) -> bytes:
+    """Pickle `value`, optionally compress it, and prepend the DSPy magic header."""
+    payload = cloudpickle.dumps(value)
+    if codec == "gzip":
+        payload = gzip.compress(payload)
+    elif codec == "zlib":
+        payload = zlib.compress(payload)
+    return MAGIC_HEADER + _CODEC_TO_BYTE[codec] + payload
+
+
+def _decode_value(data: Any) -> Any:
+    """Decode a value read from disk. Header-less values are treated as legacy entries."""
+    if not isinstance(data, (bytes, bytearray, memoryview)):
+        # Legacy entry already unpickled by DiskCache.
+        return data
+    data = bytes(data)
+    if data[:4] != MAGIC_HEADER or len(data) < 5:
+        # Legacy raw pickle.
+        try:
+            return pickle.loads(data)
+        except Exception:
+            return data
+    codec_byte = data[4]
+    if codec_byte not in _BYTE_TO_CODEC:
+        raise ValueError(f"Unknown DSPy cache codec byte: {codec_byte}")
+    codec = _BYTE_TO_CODEC[codec_byte]
+    payload = data[5:]
+    if codec == "gzip":
+        payload = gzip.decompress(payload)
+    elif codec == "zlib":
+        payload = zlib.decompress(payload)
+    return pickle.loads(payload)
+
 
