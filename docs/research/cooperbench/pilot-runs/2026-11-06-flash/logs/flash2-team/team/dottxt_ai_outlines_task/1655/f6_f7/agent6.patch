+url = Regex(
+    r"https?://(?:(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\.)+[a-zA-Z]{2,}|localhost|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9]))(?::[0-9]{1,5})?(?:/[a-zA-Z0-9\-._~:/?#\[\]@!$&'()*+,;=%]*)?(?:\?[a-zA-Z0-9\-._~:/?#\[\]@!$&'()*+,;=%]*)?(?:#[a-zA-Z0-9\-._~:/?#\[\]@!$&'()*+,;=%]*)?"
