+    def _token_start_positions(self, text: str, tokens: Sequence[int]) -> list[int]:
+        """Returns the starting character index in `text` of each token in `tokens`.
+
+        Tokens operate on UTF-8 bytes, so a token may start partway through a multi-byte
+        character; in that case the index of the character containing that byte is used.
+        """
+        # Map each UTF-8 byte offset to the index of the character it belongs to
