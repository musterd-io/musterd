+    def _get_priority_kwargs(self) -> dict[str, t.Any]:
+        """Return extra keyword arguments for :class:`subprocess.Popen`
+        that apply the configured process priority. Unknown or
+        unsupported priorities result in no extra arguments.
+        """
+        import subprocess
+
+        priority = self.process_priority
+
+        if priority is None:
+            return {}
+
+        if WIN:
+            flags = {
+                "low": "IDLE_PRIORITY_CLASS",
+                "below_normal": "BELOW_NORMAL_PRIORITY_CLASS",
+                "normal": "NORMAL_PRIORITY_CLASS",
+                "above_normal": "ABOVE_NORMAL_PRIORITY_CLASS",
+                "high": "HIGH_PRIORITY_CLASS",
+            }
+            name = flags.get(priority)
+            flag = getattr(subprocess, name, None) if name is not None else None
+
+            if flag is None:
+                return {}
+
+            return {"creationflags": flag}
+
+        increments = {
+            "low": 10,
+            "below_normal": 5,
+            "normal": 0,
+            "above_normal": -5,
+            "high": -10,
+        }
+        increment = increments.get(priority)
+
+        if increment is None or not increment or not hasattr(os, "nice"):
+            return {}
+
+        def set_priority() -> None:
+            # Lowering the niceness usually requires privileges. Failing
+            # to change the priority must not prevent the editor from
+            # launching.
+            try:
+                os.nice(increment)
+            except OSError:
+                pass
+
+        return {"preexec_fn": set_priority}
