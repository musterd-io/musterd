@@ -580,3 +580,27 @@ def test_autocontrast_preserve_one_color(color: tuple[int, int, int]) -> None:
         img, cutoff=10, preserve_tone=True
     )  # single color 10 cutoff
     assert_image_equal(img, out)
+
+
+def test_exif_transpose_logger() -> None:
+    messages: list[str] = []
+    with Image.open("Tests/images/hopper_orientation_6.jpg") as im:
+        transposed = ImageOps.exif_transpose(im, logger=messages.append)
+    assert transposed is not None
+    assert any("ROTATE_270" in m for m in messages)
+    assert any("removed orientation" in m for m in messages)
+
+    messages.clear()
+    with Image.open("Tests/images/hopper.jpg") as im:
+        ImageOps.exif_transpose(im, logger=messages.append)
+    assert any("no transpose needed" in m for m in messages)
+
+
+def test_exif_transpose_std_logger(caplog: pytest.LogCaptureFixture) -> None:
+    import logging
+
+    log = logging.getLogger("test_exif_transpose")
+    with caplog.at_level(logging.DEBUG, logger="test_exif_transpose"):
+        with Image.open("Tests/images/hopper_orientation_6.jpg") as im:
+            ImageOps.exif_transpose(im, in_place=True, logger=log)
+    assert any("ROTATE_270" in r.getMessage() for r in caplog.records)
