+    def _quantize_error(self, quantized):
+        """Mean square error between this image and a quantized version."""
+        from . import ImageChops, ImageStat
+
+        diff = ImageChops.difference(self, quantized.convert(self.mode))
+        stat = ImageStat.Stat(diff)
+        if not stat.count[0]:
+            return 0.0
+        return sum(s / c for s, c in zip(stat.sum2, stat.count)) / len(stat.count)
+
+    def _adjust_palette_lightness(self, lightness_factor):
+        # Scale the color channels of every palette entry, leaving alpha intact
+        from . import ImagePalette
+
+        mode = self.im.getpalettemode()
+        channels = len(mode)
+        data = bytearray(self.im.getpalette(mode, mode))
+        for i in range(len(data)):
+            if i % channels < 3:
+                data[i] = min(255, max(0, int(round(data[i] * lightness_factor))))
+        self.im.putpalette(mode, bytes(data))
+        self.palette = ImagePalette.ImagePalette(mode, self.im.getpalette(mode, mode))
