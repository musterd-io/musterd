+def _apply_transformers(
+    text: str,
+    transformers: Callable[[str], str] | Sequence[Callable[[str], str]] | None,
+) -> str:
+    if transformers is None:
+        return text
+    if callable(transformers):
+        transformers = [transformers]
+    for transformer in transformers:
+        if not callable(transformer):
+            raise TypeError(f"Transformer {transformer!r} is not callable")
+        text = transformer(text)
+        if not isinstance(text, str):
+            raise TypeError(
+                f"Transformer {transformer!r} must return a str, got {type(text).__name__}"
+            )
+    return text
