+// collectAllowedMethods records the methods registered on a matched route's
+// endpoints, keeping methodsAllowed sorted and free of duplicates.
+func (x *Context) collectAllowedMethods(eps endpoints) {
+	for mt, ep := range eps {
+		if ep == nil || ep.handler == nil {
+			continue
+		}
+		if _, ok := reverseMethodMap[mt]; !ok {
+			continue
+		}
+		i := sort.Search(len(x.methodsAllowed), func(i int) bool { return x.methodsAllowed[i] >= mt })
+		if i < len(x.methodsAllowed) && x.methodsAllowed[i] == mt {
+			continue
+		}
+		x.methodsAllowed = append(x.methodsAllowed, 0)
+		copy(x.methodsAllowed[i+1:], x.methodsAllowed[i:])
+		x.methodsAllowed[i] = mt
+	}
+}
diff --git a/middleware/allowed_methods.go b/middleware/allowed_methods.go
new file mode 100644
index 0000000..2a0d0e6
--- /dev/null
+++ b/middleware/allowed_methods.go
@@ -0,0 +1,51 @@
+package middleware
+
+import (
+	"net/http"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// SetAllowHeader adds the Allow header for 405 responses based on
+// registered methods for the requested path.
+//
+// This middleware is a workaround for the routing context not being able to
+// expose the allowed methods to custom 405 handlers.
+func SetAllowHeader(next http.Handler) http.Handler {
+	fn := func(w http.ResponseWriter, r *http.Request) {
+		rctx := chi.RouteContext(r.Context())
+		if rctx == nil || rctx.Routes == nil {
+			next.ServeHTTP(w, r)
+			return
+		}
+
+		url := r.URL.RawPath
+		if url == "" {
+			url = r.URL.Path
+		}
+
+		if rctx.Routes.Match(chi.NewRouteContext(), r.Method, url) {
+			next.ServeHTTP(w, r)
+			return
+		}
+
+		for _, m := range []string{
+			http.MethodGet,
+			http.MethodHead,
+			http.MethodPost,
+			http.MethodPut,
+			http.MethodPatch,
+			http.MethodDelete,
+			http.MethodConnect,
+			http.MethodOptions,
+			http.MethodTrace,
+		} {
+			if rctx.Routes.Match(chi.NewRouteContext(), m, url) {
+				w.Header().Add("Allow", m)
+			}
+		}
+
+		next.ServeHTTP(w, r)
+	}
+	return http.HandlerFunc(fn)
+}
