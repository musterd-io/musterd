@@ -480,8 +480,18 @@ func (mx *Mux) updateRouteHandler() {
 }
 
 // methodNotAllowedHandler is a helper function to respond with a 405,
-// method not allowed.
-func methodNotAllowedHandler(w http.ResponseWriter, r *http.Request) {
-	w.WriteHeader(405)
-	w.Write(nil)
+// method not allowed. The Allow header is set to the given allowed methods.
+func methodNotAllowedHandler(methodsAllowed ...methodTyp) func(w http.ResponseWriter, r *http.Request) {
+	return func(w http.ResponseWriter, r *http.Request) {
+		// Don't duplicate values already set, e.g. by middleware.SetAllowHeader
+		if len(w.Header()["Allow"]) == 0 {
+			for _, m := range methodsAllowed {
+				if name, ok := reverseMethodMap[m]; ok {
+					w.Header().Add("Allow", name)
+				}
+			}
+		}
+		w.WriteHeader(405)
+		w.Write(nil)
+	}
 }
