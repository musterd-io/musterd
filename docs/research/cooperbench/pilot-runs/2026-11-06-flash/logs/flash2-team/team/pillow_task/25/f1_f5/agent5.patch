+    @pytest.mark.parametrize("mode", ("RGB", "RGBA", "L"))
+    def test_save_mark_corners(self, mode: str, tmp_path: Path) -> None:
+        temp_file = tmp_path / "temp.png"
+        im = Image.new(mode, (10, 8))
+        original = im.copy()
+
+        im.save(temp_file, mark_corners=True)
+
+        # The original image is not modified
+        assert_image_equal(im, original)
+
+        expected = Image.new("RGB", (1, 1), "#f00").convert(mode).getpixel((0, 0))
+        with Image.open(temp_file) as reloaded:
+            assert reloaded.getpixel((0, 0)) == expected
+            assert reloaded.getpixel((9, 7)) == expected
+            assert reloaded.getpixel((1, 1)) == original.getpixel((1, 1))
+            assert reloaded.getpixel((9, 0)) == original.getpixel((9, 0))
+
+    def test_save_without_mark_corners(self, tmp_path: Path) -> None:
+        temp_file = tmp_path / "temp.png"
+        im = Image.new("RGB", (10, 8))
+
+        im.save(temp_file, mark_corners=False)
+
+        with Image.open(temp_file) as reloaded:
+            assert_image_equal(reloaded, im)
+
     def test_dump(self, tmp_path: Path) -> None:
         im = Image.new("L", (10, 10))
