+    @property
+    def aliases(self) -> t.Dict[str, str]:
+        """Mapping of alias names to the template names they point to.
+
+        .. versionadded:: 3.1
+        """
+        try:
+            return self.__dict__["_aliases"]  # type: ignore
+        except KeyError:
+            rv: t.Dict[str, str] = {}
+            self.__dict__["_aliases"] = rv
+            return rv
+
+    def add_alias(self, alias: str, target: str) -> None:
+        """Make the template ``target`` available under the name ``alias``.
+        Adding an alias that already exists replaces its target. Aliases
+        are not resolved recursively.
+
+        .. versionadded:: 3.1
+        """
+        self.aliases[alias] = target
+
+    def remove_alias(self, alias: str) -> None:
+        """Remove an alias added with :meth:`add_alias`. Does nothing if
+        the alias does not exist.
+
+        .. versionadded:: 3.1
+        """
+        self.aliases.pop(alias, None)
+
+    def resolve_alias(self, template: str) -> str:
+        """Return the template name an alias points to, or ``template``
+        unchanged if it is not an alias.
+
+        .. versionadded:: 3.1
+        """
+        aliases = self.__dict__.get("_aliases")
+
+        if aliases:
+            return aliases.get(template, template)
+
+        return template
+
