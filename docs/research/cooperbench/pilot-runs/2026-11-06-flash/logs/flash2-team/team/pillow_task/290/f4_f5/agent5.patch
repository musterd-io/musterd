@@ -85,3 +85,34 @@ def test_transparent_colors_equal():
     converted = im.quantize()
     converted_px = converted.load()
     assert converted_px[0, 0] == converted_px[0, 1]
+
+
+def test_lightness_factor():
+    image = hopper()
+    default = image.quantize()
+    brighter = image.quantize(lightness_factor=1.1)
+    darker = image.quantize(lightness_factor=0.9)
+
+    default_palette = default.getpalette()
+    for factor, converted in ((1.1, brighter), (0.9, darker)):
+        palette = converted.getpalette()
+        assert len(palette) == len(default_palette)
+        for original, adjusted in zip(default_palette, palette):
+            assert adjusted == min(255, int(round(original * factor)))
+        assert converted.palette.palette == bytes(palette)
+
+
+def test_lightness_factor_palette():
+    image = hopper()
+    with Image.open("Tests/images/caption_6_33_22.png") as palette:
+        palette = palette.convert("P")
+    default = image.quantize(palette=palette)
+    brighter = image.quantize(palette=palette, lightness_factor=2)
+    for original, adjusted in zip(default.getpalette(), brighter.getpalette()):
+        assert adjusted == min(255, original * 2)
+
+
+@pytest.mark.parametrize("factor", (0, -1))
+def test_lightness_factor_invalid(factor):
+    with pytest.raises(ValueError):
+        hopper().quantize(lightness_factor=factor)
