+    def _record_event(self, event: str) -> None:
+        """Record a cache event (`mem_hits`, `disk_hits` or `misses`) globally and in the active usage tracker."""
+        with self._lock:
+            self._stats[event] += 1
+            if event != "misses":
+                self._stats["hits"] += 1
+
+        from dspy.dsp.utils.settings import settings
+
+        tracker = settings.usage_tracker
+        if tracker is not None and hasattr(tracker, "add_cache_event"):
+            tracker.add_cache_event(event)
+
+    def stats(self) -> Dict[str, int]:
+        """Return the global cache statistics: `hits`, `mem_hits`, `disk_hits` and `misses`."""
+        with self._lock:
+            return dict(self._stats)
+
+    def reset_stats(self) -> None:
+        """Reset all global cache statistics to zero."""
+        with self._lock:
+            for k in ("hits", "mem_hits", "disk_hits", "misses"):
+                self._stats[k] = 0
+
     def reset_memory_cache(self) -> None:
