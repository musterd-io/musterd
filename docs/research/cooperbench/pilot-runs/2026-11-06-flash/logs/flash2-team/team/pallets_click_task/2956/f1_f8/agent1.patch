+    def _record_option_history(
+        self, name: str, value: t.Any, source: ParameterSource | None
+    ) -> None:
+        """Record a value change for a parameter if tracking is enabled."""
+        if not self._track_changes or name is None:
+            return
+
+        import time
+
+        self._option_history.setdefault(name, []).append(
+            {"value": value, "source": source, "timestamp": time.time()}
+        )
+
+    def get_option_history(self, name: str) -> list[dict[str, t.Any]] | None:
+        """Get the history of values set for an option. Each entry is a
+        dict with ``value``, ``source`` (a
+        :class:`~click.core.ParameterSource`), and ``timestamp`` keys.
+
+        :param name: The parameter name (``"count"``) or one of its option
+            flags (``"--count"``, ``"-c"``).
+        :return: ``None`` if tracking is disabled, otherwise a list of
+            history entries, empty if no history exists.
+        """
+        if not self._track_changes:
+            return None
+
+        if name not in self._option_history:
+            for param in self.command.params:
+                if name in getattr(param, "opts", ()) or name in getattr(
+                    param, "secondary_opts", ()
+                ):
+                    if param.name is not None:
+                        name = param.name
+                    break
+
+        return list(self._option_history.get(name, []))
+
 
