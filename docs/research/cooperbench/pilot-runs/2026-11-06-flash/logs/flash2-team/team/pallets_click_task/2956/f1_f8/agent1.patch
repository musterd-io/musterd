diff --git a/src/click/types.py b/src/click/types.py
index 684cb3b..ad51da7 100644
--- a/src/click/types.py
+++ b/src/click/types.py
@@ -1163,3 +1163,78 @@ class OptionHelpExtra(t.TypedDict, total=False):
     default: str
     range: str
     required: str
+
+
+def _complete_usernames(incomplete: str) -> list[str]:
+    """Return system usernames starting with ``incomplete``."""
+    try:
+        import pwd
+
+        names = {entry.pw_name for entry in pwd.getpwall()}
+    except (ImportError, OSError):
+        names = set()
+
+        for var in ("USER", "USERNAME", "LOGNAME"):
+            value = os.environ.get(var)
+
+            if value:
+                names.add(value)
+
+    return sorted(name for name in names if name.startswith(incomplete))
+
+
+def _complete_git_branches(incomplete: str) -> list[str]:
+    """Return local and remote git branch names starting with
+    ``incomplete``. Returns an empty list outside a git repository.
+    """
+    import subprocess
+
+    try:
+        result = subprocess.run(
+            ["git", "branch", "-a", "--format=%(refname:short)"],
+            capture_output=True,
+            text=True,
+            timeout=2,
+        )
+    except (OSError, subprocess.SubprocessError):
+        return []
+
+    if result.returncode != 0:
+        return []
+
+    branches = []
+
+    for line in result.stdout.splitlines():
+        branch = line.strip()
+
+        if not branch or branch.startswith("("):
+            continue
+
+        if branch.startswith(incomplete) and branch not in branches:
+            branches.append(branch)
+
+    return branches
+
+
+def _complete_env_vars(incomplete: str) -> list[str]:
+    """Return environment variable names starting with ``incomplete``."""
+    return sorted(name for name in os.environ if name.startswith(incomplete))
+
+
+#: Maps option name patterns to a smart completion strategy.
+_SMART_COMPLETION_REGISTRY: dict[str, str] = {
+    "user": "user",
+    "username": "user",
+    "owner": "user",
+    "branch": "branch",
+    "file": "file",
+    "filename": "file",
+    "path": "file",
+    "config": "file",
+    "dir": "dir",
+    "directory": "dir",
+    "folder": "dir",
+    "env": "env",
+    "envvar": "env",
+    "env_var": "env",
+}
