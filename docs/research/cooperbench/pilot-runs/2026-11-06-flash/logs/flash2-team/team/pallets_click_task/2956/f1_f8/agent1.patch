+    def shell_complete(self, ctx: Context, incomplete: str) -> list[CompletionItem]:
+        """Return a list of completions for the incomplete value. A
+        custom ``shell_complete`` callback takes priority, followed by
+        smart completion if ``auto_complete`` is enabled, then the
+        type's completion.
+        """
+        if self._custom_shell_complete is None and self.auto_complete:
+            return self._smart_complete(ctx, incomplete)
+
+        return super().shell_complete(ctx, incomplete)
+
+    def _smart_complete(self, ctx: Context, incomplete: str) -> list[CompletionItem]:
+        """Determine a completion strategy from the option's type, name,
+        and the current environment, and return completions.
+        """
+        from click.shell_completion import CompletionItem
+
+        # Types with their own specific completion take priority.
+        if isinstance(self.type, (types.Choice, types.Path, types.File)):
+            return self.type.shell_complete(ctx, self, incomplete)
+
+        strategy = None
+        candidates = [self.name or ""]
+        candidates.extend(_split_opt(opt)[1] for opt in self.opts)
+
+        for candidate in candidates:
+            key = candidate.lower().replace("-", "_")
+            strategy = types._SMART_COMPLETION_REGISTRY.get(key)
+
+            if strategy is None:
+                # Match on the last word, e.g. "--git-branch" -> "branch".
+                strategy = types._SMART_COMPLETION_REGISTRY.get(key.rsplit("_", 1)[-1])
+
+            if strategy is not None:
+                break
+
+        if strategy == "user":
+            return [CompletionItem(c) for c in types._complete_usernames(incomplete)]
+
+        if strategy == "branch":
+            return [
+                CompletionItem(c) for c in types._complete_git_branches(incomplete)
+            ]
+
+        if strategy == "env":
+            return [CompletionItem(c) for c in types._complete_env_vars(incomplete)]
+
+        if strategy == "file":
+            return [CompletionItem(incomplete, type="file")]
+
+        if strategy == "dir":
+            return [CompletionItem(incomplete, type="dir")]
+
+        # Fall back to the type's completion for unknown patterns.
+        return self.type.shell_complete(ctx, self, incomplete)
+
