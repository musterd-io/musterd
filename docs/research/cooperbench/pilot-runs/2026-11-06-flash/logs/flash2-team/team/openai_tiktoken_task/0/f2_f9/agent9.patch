+def _compress_tokens(tokens: list[int]) -> list[int]:
+    """Removes adjacent repeated tokens, keeping one token of each run."""
+    compressed: list[int] = []
+    for token in tokens:
+        if not compressed or compressed[-1] != token:
+            compressed.append(token)
+    return compressed
