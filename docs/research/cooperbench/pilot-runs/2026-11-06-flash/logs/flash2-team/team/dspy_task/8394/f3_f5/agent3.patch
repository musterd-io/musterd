+def set_ttl(seconds: Optional[int]):
+    """Set the time-to-live (in seconds) for DSPy cache entries, keeping other cache settings.
+
+    Args:
+        seconds: Time-to-live in seconds. If None, entries never expire.
+    """
+    import dspy
+
+    current = getattr(dspy, "cache", None)
+    if isinstance(current, Cache):
+        enable_disk_cache = current.enable_disk_cache
+        enable_memory_cache = current.enable_memory_cache
+        disk_cache_dir = current.disk_cache.directory if enable_disk_cache else DISK_CACHE_DIR
+        disk_size_limit_bytes = current.disk_cache.size_limit if enable_disk_cache else DISK_CACHE_LIMIT
+        memory_max_entries = current.memory_cache.maxsize if enable_memory_cache else 1000000
+    else:
+        enable_disk_cache, enable_memory_cache = True, True
+        disk_cache_dir, disk_size_limit_bytes, memory_max_entries = DISK_CACHE_DIR, DISK_CACHE_LIMIT, 1000000
+
+    dspy.cache = Cache(
+        enable_disk_cache,
+        enable_memory_cache,
+        disk_cache_dir,
+        disk_size_limit_bytes,
+        memory_max_entries,
+        ttl=seconds,
     )
 
 
