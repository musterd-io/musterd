+    You can pass a ``key_transform`` callable to change how each group
+    key is displayed. Grouping and sorting still use the original key.
+
+    .. sourcecode:: jinja
+
+        <ul>{% for month, items in posts|groupby("date", key_transform=fmt) %}
+          <li>{{ month }}: {{ items|length }}</li>
+        {% endfor %}</ul>
+
+    Set ``reverse`` to sort the groups in descending order.
+
+    .. sourcecode:: jinja
+
+        <ul>{% for year, items in posts|groupby("year", reverse=true) %}
+          <li>{{ year }}: {{ items|map(attribute="title")|join(", ") }}</li>
+        {% endfor %}</ul>
+
+    .. versionchanged:: 3.1
+        Added the ``reverse`` and ``key_transform`` parameters.
+
     .. versionchanged:: 3.0
         Added the ``default`` parameter.
 
@@ -1211,8 +1235,10 @@ def sync_do_groupby(
     """
     expr = make_attrgetter(environment, attribute, default=default)
     return [
-        _GroupTuple(key, list(values))
-        for key, values in groupby(sorted(value, key=expr), expr)
+        _GroupTuple(
+            key_transform(key) if key_transform is not None else key, list(values)
+        )
+        for key, values in groupby(sorted(value, key=expr, reverse=reverse), expr)
     ]
 
 
