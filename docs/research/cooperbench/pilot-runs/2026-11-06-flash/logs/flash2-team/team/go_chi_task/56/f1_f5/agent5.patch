+++ b/cors.go
@@ -0,0 +1,154 @@
+package chi
+
+import (
+	"net/http"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// CORSOptions configures the CORS middleware.
+type CORSOptions struct {
+	// AllowOrigin is the value of the Access-Control-Allow-Origin header.
+	AllowOrigin string
+
+	// AllowMethods is the list of methods sent in the
+	// Access-Control-Allow-Methods header of preflight responses. When empty,
+	// the methods are detected from the routes registered on the router.
+	AllowMethods []string
+
+	// AllowHeaders is the list of request headers allowed in cross-origin
+	// requests.
+	AllowHeaders []string
+
+	// ExposeHeaders is the list of response headers exposed to the client.
+	ExposeHeaders []string
+
+	// MaxAge is how long the results of a preflight request may be cached.
+	MaxAge time.Duration
+
+	// AllowCredentials indicates whether the request can include credentials.
+	AllowCredentials bool
+}
+
+// DefaultCORSOptions returns CORSOptions with sensible defaults: any origin,
+// common request headers and a max age of one hour.
+func DefaultCORSOptions() CORSOptions {
+	return CORSOptions{
+		AllowOrigin:      "*",
+		AllowHeaders:     []string{"Accept", "Authorization", "Content-Type", "X-CSRF-Token"},
+		MaxAge:           time.Hour,
+		AllowCredentials: false,
+	}
+}
+
+// CORS returns a middleware that sets the CORS headers on every response and
+// answers preflight OPTIONS requests with a 204 No Content.
+func CORS(options CORSOptions) func(http.Handler) http.Handler {
+	return func(next http.Handler) http.Handler {
+		fn := func(w http.ResponseWriter, r *http.Request) {
+			setCORSHeaders(w, options)
+
+			if r.Method == http.MethodOptions {
+				setCORSPreflightHeaders(w, r, options)
+				w.WriteHeader(http.StatusNoContent)
+				return
+			}
+
+			next.ServeHTTP(w, r)
+		}
+		return http.HandlerFunc(fn)
+	}
+}
+
+// setCORSHeaders sets the CORS headers sent on every response.
+func setCORSHeaders(w http.ResponseWriter, options CORSOptions) {
+	h := w.Header()
+	origin := options.AllowOrigin
+	if origin == "" {
+		origin = "*"
+	}
+	h.Set("Access-Control-Allow-Origin", origin)
+	if origin != "*" {
+		h.Add("Vary", "Origin")
+	}
+	if options.AllowCredentials {
+		h.Set("Access-Control-Allow-Credentials", "true")
+	}
+	if len(options.ExposeHeaders) > 0 {
+		h.Set("Access-Control-Expose-Headers", strings.Join(options.ExposeHeaders, ", "))
+	}
+}
+
+// setCORSPreflightHeaders sets the headers specific to preflight responses.
+func setCORSPreflightHeaders(w http.ResponseWriter, r *http.Request, options CORSOptions) {
+	setCORSHeaders(w, options)
+
+	h := w.Header()
+	methods := options.AllowMethods
+	if len(methods) == 0 {
+		methods = routeMethods(r)
+	}
+	if len(methods) > 0 {
+		h.Set("Access-Control-Allow-Methods", strings.Join(methods, ", "))
+	}
+	if len(options.AllowHeaders) > 0 {
+		h.Set("Access-Control-Allow-Headers", strings.Join(options.AllowHeaders, ", "))
+	}
+	if options.MaxAge > 0 {
+		h.Set("Access-Control-Max-Age", strconv.Itoa(int(options.MaxAge/time.Second)))
+	}
+}
+
+// routeMethods detects the methods available for the requested resource.
+func routeMethods(r *http.Request) []string {
+	rctx := RouteContext(r.Context())
+	if rctx == nil {
+		return nil
+	}
+
+	// Methods recorded by the router on a method-not-allowed match.
+	if len(rctx.methodsAllowed) > 0 {
+		return methodTypNames(rctx.methodsAllowed)
+	}
+
+	if rctx.Routes == nil {
+		return nil
+	}
+	path := r.URL.RawPath
+	if path == "" {
+		path = r.URL.Path
+	}
+	if path == "" {
+		path = "/"
+	}
+	var methods []string
+	for name := range methodMap {
+		if rctx.Routes.Match(NewRouteContext(), name, path) {
+			methods = append(methods, name)
+		}
+	}
+	sort.Strings(methods)
+	return methods
+}
+
+// methodTypNames converts method types to a sorted, de-duplicated list of
+// http method names.
+func methodTypNames(mts []methodTyp) []string {
+	seen := make(map[string]struct{}, len(mts))
+	names := make([]string, 0, len(mts))
+	for _, mt := range mts {
+		name := GetMethodName(mt)
+		if name == "" {
+			continue
+		}
+		if _, ok := seen[name]; ok {
+			continue
+		}
+		seen[name] = struct{}{}
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	return names
+}
