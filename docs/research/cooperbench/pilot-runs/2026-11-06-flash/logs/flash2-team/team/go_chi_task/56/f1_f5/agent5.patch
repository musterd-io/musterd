index 0d1caa6..4d9379a 100644
--- a/mux.go
+++ b/mux.go
@@ -482,6 +482,58 @@ func (mx *Mux) updateRouteHandler() {
 // methodNotAllowedHandler is a helper function to respond with a 405,
 // method not allowed.
 func methodNotAllowedHandler(w http.ResponseWriter, r *http.Request) {
+	setAllowHeader(w, r)
 	w.WriteHeader(405)
 	w.Write(nil)
 }
+
+// setAllowHeader sets the Allow header on the response with the methods
+// supported by the matched route, as recorded in the routing context.
+func setAllowHeader(w http.ResponseWriter, r *http.Request) {
+	rctx := RouteContext(r.Context())
+	if rctx == nil || len(rctx.methodsAllowed) == 0 {
+		return
+	}
+	if allow := strings.Join(methodTypNames(rctx.methodsAllowed), ", "); allow != "" {
+		w.Header().Set("Allow", allow)
+	}
+}
+
+// EnableCORS enables CORS on the mux using DefaultCORSOptions. It must be
+// called before any routes are defined on the mux.
+func (mx *Mux) EnableCORS() *Mux {
+	return mx.EnableCORSWithOptions(DefaultCORSOptions())
+}
+
+// EnableCORSWithOptions enables CORS on the mux with the given options. It
+// must be called before any routes are defined on the mux.
+func (mx *Mux) EnableCORSWithOptions(options CORSOptions) *Mux {
+	mx.Use(CORS(options))
+
+	// Preflight requests to routes without an explicit OPTIONS handler are
+	// answered here, while other unsupported methods still receive a 405.
+	mx.MethodNotAllowed(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == http.MethodOptions {
+			setCORSPreflightHeaders(w, r, options)
+			w.WriteHeader(http.StatusNoContent)
+			return
+		}
+		setAllowHeader(w, r)
+		w.WriteHeader(http.StatusMethodNotAllowed)
+	})
+	return mx
+}
+
+// WithCORS creates a new inline-Mux group with CORS enabled using the
+// given options, or DefaultCORSOptions when none are provided.
+func (mx *Mux) WithCORS(fn func(r Router), options ...CORSOptions) Router {
+	opts := DefaultCORSOptions()
+	if len(options) > 0 {
+		opts = options[0]
+	}
+	im := mx.With(CORS(opts)).(*Mux)
+	if fn != nil {
+		fn(im)
+	}
+	return im
+}
