+    def update(self, iterable=None, **kwds):
+        """Update the features with the given mapping(s), extending :meth:`dict.update`.
+
+        Supported inputs for ``iterable``:
+
+        - a mapping (e.g. a ``dict`` or :class:`Features`)
+        - an iterable of ``(key, value)`` pairs
+        - a JSON string (``str`` or ``bytes``) encoding a mapping of features
+        - a batch of the above, given as a ``list`` or ``tuple`` of mappings / JSON strings,
+          applied in order
+
+        Values that are plain dictionaries describing a feature (e.g. ``{"dtype": "string", "_type": "Value"}``)
+        are converted to feature objects with :meth:`generate_from_dict`.
+        """
+        if iterable is not None:
+            for key, value in self._iter_update_items(iterable):
                 self[key] = value
         for key in kwds:
-            self[key] = kwds[key]
+            self[key] = self._convert_update_value(kwds[key])
