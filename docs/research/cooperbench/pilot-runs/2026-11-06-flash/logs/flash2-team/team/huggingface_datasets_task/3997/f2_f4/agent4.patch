+    @classmethod
+    def _iter_update_items(cls, iterable):
+        if isinstance(iterable, (str, bytes, bytearray)):
+            try:
+                iterable = json.loads(iterable)
+            except ValueError as e:
+                raise ValueError(f"Could not parse JSON string to update the features: {e}") from e
+            if not isinstance(iterable, dict):
+                raise TypeError(f"JSON features must encode a mapping, got {type(iterable).__name__}")
+        if hasattr(iterable, "keys"):
+            for key in iterable.keys():
+                yield key, cls._convert_update_value(iterable[key])
+            return
+        if isinstance(iterable, (list, tuple)) and all(
+            isinstance(item, (str, bytes, bytearray)) or hasattr(item, "keys") for item in iterable
+        ):
+            # batch update
+            for item in iterable:
+                yield from cls._iter_update_items(item)
+            return
+        for key, value in iterable:
+            yield key, cls._convert_update_value(value)
+
+    @staticmethod
+    def _convert_update_value(value):
+        if isinstance(value, dict) and not isinstance(value, Features) and "_type" in value:
+            return generate_from_dict(value)
+        return value
 
