+    def _adjust_palette_lightness(self, factor):
+        """
+        Scales the color channels of this palette image by ``factor``,
+        clamping the results to 0-255. Alpha values are left unchanged.
+        """
+        from . import ImagePalette
+
+        self.load()
+        mode = self.im.getpalettemode()
+        if mode == "RGBA":
+            alphas = self.im.getpalette("RGBA", "A")
+        data = bytes(
+            max(0, min(255, int(round(value * factor))))
+            for value in self.im.getpalette("RGB", "RGB")
+        )
+        self.im.putpalette("RGB", data)
+        if mode == "RGBA":
+            self.im.putpalettealphas(alphas)
+        self.palette = ImagePalette.ImagePalette(mode, self.im.getpalette(mode, mode))
