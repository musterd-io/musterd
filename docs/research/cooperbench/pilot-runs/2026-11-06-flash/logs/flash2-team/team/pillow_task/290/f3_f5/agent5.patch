+
+def test_lightness_factor():
+    image = hopper()
+    reference = image.quantize(16)
+    brighter = image.quantize(16, lightness_factor=1.5)
+    darker = image.quantize(16, lightness_factor=0.5)
+
+    ref_palette = reference.getpalette()[: 16 * 3]
+    brighter_palette = brighter.getpalette()[: 16 * 3]
+    darker_palette = darker.getpalette()[: 16 * 3]
+
+    for ref, bright, dark in zip(ref_palette, brighter_palette, darker_palette):
+        assert bright == min(255, round(ref * 1.5))
+        assert dark == round(ref * 0.5)
+
+    # Image data is unchanged, only the palette is adjusted
+    assert brighter.tobytes() == reference.tobytes()
+
+
+def test_lightness_factor_default():
+    image = hopper()
+    assert_image_equal(image.quantize(16), image.quantize(16, lightness_factor=1.0))
+
+
+def test_lightness_factor_with_palette():
+    image = hopper()
+    with Image.open("Tests/images/caption_6_33_22.png") as palette:
+        palette = palette.convert("P")
+
+    reference = image.quantize(dither=0, palette=palette)
+    brighter = image.quantize(dither=0, palette=palette, lightness_factor=1.2)
+    for ref, bright in zip(reference.getpalette(), brighter.getpalette()):
+        assert bright == min(255, round(ref * 1.2))
+
+
+def test_lightness_factor_rgba_preserves_alpha():
+    image = hopper("RGBA")
+    image.putalpha(128)
+    brighter = image.quantize(16, lightness_factor=1.2)
+    assert brighter.palette.mode == "RGBA"
+    assert brighter.convert("RGBA").getpixel((5, 5))[3] == 128
+
+
+@pytest.mark.parametrize("lightness_factor", (0, -0.5))
+def test_lightness_factor_invalid(lightness_factor):
+    with pytest.raises(ValueError):
+        hopper().quantize(lightness_factor=lightness_factor)
