+    def _sort_palette(self, sort_palette, colors):
+        from . import ImagePalette
+
+        mode = self.im.getpalettemode()
+        channels = len(mode)
+        palette = self.im.getpalette(mode, mode)
+        entries = [
+            tuple(palette[i : i + channels]) for i in range(0, len(palette), channels)
+        ]
+        # Only sort the colors actually produced by the quantizer
+        used = min(colors, len(entries))
+        if sort_palette == "brightness":
+
+            def key(i):
+                r, g, b = entries[i][:3]
+                return (r * 299 + g * 587 + b * 114, entries[i])
+
+        else:
+
+            def key(i):
+                return entries[i]
+
+        order = sorted(range(used), key=key)
+        order += list(range(used, len(entries)))
+
+        # Map each old palette index to its new position
+        lut = [0] * 256
+        for new_index, old_index in enumerate(order):
+            lut[old_index] = new_index
+        new_palette = b"".join(bytes(entries[i]) for i in order)
+
+        im = self.point(lut)
