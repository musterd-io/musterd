+
+def test_sort_palette_default_unchanged():
+    image = hopper()
+    unsorted = image.quantize(16)
+    converted = image.quantize(16, sort_palette=None)
+    assert converted.getpalette() == unsorted.getpalette()
+
+
+@pytest.mark.parametrize("sort_palette", ("brightness", "rgb"))
+def test_sort_palette_preserves_pixels(sort_palette):
+    image = hopper()
+    unsorted = image.quantize(16)
+    converted = image.quantize(16, sort_palette=sort_palette)
+    assert converted.mode == "P"
+    assert_image_equal(converted.convert("RGB"), unsorted.convert("RGB"))
+
+
+def test_sort_palette_brightness():
+    converted = hopper().quantize(16, sort_palette="brightness")
+    palette = converted.getpalette()[: 16 * 3]
+    entries = [palette[i : i + 3] for i in range(0, len(palette), 3)]
+    brightness = [r * 299 + g * 587 + b * 114 for r, g, b in entries]
+    assert brightness == sorted(brightness)
+
+
+def test_sort_palette_rgb():
+    converted = hopper().quantize(16, sort_palette="rgb")
+    palette = converted.getpalette()[: 16 * 3]
+    entries = [tuple(palette[i : i + 3]) for i in range(0, len(palette), 3)]
+    assert entries == sorted(entries)
+
+
+def test_sort_palette_rgba():
+    image = Image.new("RGBA", (10, 10), (255, 0, 0, 128))
+    image.putpixel((0, 0), (0, 0, 0, 255))
+    converted = image.quantize(4, sort_palette="brightness")
+    assert_image_equal(converted.convert("RGBA"), image.quantize(4).convert("RGBA"))
+
+
+def test_sort_palette_invalid():
+    with pytest.raises(ValueError):
+        hopper().quantize(sort_palette="invalid")
