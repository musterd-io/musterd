+    def _sort_palette(self, sort_palette, colors):
+        """Returns a copy of this "P" image with the first ``colors``
+        palette entries reordered according to ``sort_palette``."""
+        from . import ImagePalette
+
+        mode = self.im.getpalettemode()
+        channels = len(mode)
+        palette_bytes = self.im.getpalette(mode, mode)
+        count = min(colors, len(palette_bytes) // channels)
+        entries = [
+            tuple(palette_bytes[i * channels : (i + 1) * channels])
+            for i in range(count)
+        ]
+
+        if sort_palette == "brightness":
+
+            def key(i):
+                r, g, b = entries[i][:3]
+                return (r * 299 + g * 587 + b * 114, entries[i])
+
+        else:
+
+            def key(i):
+                return entries[i]
+
+        order = sorted(range(count), key=key)
+
+        # lut maps old palette index -> new palette index
+        lut = list(range(256))
+        for new_index, old_index in enumerate(order):
+            lut[old_index] = new_index
+
+        new_palette = bytearray(palette_bytes)
+        for new_index, old_index in enumerate(order):
+            new_palette[new_index * channels : (new_index + 1) * channels] = entries[
+                old_index
+            ]
+
+        im = self._new(self.im.point(lut, None))
+        if mode == "RGBA":
+            im.im.putpalette("RGBX", bytes(new_palette))
+            im.im.putpalettealphas(bytes(new_palette[3::4]))
+        else:
+            im.im.putpalette(mode, bytes(new_palette))
+        im.palette = ImagePalette.ImagePalette(mode, im.im.getpalette(mode, mode))
         return im
 
