+/// Transforms a grapheme cluster to the requested case, if any.
+fn apply_case(grapheme: &str, case: Option<Str>) -> StrResult<Str> {
+    let Some(case) = case else { return Ok(grapheme.into()) };
+    match case.as_str() {
+        "upper" => Ok(grapheme.to_uppercase().into()),
+        "lower" => Ok(grapheme.to_lowercase().into()),
+        "title" => {
+            let mut chars = grapheme.chars();
+            let mut out = EcoString::new();
+            if let Some(c) = chars.next() {
+                out.extend(c.to_uppercase());
+            }
+            out.push_str(&chars.as_str().to_lowercase());
+            Ok(out.into())
+        }
+        other => Err(eco_format!("unknown case option \"{other}\"")),
+    }
+}
