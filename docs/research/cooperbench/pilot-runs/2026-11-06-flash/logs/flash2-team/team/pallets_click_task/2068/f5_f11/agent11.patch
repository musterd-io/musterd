+    def _notify(self, event_type: str, process_id: int, editor_command: str) -> None:
+        """Invoke the monitor callback, turning any exception into a
+        warning so monitoring continues for subsequent events.
+        """
+        callback = self.monitor_process
+
+        if callback is None:
+            return
+
+        try:
+            callback(event_type, process_id, editor_command, time.time())
+        except Exception as e:
+            import warnings
+
+            warnings.warn(
+                f"Editor monitor callback raised an exception during"
+                f" {event_type!r} event: {e!r}",
+                UserWarning,
+                stacklevel=2,
+            )
+
+    @staticmethod
+    def _read_process_state(pid: int) -> bytes | None:
+        """Return the single letter process state from ``/proc``, or
+        ``None`` if it is not available on this platform.
+        """
+        try:
+            with open(f"/proc/{pid}/stat", "rb") as f:
+                stat = f.read()
+        except OSError:
+            return None
+
+        # The state follows the command name, which is wrapped in parens
+        # and may itself contain spaces or parens.
+        end = stat.rfind(b")")
+
+        if end == -1:
+            return None
+
+        return stat[end + 2 : end + 3]
+
+    @staticmethod
+    def _child_pids(pid: int) -> list[int]:
+        children: list[int] = []
+
+        try:
+            tasks = os.listdir(f"/proc/{pid}/task")
+        except OSError:
+            return children
+
+        for tid in tasks:
+            try:
+                with open(f"/proc/{pid}/task/{tid}/children") as f:
+                    children.extend(int(c) for c in f.read().split())
+            except (OSError, ValueError):
+                pass
+
+        return children
+
+    def _is_process_stopped(self, pid: int) -> bool | None:
+        """Return whether the process, or the editor it launched through
+        the shell, is stopped (suspended). Returns ``None`` if the state
+        cannot be determined on this platform.
+        """
+        state = self._read_process_state(pid)
+
+        if state is None:
+            return None
+
+        if state in (b"T", b"t"):
+            return True
+
+        pending = self._child_pids(pid)
+        seen: set[int] = set()
+
+        while pending:
+            child = pending.pop()
+
+            if child in seen:
+                continue
+
+            seen.add(child)
+
+            if self._read_process_state(child) in (b"T", b"t"):
+                return True
+
+            pending.extend(self._child_pids(child))
+
+        return False
+
+    def _monitor(
+        self,
+        process: t.Any,
+        editor_command: str,
+        stop_event: t.Any,
+        interval: float = 0.1,
+    ) -> None:
+        """Background loop that watches the editor process for suspend and
+        resume state changes, where supported by the platform.
+        """
+        pid = process.pid
+        suspended = False
+
+        while not stop_event.wait(interval):
+            stopped = self._is_process_stopped(pid)
+
+            if stopped is None:
+                continue
+
+            if stopped and not suspended:
+                suspended = True
+                self._notify("suspend", pid, editor_command)
+            elif not stopped and suspended:
+                suspended = False
+                self._notify("resume", pid, editor_command)
 
