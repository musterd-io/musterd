+    def _wait_monitored(self, process: t.Any, editor_command: str) -> int:
+        """Wait for the editor process while a background thread reports
+        its lifecycle events to the ``monitor_process`` callback.
+        """
+        import threading
+
+        pid = process.pid
+        self._notify("start", pid, editor_command)
+        stop_event = threading.Event()
+        thread = threading.Thread(
+            target=self._monitor,
+            args=(process, editor_command, stop_event),
+            name="click-editor-monitor",
+            daemon=True,
+        )
+        thread.start()
+
+        try:
+            exit_code: int = process.wait()
+        finally:
+            stop_event.set()
+            thread.join()
+            self._notify("terminate", pid, editor_command)
+
+        return exit_code
+
