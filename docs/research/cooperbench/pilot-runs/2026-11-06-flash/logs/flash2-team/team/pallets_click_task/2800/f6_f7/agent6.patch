+            "_depth": self._depth,
+        }
+
+    def restore_state(self, snapshot: dict[str, t.Any]) -> None:
+        """Restore the context to a state previously captured with
+        :meth:`save_state`. The snapshot is copied again while
+        restoring, so it can be reused to restore multiple times.
+
+        :param snapshot: The value returned by :meth:`save_state`.
+
+        .. versionadded:: 8.2
+        """
+        deep = {"params", "obj", "_meta", "default_map", "_parameter_source"}
+
+        for key, value in snapshot.items():
+            if key == "_meta" and isinstance(value, dict):
+                # Update in place so the dict stays shared with child
+                # contexts that reference the same meta.
+                self._meta.clear()
+                self._meta.update(_deepcopy_state(value))
+                continue
+            elif key in deep:
+                value = _deepcopy_state(value)
+            elif isinstance(value, (list, set, dict)):
+                value = type(value)(value)
+
+            setattr(self, key, value)
