+    def save_state(self) -> dict[str, t.Any]:
+        """Capture a snapshot of the current context state. The snapshot
+        can later be passed to :meth:`restore_state` to revert any
+        changes made to the context in the meantime.
+
+        Mutable state such as ``params``, ``obj``, ``meta``,
+        ``default_map`` and the parameter sources is deep copied so that
+        modifications to nested objects do not affect the snapshot.
+
+        .. versionadded:: 8.2
+        """
+        return {
+            "params": _deepcopy_state(self.params),
+            "args": list(self.args),
+            "_protected_args": list(self._protected_args),
+            "_opt_prefixes": set(self._opt_prefixes),
+            "obj": _deepcopy_state(self.obj),
+            "_meta": _deepcopy_state(self._meta),
+            "default_map": _deepcopy_state(self.default_map),
+            "_parameter_source": _deepcopy_state(self._parameter_source),
+            "parent": self.parent,
+            "command": self.command,
+            "info_name": self.info_name,
+            "invoked_subcommand": self.invoked_subcommand,
+            "terminal_width": self.terminal_width,
+            "max_content_width": self.max_content_width,
+            "allow_extra_args": self.allow_extra_args,
+            "allow_interspersed_args": self.allow_interspersed_args,
+            "ignore_unknown_options": self.ignore_unknown_options,
+            "help_option_names": list(self.help_option_names),
+            "token_normalize_func": self.token_normalize_func,
+            "resilient_parsing": self.resilient_parsing,
+            "auto_envvar_prefix": self.auto_envvar_prefix,
