+def _deepcopy_state(value: t.Any) -> t.Any:
+    """Deep copy a value for a context state snapshot. Values that can't
+    be deep copied are kept by reference.
+    """
+    import copy
+
+    try:
+        return copy.deepcopy(value)
+    except Exception:
+        return value
