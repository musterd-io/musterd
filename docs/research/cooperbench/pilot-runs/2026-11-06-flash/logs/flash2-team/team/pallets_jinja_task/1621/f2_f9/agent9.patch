+def _monitor_search_paths(
+    loader_ref: "weakref.ref[FileSystemLoader]",
+    stop: threading.Event,
+    snapshot: t.Dict[str, float],
+) -> None:
+    """Poll the search paths of a :class:`FileSystemLoader` and invalidate
+    cached templates when files change. Only holds a weak reference to the
+    loader so the thread exits once the loader is garbage collected.
+    """
+    while True:
+        loader = loader_ref()
+
+        if loader is None:
+            return
+
+        interval = loader.poll_interval
+        del loader
+
+        if stop.wait(interval):
+            return
+
+        loader = loader_ref()
+
+        if loader is None or not loader.auto_reload:
+            return
+
+        try:
+            current = loader._scan()
+            changed = [
+                path
+                for path in set(snapshot) | set(current)
+                if snapshot.get(path) != current.get(path)
+            ]
+            snapshot = current
+
+            if changed:
+                loader._on_template_changed(changed)
+        except Exception:
+            pass
+
+        del loader
