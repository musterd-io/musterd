+/// Takes `n` grapheme clusters from `s` as an array, using `select` to pick
+/// them from the full list of grapheme clusters.
+fn take_graphemes(
+    s: &str,
+    n: i64,
+    select: impl for<'a> Fn(&'a [&'a str], usize) -> &'a [&'a str],
+) -> StrResult<Value> {
+    if n < 1 {
+        bail!("count must be at least 1");
+    }
+    let graphemes: Vec<&str> = s.graphemes(true).collect();
+    let len = graphemes.len();
+    let n = usize::try_from(n).unwrap_or(usize::MAX);
+    if n > len {
+        bail!("not enough characters (requested {n}, but string only has {len})");
+    }
+    Ok(select(&graphemes, n)
+        .iter()
+        .map(|g| Str::from(*g).into_value())
+        .collect::<Array>()
+        .into_value())
+}
