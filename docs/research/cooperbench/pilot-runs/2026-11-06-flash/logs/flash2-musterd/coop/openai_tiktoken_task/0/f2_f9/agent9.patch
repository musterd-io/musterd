+    def _token_char_positions(self, text: str, tokens: Sequence[int]) -> list[int]:
+        """Returns the starting character index in `text` of each token in `tokens`."""
+        # Map each UTF-8 byte offset to the index of the character containing it, so that tokens
+        # starting in the middle of a multi-byte character map to that character.
+        byte_to_char: list[int] = []
+        for i, ch in enumerate(text):
+            byte_to_char.extend([i] * len(ch.encode("utf-8")))
+        byte_to_char.append(len(text))
+
+        positions = []
+        offset = 0
+        for token in tokens:
+            positions.append(byte_to_char[min(offset, len(byte_to_char) - 1)])
+            offset += len(self.decode_single_token_bytes(token))
+        return positions
 
