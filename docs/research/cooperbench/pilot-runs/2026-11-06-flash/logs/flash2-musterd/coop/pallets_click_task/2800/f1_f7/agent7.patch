+            contexts are still open.
         """
+        if self.validate_nesting and self._child_contexts:
+            names = ", ".join(
+                repr(child.info_name or child.command.name)
+                for child in self._child_contexts
+            )
+            raise RuntimeError(
+                f"Cannot close context {self.info_name!r} while child"
+                f" contexts are still open: {names}."
+            )
+
