+    def update(self, iterable=None, **kwds):
+        """Update the features, keeping ``_column_requires_decoding`` in sync.
+
+        In addition to the usual ``dict.update`` arguments, this accepts:
+            - a JSON string encoding a mapping of column names to features
+              (features given as dicts with a ``_type`` key are deserialized),
+            - a batch of updates: a list/tuple of mappings (or JSON strings)
+              applied in order.
+        """
