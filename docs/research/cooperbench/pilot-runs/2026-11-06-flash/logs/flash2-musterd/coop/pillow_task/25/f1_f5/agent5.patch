diff --git a/Tests/test_image.py b/Tests/test_image.py
index c2e850c36..297d9e1e6 100644
--- a/Tests/test_image.py
+++ b/Tests/test_image.py
@@ -258,6 +258,42 @@ class TestImage:
             assert im.readonly
             im.save(temp_file)
 
+    def test_save_mark_corners(self, tmp_path: Path) -> None:
+        temp_file = tmp_path / "temp.png"
+        im = Image.new("RGB", (10, 10), "blue")
+        im.save(temp_file, mark_corners=True)
+
+        # The original image is not modified
+        assert im.getpixel((0, 0)) == (0, 0, 255)
+        assert im.getpixel((9, 9)) == (0, 0, 255)
+
+        with Image.open(temp_file) as reloaded:
+            assert reloaded.getpixel((0, 0)) == (255, 0, 0)
+            assert reloaded.getpixel((9, 9)) == (255, 0, 0)
+            assert reloaded.getpixel((5, 5)) == (0, 0, 255)
+
+    @pytest.mark.parametrize("mode", ("L", "RGBA", "P"))
+    def test_save_mark_corners_modes(self, mode: str, tmp_path: Path) -> None:
+        temp_file = tmp_path / "temp.png"
+        im = Image.new(mode, (10, 10))
+        im.save(temp_file, mark_corners=True)
+
+        expected = Image.new("RGB", (1, 1), "red").convert(mode).getpixel((0, 0))
+        with Image.open(temp_file) as reloaded:
+            if mode == "P":
+                reloaded = reloaded.convert("RGB")
+                expected = (255, 0, 0)
+            assert reloaded.getpixel((0, 0)) == expected
+            assert reloaded.getpixel((9, 9)) == expected
+
+    def test_save_without_mark_corners(self, tmp_path: Path) -> None:
+        temp_file = tmp_path / "temp.png"
+        im = Image.new("RGB", (10, 10), "blue")
+        im.save(temp_file)
+
+        with Image.open(temp_file) as reloaded:
+            assert reloaded.getpixel((0, 0)) == (0, 0, 255)
+
     def test_dump(self, tmp_path: Path) -> None:
         im = Image.new("L", (10, 10))
         im._dump(str(tmp_path / "temp_L.ppm"))
