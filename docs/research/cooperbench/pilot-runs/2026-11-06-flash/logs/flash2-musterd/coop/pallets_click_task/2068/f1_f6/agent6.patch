+    def _popen_priority_kwargs(self) -> dict[str, t.Any]:
+        """Build extra :class:`subprocess.Popen` arguments that set the
+        priority of the editor process. Unsupported platforms or values
+        result in no extra arguments.
+        """
+        import subprocess
+
+        priority = self.process_priority
+
+        if priority is None:
+            return {}
+
+        if WIN:
+            flag = getattr(subprocess, _PROCESS_PRIORITY_WIN[priority], None)
+
+            if flag is None:
+                return {}
+
+            return {"creationflags": flag}
+
+        increment = _PROCESS_PRIORITY_NICE[priority]
+
+        if increment == 0 or not hasattr(os, "nice"):
+            return {}
+
+        def set_priority() -> None:
+            try:
+                os.nice(increment)
+            except OSError:
+                # Raising priority usually requires privileges. Ignore
+                # failures so the editor still launches.
+                pass
+
+        return {"preexec_fn": set_priority}
 
