@@ -68,3 +75,13 @@ email = Regex(
 isbn = Regex(
     r"(?:ISBN(?:-1[03])?:? )?(?=[0-9X]{10}$|(?=(?:[0-9]+[- ]){3})[- 0-9X]{13}$|97[89][0-9]{10}$|(?=(?:[0-9]+[- ]){4})[- 0-9]{17}$)(?:97[89][- ]?)?[0-9]{1,5}[- ]?[0-9]+[- ]?[0-9]+[- ]?[0-9X]"
 )
+
+# Matches 16-digit credit card numbers, either without separators or with
+# groups of 4 digits separated consistently by spaces or by hyphens, e.g.
+# "1234567890123456", "1234 5678 9012 3456" or "1234-5678-9012-3456".
+#
+# Note that this does not validate the card number with the Luhn algorithm
+# nor check the issuer prefix.
+credit_card = Regex(
+    r"(\d{16}|\d{4}-\d{4}-\d{4}-\d{4}|\d{4} \d{4} \d{4} \d{4})"
+)
