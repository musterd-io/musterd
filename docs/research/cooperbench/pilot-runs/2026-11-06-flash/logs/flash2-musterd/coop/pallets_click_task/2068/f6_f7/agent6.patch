+    def _get_priority_kwargs(self) -> dict[str, t.Any]:
+        """Return extra :class:`subprocess.Popen` keyword arguments that
+        set the editor process priority. Unknown or unsupported priority
+        values result in no extra arguments.
+        """
+        import subprocess
+
+        priority = self.process_priority
+
+        if priority is None:
+            return {}
+
+        if WIN:
+            classes = {
+                "low": "IDLE_PRIORITY_CLASS",
+                "below_normal": "BELOW_NORMAL_PRIORITY_CLASS",
+                "normal": "NORMAL_PRIORITY_CLASS",
+                "above_normal": "ABOVE_NORMAL_PRIORITY_CLASS",
+                "high": "HIGH_PRIORITY_CLASS",
+            }
+            name = classes.get(priority)
+            flag = getattr(subprocess, name, None) if name else None
+
+            if flag is None:
+                return {}
+
+            return {"creationflags": flag}
+
+        nice_values = {
+            "low": 10,
+            "below_normal": 5,
+            "normal": 0,
+            "above_normal": -5,
+            "high": -10,
+        }
+        increment = nice_values.get(priority)
+
+        if increment is None or not hasattr(os, "nice"):
+            return {}
+
+        def set_priority() -> None:
+            try:
+                os.nice(increment)
+            except OSError:
+                # Raising priority usually requires privileges; ignore
+                # failures so the editor still launches.
+                pass
+
+        return {"preexec_fn": set_priority}
+
