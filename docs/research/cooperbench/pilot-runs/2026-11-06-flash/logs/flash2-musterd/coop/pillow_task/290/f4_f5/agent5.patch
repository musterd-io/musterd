     assert converted_px[0, 0] == converted_px[0, 1]
+
+
+def test_quantize_error_threshold():
+    image = hopper()
+    full = image.quantize(colors=256)
+    assert len(full.getcolors()) == len(image.quantize().getcolors())
+
+    # A very loose threshold uses fewer colors
+    loose = image.quantize(colors=256, error_threshold=5000)
+    assert len(loose.getcolors()) < len(full.getcolors())
+
+    # A strict threshold that can't be met falls back to the maximum colors
+    strict = image.quantize(colors=16, error_threshold=0)
+    assert len(strict.getcolors()) == len(image.quantize(colors=16).getcolors())
+
+    # Fewer colors for a simple image
+    simple = Image.new("RGB", (10, 10), (255, 0, 0))
+    simple.paste((0, 0, 255), (0, 0, 5, 10))
+    converted = simple.quantize(colors=256, error_threshold=1)
+    assert len(converted.getcolors()) <= 2
+
+
+def test_quantize_error_threshold_invalid():
+    with pytest.raises(ValueError):
+        hopper().quantize(error_threshold=-1)
+
+
+def test_quantize_lightness_factor():
+    image = hopper()
+    base = image.quantize(colors=64)
+    base_palette = base.getpalette()
+
+    brighter = image.quantize(colors=64, lightness_factor=1.2)
+    assert brighter.tobytes() == base.tobytes()
+    for b, v in zip(base_palette, brighter.getpalette()):
+        assert v == min(255, round(b * 1.2))
+
+    darker = image.quantize(colors=64, lightness_factor=0.5)
+    for b, v in zip(base_palette, darker.getpalette()):
+        assert v == round(b * 0.5)
+
+    # No upper bound, values clamped
+    huge = image.quantize(colors=64, lightness_factor=1000)
+    assert all(v in (0, 255) for v in huge.getpalette())
+
+    unchanged = image.quantize(colors=64, lightness_factor=1.0)
+    assert unchanged.getpalette() == base_palette
+
+
+def test_quantize_lightness_factor_rgba():
+    image = hopper("RGBA")
+    base = image.quantize(colors=64)
+    brighter = image.quantize(colors=64, lightness_factor=1.5)
+    assert brighter.palette.mode == base.palette.mode
+    assert brighter.getpalette() != base.getpalette()
+
+
+def test_quantize_lightness_factor_palette():
+    image = hopper()
+    with Image.open("Tests/images/caption_6_33_22.png") as palette:
+        palette = palette.convert("P")
+    base = image.quantize(palette=palette)
+    brighter = image.quantize(palette=palette, lightness_factor=1.1)
+    for b, v in zip(base.getpalette(), brighter.getpalette()):
+        assert v == min(255, round(b * 1.1))
+
+
+@pytest.mark.parametrize("factor", [0, -1, -0.5])
+def test_quantize_lightness_factor_invalid(factor):
+    with pytest.raises(ValueError):
+        hopper().quantize(lightness_factor=factor)
