+def _validate_codec(codec: Optional[str]) -> Optional[str]:
+    if codec not in _CODEC_BY_NAME:
+        raise ValueError(f"Unsupported compression codec: {codec!r}. Expected one of 'gzip', 'zlib', or None.")
+    return codec
+
