+@pytest.mark.parametrize("sort_palette", ("brightness", "rgb"))
+def test_quantize_sort_palette(sort_palette):
+    image = hopper()
+    unsorted = image.quantize(colors=16)
+    converted = image.quantize(colors=16, sort_palette=sort_palette)
+    assert_image(converted, "P", converted.size)
+
+    palette = converted.getpalette()[: 16 * 3]
+    entries = [tuple(palette[i : i + 3]) for i in range(0, len(palette), 3)]
+    if sort_palette == "brightness":
+        keys = [r * 299 + g * 587 + b * 114 for r, g, b in entries]
+    else:
+        keys = entries
+    assert keys == sorted(keys)
+
+    # The visual result is unchanged
+    assert_image_equal(converted.convert("RGB"), unsorted.convert("RGB"))
+
+
+def test_quantize_sort_palette_rgba():
+    image = hopper("RGBA")
+    image.putalpha(image.getchannel("R"))
+    unsorted = image.quantize(colors=8)
+    converted = image.quantize(colors=8, sort_palette="rgb")
+    assert_image_equal(converted.convert("RGBA"), unsorted.convert("RGBA"))
+
+
+def test_quantize_sort_palette_invalid():
+    with pytest.raises(ValueError):
+        hopper().quantize(sort_palette="unknown")
+
+
+def test_quantize_lightness_factor():
+    image = hopper()
+    base = image.quantize(16)
+    brighter = image.quantize(16, lightness_factor=1.1)
+    darker = image.quantize(16, lightness_factor=0.9)
+
+    assert brighter.tobytes() == base.tobytes()
+    base_palette = base.getpalette()[: 16 * 3]
+    for v, b, d in zip(
+        base_palette, brighter.getpalette()[: 16 * 3], darker.getpalette()[: 16 * 3]
+    ):
+        assert b == min(255, round(v * 1.1))
+        assert d == round(v * 0.9)
+    assert brighter.palette.palette[: 16 * 3] == bytes(brighter.getpalette()[: 48])
+
+
+def test_quantize_lightness_factor_clamps():
+    image = Image.new("RGB", (1, 1), (200, 100, 50))
+    converted = image.quantize(lightness_factor=2)
+    assert converted.convert("RGB").getpixel((0, 0)) == (255, 200, 100)
+
+
+def test_quantize_lightness_factor_palette():
+    image = hopper()
+    palette = hopper("P")
+    converted = image.quantize(palette=palette, lightness_factor=0.5)
+    assert converted.getpalette()[:3] == [
+        round(c * 0.5) for c in palette.getpalette()[:3]
+    ]
+
+
+@pytest.mark.parametrize("factor", (0, -1))
+def test_quantize_lightness_factor_invalid(factor):
+    with pytest.raises(ValueError):
+        hopper().quantize(lightness_factor=factor)
