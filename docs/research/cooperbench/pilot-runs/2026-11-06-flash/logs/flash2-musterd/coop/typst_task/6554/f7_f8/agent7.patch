+/// A built-in character class for `str.first` and `str.last`.
+#[derive(Debug, Copy, Clone, Eq, PartialEq)]
+enum CharPattern {
+    Alpha,
+    Numeric,
+    Alphanumeric,
+    Uppercase,
+    Lowercase,
+    Whitespace,
+}
+
+impl CharPattern {
+    /// Parses a pattern name.
+    fn parse(name: &str) -> StrResult<Self> {
+        Ok(match name {
+            "alpha" => Self::Alpha,
+            "numeric" => Self::Numeric,
+            "alphanumeric" => Self::Alphanumeric,
+            "uppercase" => Self::Uppercase,
+            "lowercase" => Self::Lowercase,
+            "whitespace" => Self::Whitespace,
+            _ => bail!(
+                "unknown pattern {}, expected one of \"alpha\", \"numeric\", \
+                 \"alphanumeric\", \"uppercase\", \"lowercase\", or \"whitespace\"",
+                name.repr()
+            ),
+        })
+    }
+
+    /// The name of the pattern.
+    fn name(self) -> &'static str {
+        match self {
+            Self::Alpha => "alpha",
+            Self::Numeric => "numeric",
+            Self::Alphanumeric => "alphanumeric",
+            Self::Uppercase => "uppercase",
+            Self::Lowercase => "lowercase",
+            Self::Whitespace => "whitespace",
+        }
+    }
+
+    /// Whether the leading character of the grapheme belongs to this class.
+    fn matches(self, grapheme: &str) -> bool {
+        let Some(c) = grapheme.chars().next() else { return false };
+        match self {
+            Self::Alpha => c.is_alphabetic(),
+            Self::Numeric => c.is_numeric(),
+            Self::Alphanumeric => c.is_alphanumeric(),
+            Self::Uppercase => c.is_uppercase(),
+            Self::Lowercase => c.is_lowercase(),
+            Self::Whitespace => c.is_whitespace(),
+        }
+    }
+
+    /// The error message when no grapheme matches.
+    fn no_match(self) -> EcoString {
+        eco_format!("no character matches pattern \"{}\"", self.name())
+    }
+}
+
+/// A case transformation for `str.first` and `str.last`.
+#[derive(Debug, Copy, Clone, Eq, PartialEq)]
+enum Case {
+    Upper,
+    Lower,
+    Title,
+}
+
+impl Case {
+    /// Parses a case name.
+    fn parse(name: &str) -> StrResult<Self> {
+        Ok(match name {
+            "upper" => Self::Upper,
+            "lower" => Self::Lower,
+            "title" => Self::Title,
+            _ => bail!("unknown case option \"{name}\""),
+        })
+    }
+
+    /// Applies the optional case transformation to a grapheme cluster.
+    fn apply(case: Option<Self>, grapheme: &str) -> Str {
+        match case {
+            None => grapheme.into(),
+            Some(Self::Upper) => grapheme.to_uppercase().into(),
+            Some(Self::Lower) => grapheme.to_lowercase().into(),
+            Some(Self::Title) => {
+                let mut chars = grapheme.chars();
+                let mut out = String::new();
+                if let Some(first) = chars.next() {
+                    out.extend(first.to_uppercase());
+                }
+                out.push_str(&chars.as_str().to_lowercase());
+                out.into()
+            }
+        }
+    }
+}
+
