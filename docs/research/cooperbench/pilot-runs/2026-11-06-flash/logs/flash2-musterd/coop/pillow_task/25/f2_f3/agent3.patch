+    def test_dry_run_save(self, tmp_path: Path) -> None:
+        temp_file = tmp_path / "temp.png"
+        with hopper() as im:
+            im.save(temp_file, dry_run=True)
+        assert not temp_file.exists()
+
+        buf = io.BytesIO()
+        with hopper() as im:
+            im.save(buf, "PNG", dry_run=True)
+        assert buf.getvalue() == b""
+
+    def test_dry_run_save_error(self, tmp_path: Path) -> None:
+        temp_file = tmp_path / "temp.jpg"
+        im = Image.new("RGBA", (10, 10))
+        with pytest.raises(OSError):
+            im.save(temp_file, dry_run=True)
+        assert not temp_file.exists()
+
     def test_internals(self) -> None:
         im = Image.new("L", (100, 100))
         im.readonly = 1
