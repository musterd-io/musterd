diff --git a/Tests/test_image_quantize.py b/Tests/test_image_quantize.py
index bd9db362c..734511451 100644
--- a/Tests/test_image_quantize.py
+++ b/Tests/test_image_quantize.py
@@ -85,3 +85,67 @@ def test_transparent_colors_equal():
     converted = im.quantize()
     converted_px = converted.load()
     assert converted_px[0, 0] == converted_px[0, 1]
+
+
+def test_max_colors():
+    image = hopper()
+
+    converted = image.quantize(colors=100, max_colors=50)
+    assert converted.mode == "P"
+    assert len(converted.getcolors()) <= 50
+
+    # max_colors greater than colors does not increase the color count
+    converted = image.quantize(colors=20, max_colors=100)
+    assert len(converted.getcolors()) <= 20
+
+    # Default behaviour is unchanged
+    expected = image.quantize(colors=64)
+    assert image.quantize(64, max_colors=64).tobytes() == expected.tobytes()
+
+
+def test_max_colors_invalid():
+    image = hopper()
+    with pytest.raises(ValueError):
+        image.quantize(max_colors=0)
+    with pytest.raises(ValueError):
+        image.quantize(max_colors=257)
+
+
+@pytest.mark.parametrize("sort_palette", ("brightness", "rgb"))
+def test_sort_palette(sort_palette):
+    image = hopper()
+    unsorted = image.quantize(64)
+    converted = image.quantize(64, sort_palette=sort_palette)
+    assert converted.mode == "P"
+
+    # The image content is unchanged, only the palette order differs
+    assert converted.convert("RGB").tobytes() == unsorted.convert("RGB").tobytes()
+
+    palette = converted.getpalette()[: 64 * 3]
+    entries = [tuple(palette[i : i + 3]) for i in range(0, len(palette), 3)]
+    if sort_palette == "brightness":
+        keys = [r * 299 + g * 587 + b * 114 for r, g, b in entries]
+    else:
+        keys = entries
+    assert keys == sorted(keys)
+
+
+def test_sort_palette_rgba():
+    image = hopper("RGBA")
+    unsorted = image.quantize(16)
+    converted = image.quantize(16, sort_palette="brightness")
+    assert converted.convert("RGBA").tobytes() == unsorted.convert("RGBA").tobytes()
+
+
+def test_sort_palette_default():
+    image = hopper()
+    assert (
+        image.quantize(64, sort_palette=None).tobytes()
+        == image.quantize(64).tobytes()
+    )
+
+
+def test_sort_palette_invalid():
+    image = hopper()
+    with pytest.raises(ValueError):
+        image.quantize(sort_palette="unknown")
