+    def _record_option_history(
+        self, name: str, value: t.Any, source: ParameterSource | None
+    ) -> None:
+        """Record a value change for a parameter if tracking is enabled."""
+        if not self._track_changes:
+            return
+
+        import time
+
+        history = self._option_history.setdefault(name, [])
+        entry: dict[str, t.Any] = {
+            "value": value,
+            "source": source,
+            "timestamp": time.time(),
+        }
+
+        if history:
+            entry["previous_value"] = history[-1]["value"]
+
+        history.append(entry)
+
+    def get_option_history(self, name: str) -> list[dict[str, t.Any]] | None:
+        """Get the history of values set for an option.
+
+        :param name: The parameter name (``"count"``) or one of the
+            option's flags (``"--count"``, ``"-c"``).
+        :return: A list of history entries, each a dict with ``value``,
+            ``source`` and ``timestamp`` keys. ``None`` if tracking is
+            disabled, or an empty list if there is no history.
+        """
+        if not self._track_changes:
+            return None
+
+        param_name = name
+
+        if name not in self._option_history:
+            for param in self.command.params:
+                if name == param.name or name in param.opts or name in getattr(
+                    param, "secondary_opts", ()
+                ):
+                    param_name = param.name  # type: ignore[assignment]
+                    break
+
+        return list(self._option_history.get(param_name, []))
+
 
