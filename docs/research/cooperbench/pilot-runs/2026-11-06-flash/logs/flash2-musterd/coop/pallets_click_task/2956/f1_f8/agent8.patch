+    def shell_complete(self, ctx: Context, incomplete: str) -> list[CompletionItem]:
+        """Return a list of completions for the incomplete value. A
+        custom ``shell_complete`` function takes precedence, then smart
+        completion if ``auto_complete`` is enabled, then the type's
+        completion.
+        """
+        if self._custom_shell_complete is None and self.auto_complete:
+            return self._smart_complete(ctx, incomplete)
+
+        return super().shell_complete(ctx, incomplete)
+
+    def _smart_complete(self, ctx: Context, incomplete: str) -> list[CompletionItem]:
+        """Pick a completion strategy based on the option's name, type,
+        and the current environment, falling back to the type's
+        completion for unknown patterns.
+        """
+        from click.shell_completion import CompletionItem
+
+        strategy = _detect_completion_strategy(self)
+
+        if strategy is None:
+            return self.type.shell_complete(ctx, self, incomplete)
+
+        if strategy in ("file", "dir"):
+            return [CompletionItem(incomplete, type=strategy)]
+
+        values = _AUTO_COMPLETE_REGISTRY[strategy]()
+        return [CompletionItem(v) for v in values if v.startswith(incomplete)]
