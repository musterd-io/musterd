+def _complete_usernames() -> list[str]:
+    try:
+        import pwd
+    except ImportError:
+        pwd = None  # type: ignore[assignment]
+
+    if pwd is not None:
+        try:
+            return sorted({p.pw_name for p in pwd.getpwall()})
+        except Exception:
+            pass
+
+    import getpass
+
+    try:
+        return [getpass.getuser()]
+    except Exception:
+        return []
+
+
+def _complete_git_branches() -> list[str]:
+    import subprocess
+
+    try:
+        result = subprocess.run(
+            ["git", "branch", "-a", "--format=%(refname:short)"],
+            capture_output=True,
+            text=True,
+            timeout=5,
+        )
+    except (OSError, subprocess.SubprocessError):
+        return []
+
+    if result.returncode != 0:
+        return []
+
+    return [line.strip() for line in result.stdout.splitlines() if line.strip()]
+
+
+def _complete_env_vars() -> list[str]:
+    return sorted(os.environ)
+
+
+_AUTO_COMPLETE_REGISTRY: dict[str, t.Callable[[], list[str]]] = {
+    "user": _complete_usernames,
+    "branch": _complete_git_branches,
+    "env": _complete_env_vars,
+}
+
+_AUTO_COMPLETE_PATTERNS: list[tuple[str, frozenset[str]]] = [
+    ("user", frozenset({"user", "username", "users", "owner", "login"})),
+    ("branch", frozenset({"branch", "branches", "ref", "git_branch"})),
+    ("env", frozenset({"env", "envvar", "env_var", "environment", "variable"})),
+    ("dir", frozenset({"dir", "directory", "folder", "dirs", "directories"})),
+    (
+        "file",
+        frozenset({"file", "files", "path", "paths", "filename", "filepath"}),
+    ),
+]
+
+
+def _detect_completion_strategy(param: Parameter) -> str | None:
+    if isinstance(param.type, types.Path):
+        if param.type.dir_okay and not param.type.file_okay:
+            return "dir"
+        return "file"
+
+    if isinstance(param.type, types.File):
+        return "file"
+
+    # Only infer from the name for free-form string values.
+    if not isinstance(param.type, types.StringParamType):
+        return None
+
+    names = [param.name or ""]
+    names.extend(o.lstrip("-/").replace("-", "_") for o in param.opts)
+
+    for name in names:
+        name = name.lower()
+        parts = set(name.split("_"))
+
+        for strategy, keywords in _AUTO_COMPLETE_PATTERNS:
+            if name in keywords or parts & keywords:
+                return strategy
+
+    return None
+
