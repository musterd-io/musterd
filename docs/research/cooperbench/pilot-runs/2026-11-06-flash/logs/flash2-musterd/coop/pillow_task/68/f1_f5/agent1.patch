         assert im.size == (2, 1)
@@ -470,6 +485,37 @@ def test_exif_transpose_in_place() -> None:
         assert_image_equal(im, expected)
 
 
+def test_exif_transpose_logger_callable() -> None:
+    messages: list[str] = []
+    with Image.open("Tests/images/orientation_rectangle.jpg") as im:
+        ImageOps.exif_transpose(im, logger=messages.append)
+    assert any("orientation: 8" in m for m in messages)
+    assert any("ROTATE_90" in m for m in messages)
+    assert any("removed EXIF orientation tag" in m for m in messages)
+    assert any("completed in" in m for m in messages)
+
+    messages.clear()
+    ImageOps.exif_transpose(hopper(), logger=messages.append)
+    assert any("no transposition needed" in m for m in messages)
+
+
+def test_exif_transpose_logger_logging(caplog: pytest.LogCaptureFixture) -> None:
+    logger = logging.getLogger("test_exif_transpose")
+    with caplog.at_level(logging.INFO, logger="test_exif_transpose"):
+        with Image.open("Tests/images/orientation_rectangle.jpg") as im:
+            ImageOps.exif_transpose(im, in_place=True, logger=logger)
+    records = [r for r in caplog.records if r.name == "test_exif_transpose"]
+    assert any("ROTATE_90" in r.getMessage() for r in records)
+
+
+def test_exif_transpose_logger_invalid_orientation() -> None:
+    messages: list[str] = []
+    im = hopper()
+    im.getexif()[0x0112] = 9
+    ImageOps.exif_transpose(im, logger=messages.append)
+    assert any("invalid EXIF orientation" in m for m in messages)
+
+
 def test_autocontrast_unsupported_mode() -> None:
