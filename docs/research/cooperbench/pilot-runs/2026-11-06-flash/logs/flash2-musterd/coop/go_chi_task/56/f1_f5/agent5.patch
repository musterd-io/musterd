index 0000000..04b2aab
--- /dev/null
+++ b/cors.go
@@ -0,0 +1,202 @@
+package chi
+
+import (
+	"net/http"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// CORSOptions represents configuration for the built-in CORS support.
+type CORSOptions struct {
+	// AllowOrigin is the value of the Access-Control-Allow-Origin header,
+	// ie. "*" or "https://example.com".
+	AllowOrigin string
+
+	// AllowMethods is the list of methods sent in Access-Control-Allow-Methods
+	// on preflight requests. When empty, the methods are detected from the
+	// routes registered for the requested resource.
+	AllowMethods []string
+
+	// AllowHeaders is the list of headers sent in Access-Control-Allow-Headers
+	// on preflight requests.
+	AllowHeaders []string
+
+	// ExposeHeaders is the list of headers sent in Access-Control-Expose-Headers.
+	ExposeHeaders []string
+
+	// MaxAge is the number of seconds a preflight response may be cached,
+	// sent in Access-Control-Max-Age. Zero omits the header.
+	MaxAge int
+
+	// AllowCredentials sets Access-Control-Allow-Credentials to "true".
+	AllowCredentials bool
+}
+
+// DefaultCORSOptions returns CORSOptions with sensible defaults: any origin,
+// common request headers and a one hour preflight cache.
+func DefaultCORSOptions() CORSOptions {
+	return CORSOptions{
+		AllowOrigin:  "*",
+		AllowHeaders: []string{"Accept", "Authorization", "Content-Type", "X-CSRF-Token"},
+		MaxAge:       3600,
+	}
+}
+
+// methodNames maps method types to their HTTP method names. It shares the
+// routing tree's reverseMethodMap, so custom methods are included.
+var methodNames = reverseMethodMap
+
+// GetMethodName returns the HTTP method name for the given method type, or
+// an empty string if it is unknown.
+func GetMethodName(m methodTyp) string {
+	return methodNames[m]
+}
+
+// defaultCORSMethods is used on preflight requests when no AllowMethods were
+// configured and no methods could be detected from the routing tree.
+var defaultCORSMethods = []string{
+	http.MethodGet, http.MethodPost, http.MethodPut,
+	http.MethodPatch, http.MethodDelete, http.MethodOptions,
+}
+
+// CORS returns a middleware that sets CORS headers on every response and
+// answers preflight OPTIONS requests with a 204 status.
+func CORS(options ...CORSOptions) func(http.Handler) http.Handler {
+	opts := DefaultCORSOptions()
+	if len(options) > 0 {
+		opts = options[0]
+	}
+	return func(next http.Handler) http.Handler {
+		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			setCORSHeaders(w, opts)
+			if isPreflight(r) {
+				writePreflight(w, r, opts)
+				return
+			}
+			next.ServeHTTP(w, r)
+		})
+	}
+}
+
+// EnableCORS enables CORS on the Mux using DefaultCORSOptions.
+func (mx *Mux) EnableCORS() {
+	mx.EnableCORSWithOptions(DefaultCORSOptions())
+}
+
+// EnableCORSWithOptions enables CORS on the Mux with the given options. It
+// registers the CORS middleware and a method-not-allowed handler that answers
+// preflight requests for routes without an OPTIONS handler.
+func (mx *Mux) EnableCORSWithOptions(options CORSOptions) {
+	mx.Use(CORS(options))
+
+	prev := mx.methodNotAllowedHandler
+	mx.MethodNotAllowed(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == http.MethodOptions {
+			setCORSHeaders(w, options)
+			writePreflight(w, r, options)
+			return
+		}
+		if prev != nil {
+			prev.ServeHTTP(w, r)
+			return
+		}
+		var allowed []methodTyp
+		if rctx := RouteContext(r.Context()); rctx != nil {
+			allowed = rctx.methodsAllowed
+		}
+		methodNotAllowedHandler(allowed...)(w, r)
+	})
+}
+
+// WithCORS creates a grouped router with CORS enabled using the given options,
+// or DefaultCORSOptions when none are passed.
+func (mx *Mux) WithCORS(fn func(r Router), options ...CORSOptions) Router {
+	opts := DefaultCORSOptions()
+	if len(options) > 0 {
+		opts = options[0]
+	}
+	im := mx.With(CORS(opts))
+	if fn != nil {
+		fn(im)
+	}
+	return im
+}
+
+func isPreflight(r *http.Request) bool {
+	return r.Method == http.MethodOptions
+}
+
+func setCORSHeaders(w http.ResponseWriter, opts CORSOptions) {
+	h := w.Header()
+	origin := opts.AllowOrigin
+	if origin == "" {
+		origin = "*"
+	}
+	h.Set("Access-Control-Allow-Origin", origin)
+	if origin != "*" {
+		h.Add("Vary", "Origin")
+	}
+	if opts.AllowCredentials {
+		h.Set("Access-Control-Allow-Credentials", "true")
+	}
+	if len(opts.ExposeHeaders) > 0 {
+		h.Set("Access-Control-Expose-Headers", strings.Join(opts.ExposeHeaders, ", "))
+	}
+}
+
+func writePreflight(w http.ResponseWriter, r *http.Request, opts CORSOptions) {
+	h := w.Header()
+	methods := opts.AllowMethods
+	if len(methods) == 0 {
+		methods = detectMethods(r)
+	}
+	if len(methods) == 0 {
+		methods = defaultCORSMethods
+	}
+	h.Set("Access-Control-Allow-Methods", strings.Join(methods, ", "))
+	if len(opts.AllowHeaders) > 0 {
+		h.Set("Access-Control-Allow-Headers", strings.Join(opts.AllowHeaders, ", "))
+	} else if reqHeaders := r.Header.Get("Access-Control-Request-Headers"); reqHeaders != "" {
+		h.Set("Access-Control-Allow-Headers", reqHeaders)
+	}
+	if opts.MaxAge > 0 {
+		h.Set("Access-Control-Max-Age", strconv.Itoa(opts.MaxAge))
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+// detectMethods returns the methods routable for the request path on the
+// router found in the request's routing context.
+func detectMethods(r *http.Request) []string {
+	rctx := RouteContext(r.Context())
+	if rctx == nil || rctx.Routes == nil {
+		return nil
+	}
+	path := rctx.RoutePath
+	if path == "" {
+		if r.URL.RawPath != "" {
+			path = r.URL.RawPath
+		} else {
+			path = r.URL.Path
+		}
+		if path == "" {
+			path = "/"
+		}
+	}
+
+	var methods []string
+	for method, mt := range methodMap {
+		if mt == mOPTIONS {
+			continue
+		}
+		if rctx.Routes.Match(NewRouteContext(), method, path) {
+			methods = append(methods, GetMethodName(mt))
+		}
+	}
+	if len(methods) == 0 {
+		return nil
+	}
+	sort.Strings(methods)
+	return append(methods, http.MethodOptions)
+}
diff --git a/middleware/allowed_methods.go b/middleware/allowed_methods.go
new file mode 100644
index 0000000..2db97d2
--- /dev/null
+++ b/middleware/allowed_methods.go
@@ -0,0 +1,50 @@
+package middleware
+
+import (
+	"net/http"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// SetAllowHeader adds the Allow header for 405 responses based on
+// registered methods for the requested path.
+//
+// This middleware is a no-op for requests whose method matches a route.
+func SetAllowHeader(next http.Handler) http.Handler {
+	fn := func(w http.ResponseWriter, r *http.Request) {
+		rctx := chi.RouteContext(r.Context())
+		if rctx == nil || rctx.Routes == nil {
+			next.ServeHTTP(w, r)
+			return
+		}
+
+		url := r.URL.RawPath
+		if url == "" {
+			url = r.URL.Path
+		}
+
+		if rctx.Routes.Match(chi.NewRouteContext(), r.Method, url) {
+			next.ServeHTTP(w, r)
+			return
+		}
+
+		for _, m := range []string{
+			http.MethodConnect,
+			http.MethodDelete,
+			http.MethodGet,
+			http.MethodHead,
+			http.MethodOptions,
+			http.MethodPatch,
+			http.MethodPost,
+			http.MethodPut,
+			http.MethodTrace,
+		} {
+			if rctx.Routes.Match(chi.NewRouteContext(), m, url) {
+				w.Header().Add("Allow", m)
+			}
+		}
+
+		next.ServeHTTP(w, r)
+	}
+	return http.HandlerFunc(fn)
+}
