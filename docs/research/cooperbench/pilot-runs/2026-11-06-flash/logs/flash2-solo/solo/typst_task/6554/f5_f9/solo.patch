+/// Checks that a requested character count is valid for the given string and
+/// returns the total number of grapheme clusters.
+fn check_count(s: &str, n: usize) -> StrResult<usize> {
+    if n == 0 {
+        bail!("count must be at least 1");
+    }
+    let total = s.graphemes(true).count();
+    if total == 0 {
+        return Err(string_is_empty());
+    }
+    if n > total {
+        bail!("not enough characters (requested {n}, but string only has {total})");
+    }
+    Ok(total)
+}
