+    def _quantize_mse(self, quantized):
+        # Mean square error between this image and a quantized version of it
+        from . import ImageChops
+
+        diff = ImageChops.difference(self, quantized.convert(self.mode))
+        hist = diff.histogram()
+        total = 0
+        for i, count in enumerate(hist):
+            total += count * (i % 256) ** 2
+        n = self.size[0] * self.size[1] * len(diff.getbands())
+        return total / n if n else 0.0
+
+    def _quantize_with_error_threshold(self, colors, method, kmeans, threshold):
+        # Binary search for the fewest colors meeting the error threshold
+        def attempt(n):
+            im = self._new(self.im.quantize(n, method, kmeans))
+            mode = im.im.getpalettemode()
+            from . import ImagePalette
+
+            im.palette = ImagePalette.ImagePalette(
+                mode, im.im.getpalette(mode, mode)
+            )
+            return im
+
+        best = attempt(colors)
+        if self._quantize_mse(best) > threshold:
+            return best
+        low, high = 1, colors - 1
+        while low <= high:
+            mid = (low + high) // 2
+            candidate = attempt(mid)
+            if self._quantize_mse(candidate) <= threshold:
+                best = candidate
+                high = mid - 1
+            else:
+                low = mid + 1
+        return best
+
+    def _adjust_palette_lightness(self, factor):
+        from . import ImagePalette
+
+        mode = self.im.getpalettemode()
+        data = self.im.getpalette(mode, mode)
+        bands = len(mode)
+        adjusted = bytearray(data)
+        for i in range(len(adjusted)):
+            if mode[i % bands] == "A":
+                continue
+            adjusted[i] = min(255, max(0, int(round(adjusted[i] * factor))))
+        adjusted = bytes(adjusted)
+        if mode == "RGBA":
+            self.im.putpalette("RGB", bytes(v for i, v in enumerate(adjusted) if i % 4 != 3))
+            self.im.putpalettealphas(adjusted[3::4])
+        else:
+            self.im.putpalette(mode, adjusted)
+        self.palette = ImagePalette.ImagePalette(mode, adjusted)
+
