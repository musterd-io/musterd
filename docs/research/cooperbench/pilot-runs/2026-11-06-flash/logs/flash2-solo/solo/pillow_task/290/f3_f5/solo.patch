+    def _adjust_quantized_palette(self, colors, sort_palette, lightness_factor):
+        if sort_palette is None and lightness_factor == 1.0:
+            return self
+
+        from . import ImagePalette
+
+        mode = self.im.getpalettemode()
+        channels = len(mode)
+        data = list(self.im.getpalette(mode, mode))
+        entries = [
+            tuple(data[i : i + channels]) for i in range(0, len(data), channels)
+        ]
+        count = min(colors, len(entries))
+
+        im = self
+        if sort_palette is not None:
+            if sort_palette == "brightness":
+
+                def key(i):
+                    r, g, b = entries[i][:3]
+                    return (r * 299 + g * 587 + b * 114, entries[i])
+
+            else:
+
+                def key(i):
+                    return entries[i]
+
+            order = sorted(range(count), key=key)
+            lut = list(range(256))
+            for new_index, old_index in enumerate(order):
+                lut[old_index] = new_index
+            entries = [entries[i] for i in order] + entries[count:]
+            im = self._new(self.im.point(lut, None))
+
+        if lightness_factor != 1.0:
+            entries = [
+                tuple(
+                    min(255, max(0, int(round(v * lightness_factor))))
+                    for v in entry[:3]
+                )
+                + entry[3:]
+                for entry in entries
+            ]
+
+        data = bytes(v for entry in entries for v in entry)
+        if mode == "RGBA":
+            im.im.putpalette("RGBX", data)
+            im.im.putpalettealphas(data[3::4])
+        else:
+            im.im.putpalette(mode, data)
+        im.palette = ImagePalette.ImagePalette(mode, im.im.getpalette(mode, mode))
         return im
 
