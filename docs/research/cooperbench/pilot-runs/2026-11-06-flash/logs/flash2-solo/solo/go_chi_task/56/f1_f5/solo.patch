+
+// methodNames maps method types to their string names. It is an alias of
+// reverseMethodMap kept for use by the CORS helpers.
+var methodNames = reverseMethodMap
+
+// GetMethodName returns the HTTP method name for the given method type, or
+// an empty string if the method type is unknown.
+func GetMethodName(mt methodTyp) string {
+	return methodNames[mt]
+}
+
+// methodTypsToNames converts a list of method types into a sorted (by method
+// type bit order), de-duplicated list of method names.
+func methodTypsToNames(mts []methodTyp) []string {
+	var seen methodTyp
+	sorted := make([]methodTyp, 0, len(mts))
+	for _, mt := range mts {
+		if seen&mt != 0 {
+			continue
+		}
+		seen |= mt
+		sorted = append(sorted, mt)
+	}
+	sort.Slice(sorted, func(i, j int) bool { return sorted[i] < sorted[j] })
+	names := make([]string, 0, len(sorted))
+	for _, mt := range sorted {
+		if name, ok := reverseMethodMap[mt]; ok {
+			names = append(names, name)
+		}
+	}
+	return names
+}
