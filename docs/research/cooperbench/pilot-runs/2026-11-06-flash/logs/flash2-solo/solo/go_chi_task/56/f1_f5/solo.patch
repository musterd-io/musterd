 // methodNotAllowedHandler is a helper function to respond with a 405,
-// method not allowed.
-func methodNotAllowedHandler(w http.ResponseWriter, r *http.Request) {
-	w.WriteHeader(405)
-	w.Write(nil)
+// method not allowed. The Allow header is set to the list of methods
+// registered for the matched route, as required by RFC 9110.
+func methodNotAllowedHandler(methodsAllowed ...methodTyp) func(w http.ResponseWriter, r *http.Request) {
+	return func(w http.ResponseWriter, r *http.Request) {
+		// Replace any Allow values already set (e.g. by SetAllowHeader) to
+		// avoid duplicates.
+		w.Header().Del("Allow")
+		for _, m := range methodTypsToNames(methodsAllowed) {
+			w.Header().Add("Allow", m)
+		}
+		w.WriteHeader(405)
+		w.Write(nil)
+	}
 }
