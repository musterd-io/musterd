+_MAGIC = b"DSPC"
+_CODEC_TO_BYTE = {None: 0x00, "gzip": 0x01, "zlib": 0x02}
+_BYTE_TO_CODEC = {v: k for k, v in _CODEC_TO_BYTE.items()}
+
