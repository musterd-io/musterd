+def _decode(blob: Any) -> Any:
+    """Decode a value read from disk. Values without the magic header are treated as legacy entries."""
+    if not isinstance(blob, (bytes, bytearray)):
+        # Legacy entry stored as a Python object (DiskCache handled the pickling).
+        return blob
+    blob = bytes(blob)
+    if len(blob) >= 5 and blob[:4] == _MAGIC:
+        codec_byte = blob[4]
+        if codec_byte not in _BYTE_TO_CODEC:
+            raise ValueError(f"Unknown DSPy cache codec byte: {codec_byte}")
+        codec = _BYTE_TO_CODEC[codec_byte]
