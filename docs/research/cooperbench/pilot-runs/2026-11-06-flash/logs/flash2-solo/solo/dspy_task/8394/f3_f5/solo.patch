+        if codec == "gzip":
+            payload = gzip.decompress(payload)
+        elif codec == "zlib":
+            payload = zlib.decompress(payload)
+        return pickle.loads(payload)
+    # Header-less bytes: treat as a legacy raw pickle, falling back to the raw bytes.
+    try:
+        return pickle.loads(blob)
+    except Exception:
+        return blob
