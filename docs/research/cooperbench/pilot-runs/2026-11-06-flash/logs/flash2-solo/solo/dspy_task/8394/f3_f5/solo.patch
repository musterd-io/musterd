+def _encode(value: Any, codec: Optional[str]) -> bytes:
+    """Pickle `value`, optionally compress it, and prepend the DSPy magic header."""
+    payload = cloudpickle.dumps(value)
+    if codec == "gzip":
+        payload = gzip.compress(payload)
+    elif codec == "zlib":
+        payload = zlib.compress(payload)
+    return _MAGIC + bytes([_CODEC_TO_BYTE[codec]]) + payload
+
