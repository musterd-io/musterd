@@ -68,3 +68,13 @@ email = Regex(
 isbn = Regex(
     r"(?:ISBN(?:-1[03])?:? )?(?=[0-9X]{10}$|(?=(?:[0-9]+[- ]){3})[- 0-9X]{13}$|97[89][0-9]{10}$|(?=(?:[0-9]+[- ]){4})[- 0-9]{17}$)(?:97[89][- ]?)?[0-9]{1,5}[- ]?[0-9]+[- ]?[0-9]+[- ]?[0-9X]"
 )
+
+# Matches HTTP and HTTPS web URLs. The scheme is required, followed by a host
+# (domain name, IP address, ...), an optional port, and an optional path, query
+# string and fragment. Whitespace is not allowed anywhere in the URL.
+url = Regex(r"https?://[^\s/$.?#][^\s/?#]*(?:[/?#][^\s]*)?")
+
+# Matches 16-digit credit card numbers, either without separators or split in
+# groups of 4 digits separated consistently by spaces or by hyphens.
+# Note that this does not verify the Luhn checksum.
+credit_card = Regex(r"\d{16}|\d{4}-\d{4}-\d{4}-\d{4}|\d{4} \d{4} \d{4} \d{4}")
