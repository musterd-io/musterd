+class IsEmail(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid email address, optionally checking the domain.
+    """
+
+    _email_regex = re.compile(
+        r'^[a-zA-Z0-9.!#$%&\'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?'
+        r'(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$'
+    )
+
+    def __init__(self, domain: Optional[str] = None):
+        """
+        Args:
+            domain: The domain the email address must belong to (case-sensitive),
+                if omitted, any domain is accepted.
+
+        ```py title="IsEmail"
+        from dirty_equals import IsEmail
+
+        assert 'user@example.com' == IsEmail
+        assert 'user@example.com' == IsEmail(domain='example.com')
+        assert 'user@other.com' != IsEmail(domain='example.com')
+        assert 'not-an-email' != IsEmail
+        ```
+        """
+        self.domain = domain
+        super().__init__(plain_repr('*') if domain is None else domain)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str) or not self._email_regex.match(other):
+            return False
+        if self.domain is None:
+            return True
+        return other.rsplit('@', 1)[1] == self.domain
+
+
+class IsHash(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid hexadecimal hash for a given algorithm.
+    """
+
+    _hash_lengths = {
+        'md5': 32,
+        'sha1': 40,
+        'sha224': 56,
+        'sha256': 64,
+        'sha384': 96,
+        'sha512': 128,
+    }
+    _hex_regex = re.compile(r'^[0-9a-fA-F]+$')
+
+    def __init__(self, algorithm: str):
+        """
+        Args:
+            algorithm: The hash algorithm to check, one of `md5`, `sha1`, `sha224`, `sha256`,
+                `sha384` or `sha512` (case-insensitive).
+
+        ```py title="IsHash"
+        from dirty_equals import IsHash
+
+        assert 'd41d8cd98f00b204e9800998ecf8427e' == IsHash('md5')
+        assert 'da39a3ee5e6b4b0d3255bfef95601890afd80709' == IsHash('sha1')
+        assert 'd41d8cd98f00b204e9800998ecf8427e' != IsHash('sha1')
+        assert 'not a hash' != IsHash('md5')
+        ```
+        """
+        key = algorithm.lower().replace('-', '') if isinstance(algorithm, str) else algorithm
+        if key not in self._hash_lengths:
+            raise ValueError(
+                f'Unsupported hash algorithm: {algorithm!r}, '
+                f'supported algorithms: {", ".join(self._hash_lengths)}'
+            )
+        self.algorithm = algorithm
+        self.length = self._hash_lengths[key]
+        super().__init__(algorithm)
+
+    def equals(self, other: Any) -> bool:
+        return isinstance(other, str) and len(other) == self.length and bool(self._hex_regex.match(other))
