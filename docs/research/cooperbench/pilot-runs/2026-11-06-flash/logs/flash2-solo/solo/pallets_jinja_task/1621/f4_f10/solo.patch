+    def _get_aliases(self) -> t.Dict[str, str]:
+        # Subclasses are not required to call ``BaseLoader.__init__``,
+        # so the alias mapping is created lazily.
+        try:
+            return self.__dict__["_aliases"]  # type: ignore
+        except KeyError:
+            aliases: t.Dict[str, str] = {}
+            self.__dict__["_aliases"] = aliases
+            return aliases
+
+    def add_alias(self, alias: str, target: str) -> None:
+        """Make the template ``target`` available under the name
+        ``alias`` as well. Adding an existing alias again overwrites
+        it. Aliases are not resolved recursively.
+
+        .. versionadded:: 3.1
+        """
+        self._get_aliases()[alias] = target
+
+    def remove_alias(self, alias: str) -> None:
+        """Remove an alias added with :meth:`add_alias`. Removing an
+        alias that does not exist does nothing.
+
+        .. versionadded:: 3.1
+        """
+        self._get_aliases().pop(alias, None)
+
+    def resolve_alias(self, template: str) -> str:
+        """Return the template name an alias points to, or the name
+        unchanged if it is not an alias.
+
+        .. versionadded:: 3.1
+        """
+        return self._get_aliases().get(template, template)
+
+    def _alias_uptodate(
+        self, name: str, uptodate: t.Optional[t.Callable[[], bool]]
+    ) -> t.Callable[[], bool]:
+        """Wrap an ``uptodate`` function so that a cached template is
+        reloaded if the alias it was loaded through changes.
+        """
+        target = self.resolve_alias(name)
+
+        def alias_uptodate() -> bool:
+            if self.resolve_alias(name) != target:
+                return False
+
+            return uptodate is None or uptodate()
+
+        return alias_uptodate
+
