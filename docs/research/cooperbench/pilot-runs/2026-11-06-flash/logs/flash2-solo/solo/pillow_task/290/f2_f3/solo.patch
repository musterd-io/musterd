-from .helper import assert_image, assert_image_similar, hopper, is_ppc64le
+from .helper import assert_image, assert_image_equal, assert_image_similar, hopper, is_ppc64le
 
 
 def test_sanity():
@@ -85,3 +85,53 @@ def test_transparent_colors_equal():
     converted = im.quantize()
     converted_px = converted.load()
     assert converted_px[0, 0] == converted_px[0, 1]
+
+
+def test_max_colors():
+    image = hopper()
+    converted = image.quantize(colors=100, max_colors=50)
+    assert len(converted.getcolors()) <= 50
+
+    # max_colors defaults to colors
+    converted = image.quantize(colors=20)
+    assert len(converted.getcolors()) == 20
+
+    # max_colors above colors has no effect
+    converted = image.quantize(colors=20, max_colors=100)
+    assert len(converted.getcolors()) == 20
+
+    with pytest.raises(ValueError):
+        image.quantize(colors=10, max_colors=0)
+    with pytest.raises(ValueError):
+        image.quantize(colors=10, max_colors=257)
+
+
+@pytest.mark.parametrize("method", ("brightness", "rgb"))
+def test_sort_palette(method):
+    image = hopper()
+    unsorted = image.quantize(16)
+    converted = image.quantize(16, sort_palette=method)
+
+    # Image content is unchanged
+    assert_image_equal(converted.convert("RGB"), unsorted.convert("RGB"))
+
+    palette = converted.palette.palette
+    entries = [tuple(palette[i * 3 : i * 3 + 3]) for i in range(16)]
+    if method == "brightness":
+        keys = [r * 299 + g * 587 + b * 114 for r, g, b in entries]
+    else:
+        keys = entries
+    assert keys == sorted(keys)
+
+
+def test_sort_palette_rgba():
+    image = hopper("RGBA")
+    unsorted = image.quantize(8)
+    converted = image.quantize(8, sort_palette="rgb")
+    assert converted.palette.mode == "RGBA"
+    assert_image_equal(converted.convert("RGBA"), unsorted.convert("RGBA"))
+
+
+def test_sort_palette_invalid():
+    with pytest.raises(ValueError):
+        hopper().quantize(sort_palette="invalid")
