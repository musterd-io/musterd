+    def _record_option_change(
+        self, name: str, value: t.Any, source: ParameterSource | None
+    ) -> None:
+        """Record a value change for a parameter if tracking is enabled."""
+        if not self._track_changes:
+            return
+
+        import time
+
+        self._option_history.setdefault(name, []).append(
+            {"value": value, "source": source, "timestamp": time.time()}
+        )
+
+    def get_option_history(self, name: str) -> list[dict[str, t.Any]] | None:
+        """Get the history of values set for an option. Each entry is a
+        dict with ``value``, ``source`` (a :class:`ParameterSource`), and
+        ``timestamp`` keys.
+
+        :param name: The parameter name (``"count"``) or one of the
+            option's flags (``"--count"``, ``"-c"``).
+        :return: ``None`` if tracking is disabled for the command, an
+            empty list if no history exists for the option.
+        """
+        if not self._track_changes:
+            return None
+
+        if name in self._option_history:
+            return list(self._option_history[name])
+
+        for param in self.command.params:
+            if name in param.opts or name in param.secondary_opts:
+                if param.name is not None:
+                    return list(self._option_history.get(param.name, []))
+
+        return []
+
 
