+    def shell_complete(self, ctx: Context, incomplete: str) -> list[CompletionItem]:
+        """Return a list of completions for the incomplete value. A
+        custom ``shell_complete`` function takes precedence. Otherwise, if
+        ``auto_complete`` is enabled, :meth:`_smart_complete` is used.
+        """
+        if self._custom_shell_complete is None and self.auto_complete:
+            return self._smart_complete(ctx, incomplete)
+
+        return super().shell_complete(ctx, incomplete)
+
+    def _smart_complete(self, ctx: Context, incomplete: str) -> list[CompletionItem]:
+        """Choose a completion strategy based on the option's type, name,
+        and the current environment, falling back to the type's completion.
+        """
+        from click.shell_completion import CompletionItem
+
+        # Types with their own specific completion take priority.
+        if isinstance(self.type, (types.Choice, types.Path, types.File)):
+            return self.type.shell_complete(ctx, self, incomplete)
+
+        names = {self.name or ""}
+        names.update(o.lstrip("-").replace("-", "_") for o in self.opts)
+        names = {n.lower() for n in names if n}
+
+        for patterns, func in _SMART_COMPLETION_REGISTRY:
+            if names & patterns:
+                values = func(incomplete)
+
+                if values is None:
+                    continue
+
+                if isinstance(values, list) and values and isinstance(
+                    values[0], CompletionItem
+                ):
+                    return values
+
+                return [CompletionItem(v) for v in values]
+
+        return self.type.shell_complete(ctx, self, incomplete)
+
