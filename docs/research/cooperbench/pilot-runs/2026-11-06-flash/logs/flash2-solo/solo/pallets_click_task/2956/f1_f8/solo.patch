+def _complete_users(incomplete: str) -> list[str]:
+    try:
+        import pwd
+    except ImportError:
+        return []
+
+    try:
+        users = {u.pw_name for u in pwd.getpwall()}
+    except Exception:
+        return []
+
+    return sorted(u for u in users if u.startswith(incomplete))
+
+
+def _complete_git_branches(incomplete: str) -> list[str] | None:
+    import subprocess
+
+    try:
+        out = subprocess.run(
+            ["git", "branch", "-a", "--format=%(refname:short)"],
+            capture_output=True,
+            text=True,
+            timeout=5,
+        )
+    except (OSError, subprocess.SubprocessError):
+        return []
+
+    if out.returncode != 0:
+        return []
+
+    branches: list[str] = []
+
+    for line in out.stdout.splitlines():
+        line = line.strip()
+
+        if line and line.startswith(incomplete) and line not in branches:
+            branches.append(line)
+
+    return branches
+
+
+def _complete_envvars(incomplete: str) -> list[str]:
+    return sorted(k for k in os.environ if k.startswith(incomplete))
+
+
+def _complete_files(incomplete: str) -> list[CompletionItem]:
+    from click.shell_completion import CompletionItem
+
+    return [CompletionItem(incomplete, type="file")]
+
+
+def _complete_dirs(incomplete: str) -> list[CompletionItem]:
+    from click.shell_completion import CompletionItem
+
+    return [CompletionItem(incomplete, type="dir")]
+
+
+#: Maps option name patterns to completion functions used by
+#: :meth:`Option._smart_complete`. A function may return ``None`` to
+#: fall through to the next matching entry.
+_SMART_COMPLETION_REGISTRY: list[
+    tuple[set[str], t.Callable[[str], t.Any]]
+] = [
+    ({"user", "username", "users", "owner"}, _complete_users),
+    ({"branch", "branches"}, _complete_git_branches),
+    ({"env", "envvar", "env_var", "environment", "var"}, _complete_envvars),
+    ({"dir", "directory", "folder", "cwd", "workdir"}, _complete_dirs),
+    (
+        {"file", "filename", "path", "filepath", "input", "output", "config"},
+        _complete_files,
+    ),
+]
+
