+def _ensure_non_empty(data_buffer: BytesIO, method_name: str) -> int:
+    """Return the buffer size, raising if the buffer holds zero bytes."""
+    data_buffer.seek(0, 2)
+    size = data_buffer.tell()
+    data_buffer.seek(0)
+    if size == 0:
+        raise ValueError(f"{method_name} returned zero bytes")
+    return size
