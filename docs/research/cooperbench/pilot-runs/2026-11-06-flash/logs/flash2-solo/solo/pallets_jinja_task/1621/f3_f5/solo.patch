+def validate_template_path(template: str) -> None:
+    """Check a template path for dangerous or malformed input. Raises
+    :exc:`TemplateNotFound` if the path is empty, contains null bytes or
+    control characters, or is an absolute path or has a drive letter.
+    """
+    if not template:
+        raise TemplateNotFound(template)
+
+    if "\x00" in template:
+        raise TemplateNotFound(template)
+
+    if template[0] in ("/", "\\"):
+        raise TemplateNotFound(template)
+
+    if len(template) >= 2 and template[1] == ":" and template[0].isascii() and (
+        template[0].isalpha()
+    ):
+        raise TemplateNotFound(template)
+
+    for char in template:
+        if ord(char) < 32 and char not in "\t\n\r":
+            raise TemplateNotFound(template)
+
