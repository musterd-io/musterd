+    def get_image_mimetype(self) -> str | None:
+        """Get the MIME type of the image with lazy evaluation and caching.
+
+        This method provides on-demand MIME type resolution. If the MIME type
+        is already set, it returns the cached value. Otherwise, it attempts to
+        guess the MIME type from the image data and caches the result.
+
+        Returns:
+            The MIME type string if it can be determined, None otherwise.
+        """
+        if self.image_mimetype:
+            return self.image_mimetype
+
+        if self.image:
+            # Decode base64 if needed for filetype guessing
+            image_data = self.image
+            try:
+                # Image is stored as base64-encoded, decode it for guessing
+                image_data = base64.b64decode(self.image)
+            except Exception:
+                # If decoding fails, assume it's raw bytes
+                pass
+
+            guess = filetype.guess(image_data)
+            self.image_mimetype = guess.mime if guess else None
+
+        return self.image_mimetype
+
