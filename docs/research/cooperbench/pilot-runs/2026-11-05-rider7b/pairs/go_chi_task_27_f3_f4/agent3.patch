@@ -0,0 +1,22 @@
+package chi
+
+import (
+	"fmt"
+	"os"
+)
+
+var debugLoggingEnabled bool
+
+// EnableDebugLogging turns on debug-level logging for route pattern handling.
+// This provides visibility into how patterns are parsed and processed, which is
+// useful for debugging route handling issues.
+func EnableDebugLogging() {
+	debugLoggingEnabled = true
+}
+
+// debugLog outputs a debug message if debug logging is enabled.
+func debugLog(format string, args ...interface{}) {
+	if debugLoggingEnabled {
+		fmt.Fprintf(os.Stderr, "[chi debug] "+format+"\n", args...)
+	}
+}
