+    @classmethod
+    def validate_input(cls, data: Any) -> dict[str, Any] | list[dict[str, Any]] | str:
+        """Normalize varied LM output formats for tool calls.
+
+        This method handles multiple formats that language models might return:
+        1. Canonical format: {"tool_calls": [{"name": "foo", "args": {...}}, ...]}
+        2. Single object: {"name": "foo", "args": {...}}
+        3. Bare list: [{"name": "foo", "args": {...}}, ...]
+        4. JSON strings (parsed and then normalized)
+        5. Non-JSON strings (returned unchanged)
+
+        Args:
+            data: The input data to normalize. Can be a dict, list, or string.
+
+        Returns:
+            Normalized Python structure (dict, list, or string).
+            - Dict with "tool_calls" key for canonical format
+            - Single dict for single object format
+            - List of dicts for bare list format
+            - Original string if it cannot be parsed as JSON
+
+        Example:
+
+            ```python
+            # Single object format
+            result = ToolCalls.validate_input({"name": "search", "args": {"query": "hello"}})
+            # Returns: {"tool_calls": [{"name": "search", "args": {"query": "hello"}}]}
+
+            # Bare list format
+            result = ToolCalls.validate_input([{"name": "search", "args": {"query": "hello"}}])
+            # Returns: {"tool_calls": [{"name": "search", "args": {"query": "hello"}}]}
+
+            # Canonical format (unchanged)
+            result = ToolCalls.validate_input({"tool_calls": [{"name": "search", "args": {"query": "hello"}}]})
+            # Returns: {"tool_calls": [{"name": "search", "args": {"query": "hello"}}]}
+            ```
+        """
+        # If input is a string, try to parse it as JSON
+        if isinstance(data, str):
+            try:
+                data = json.loads(data)
+            except (json.JSONDecodeError, ValueError):
+                # Not valid JSON, return the original string unchanged
+                return data
+
+        # Now handle dict or list formats
+        if isinstance(data, dict):
+            # Check if it's already in canonical format with "tool_calls" key
+            if "tool_calls" in data:
+                return data
+
+            # Check if it's a single tool call object (has "name" and "args")
+            if "name" in data and "args" in data:
+                # Wrap single object in canonical format
+                return {"tool_calls": [data]}
+
+            # Otherwise, return as-is (might be some other dict format)
+            return data
+
+        elif isinstance(data, list):
+            # Check if it's a non-empty list of tool call objects
+            if data and all(isinstance(item, dict) and "name" in item and "args" in item for item in data):
+                # Wrap bare list in canonical format
+                return {"tool_calls": data}
+
+            # Otherwise, return as-is (including empty lists)
+            return data
+
+        # For any other type, return unchanged
+        return data
