+        @model_validator(mode='after')
+        def _compute_fingerprint(self) -> 'ToolCalls.ToolCall':
+            """Compute a stable fingerprint for this tool call."""
+            # Canonicalize the args (sort keys, tuple→list, trim strings)
+            canonical_args = _canonicalize_args(self.args)
+
+            # Create canonical representation: {name: ..., args: ...}
+            canonical_repr = {
+                "name": self.name,
+                "args": canonical_args
+            }
+
+            # Serialize to JSON with sorted keys and compact separators
+            canonical_json = json.dumps(canonical_repr, sort_keys=True, separators=(",", ":"))
+
+            # Compute SHA-256 hash
+            hash_obj = hashlib.sha256(canonical_json.encode('utf-8'))
+            fingerprint_hex = hash_obj.hexdigest()
+
+            # Set fingerprint (64 chars) and id (first 8 chars)
+            self.fingerprint = fingerprint_hex
+            self.id = fingerprint_hex[:8]
+
+            return self
 
