+def _canonicalize_args(args: dict[str, Any]) -> dict[str, Any]:
+    """Recursively canonicalize tool call arguments for stable fingerprinting.
+
+    This ensures identical calls produce the same fingerprint regardless of:
+    - Dictionary key order
+    - Tuple vs list representation
+    - Extra whitespace in string values
+
+    Args:
+        args: The arguments dictionary to canonicalize
+
+    Returns:
+        A canonicalized version of the arguments
+    """
+    def canonicalize_value(value: Any) -> Any:
+        if isinstance(value, dict):
+            # Recursively canonicalize nested dicts and sort keys
+            return {k: canonicalize_value(v) for k, v in sorted(value.items())}
+        elif isinstance(value, (list, tuple)):
+            # Convert tuples to lists and recursively canonicalize elements
+            return [canonicalize_value(item) for item in value]
+        elif isinstance(value, str):
+            # Trim leading/trailing whitespace from strings
+            return value.strip()
+        else:
+            # Keep numeric, boolean, and other types as-is
+            return value
+
+    return canonicalize_value(args)
+
