+// parseMethodPattern splits a "METHOD /path" pattern into its method type and
+// path, e.g. "GET /users/*". It returns ok=false when the pattern does not
+// include a method, and panics on an unsupported method.
+func parseMethodPattern(pattern string) (methodTyp, string, bool) {
+	parts := strings.SplitN(pattern, " ", 2)
+	if len(parts) != 2 {
+		return 0, "", false
+	}
+	methodStr := strings.ToUpper(parts[0])
+	method, ok := methodMap[methodStr]
+	if !ok {
+		panic("chi: invalid HTTP method specified in pattern: " + methodStr)
+	}
+	return method, strings.TrimLeft(parts[1], " "), true
+}
