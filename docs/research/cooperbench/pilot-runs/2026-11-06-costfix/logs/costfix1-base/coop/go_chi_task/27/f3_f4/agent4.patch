+package chi
+
+import (
+	"log"
+	"strings"
+	"sync/atomic"
+)
+
+// debugLogging toggles debug-level logging of route pattern handling.
+var debugLogging int32
+
+// EnableDebugLogging turns on debug-level logging of how route patterns
+// are parsed and registered by Handle and HandleFunc. Logging is off by
+// default. Output is written through the standard library `log` package.
+func EnableDebugLogging() {
+	atomic.StoreInt32(&debugLogging, 1)
+}
+
+// debugf logs a debug message when debug logging is enabled.
+func debugf(format string, args ...interface{}) {
+	if atomic.LoadInt32(&debugLogging) == 0 {
+		return
+	}
+	log.Printf("chi: [debug] "+format, args...)
+}
+
+// logPatternHandling logs how a route pattern was parsed: the method
+// detected in the pattern (if any) and the resulting path.
+func logPatternHandling(fn, pattern, path string, hasMethod bool) {
+	if atomic.LoadInt32(&debugLogging) == 0 {
+		return
+	}
+	if !hasMethod {
+		debugf("%s: pattern %q has no method, matching all methods on path %q", fn, pattern, path)
+		return
+	}
+	methodStr := strings.ToUpper(strings.SplitN(pattern, " ", 2)[0])
+	debugf("%s: pattern %q parsed with method %q on path %q", fn, pattern, methodStr, path)
+}
