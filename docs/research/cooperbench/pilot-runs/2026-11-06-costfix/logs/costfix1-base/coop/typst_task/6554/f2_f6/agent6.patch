+impl Str {
+    /// Returns the string, optionally trimmed of whitespace with `trim`.
+    /// Fails if a non-empty string becomes empty through trimming.
+    fn trimmed<'a>(
+        &'a self,
+        skip_whitespace: bool,
+        trim: fn(&'a str, fn(char) -> bool) -> &'a str,
+    ) -> StrResult<&'a str> {
+        if !skip_whitespace {
+            return Ok(self.0.as_str());
+        }
+        let s = trim(self.0.as_str(), char::is_whitespace);
+        if s.is_empty() && !self.0.is_empty() {
+            return Err(string_contains_only_whitespace());
+        }
+        Ok(s)
+    }
+}
+
+/// Selects the grapheme at `index` (or the first one) from an iterator.
+fn select_grapheme<'a>(
+    graphemes: impl Iterator<Item = &'a str> + Clone,
+    index: Option<usize>,
+) -> StrResult<Str> {
+    let i = index.unwrap_or(0);
+    graphemes.clone().nth(i).map(Into::into).ok_or_else(|| {
+        match index {
+            None => string_is_empty(),
+            Some(_) => eco_format!(
+                "index {i} out of bounds for string with {} characters",
+                graphemes.count()
+            ),
+        }
+    })
+}
+
+/// The error message when a string only contains whitespace.
+#[cold]
+fn string_contains_only_whitespace() -> EcoString {
+    "string contains only whitespace".into()
+}
