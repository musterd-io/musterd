+def _canonicalize_tool_args(value: Any) -> Any:
+    """Canonicalize tool call arguments for stable fingerprinting.
+
+    Recursively sorts dict keys, converts tuples to lists, and strips leading/trailing whitespace from strings.
+    Numeric and boolean values are left untouched.
+    """
+    if isinstance(value, dict):
+        return {k: _canonicalize_tool_args(value[k]) for k in sorted(value, key=str)}
+    if isinstance(value, (list, tuple)):
+        return [_canonicalize_tool_args(v) for v in value]
+    if isinstance(value, str):
+        return value.strip()
+    return value
+
