+    @model_validator(mode="before")
+    @classmethod
+    def validate_input(cls, data: Any) -> Any:
+        """Normalize varied LM output formats into the canonical `{"tool_calls": [...]}` structure.
+
+        Accepted formats:
+            - `{"tool_calls": [{"name": ..., "args": ...}, ...]}` (canonical)
+            - `{"name": ..., "args": ...}` (single tool call)
+            - `[{"name": ..., "args": ...}, ...]` (bare list of tool calls)
+            - A JSON string encoding any of the above.
+        """
+        if isinstance(data, cls):
+            return data
+
+        if isinstance(data, str):
+            try:
+                data = json.loads(data)
+            except (json.JSONDecodeError, ValueError):
+                return data
+
+        def _is_tool_call(item: Any) -> bool:
+            return isinstance(item, dict) and "name" in item and "args" in item
+
+        if isinstance(data, dict):
+            if "tool_calls" not in data and _is_tool_call(data):
+                return {"tool_calls": [data]}
+            return data
+
+        if isinstance(data, list) and all(_is_tool_call(item) for item in data):
+            return {"tool_calls": data}
+
+        return data
