+def _canonicalize_args(value: Any) -> Any:
+    """Canonicalize tool call args: sort dict keys recursively, convert tuples to lists, and trim string whitespace."""
+    if isinstance(value, dict):
+        return {str(k): _canonicalize_args(value[k]) for k in sorted(value, key=str)}
+    if isinstance(value, (list, tuple)):
+        return [_canonicalize_args(v) for v in value]
+    if isinstance(value, str):
+        return value.strip()
+    return value
+
