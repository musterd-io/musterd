+    @classmethod
+    def validate_input(cls, data: Any) -> Any:
+        """Normalize the varied formats LMs use for tool calls.
+
+        Accepts the canonical `{"tool_calls": [...]}` dict, a single `{"name": ..., "args": ...}` dict, a bare list
+        of such dicts, or a JSON string of any of these. Returns the normalized Python structure. Strings that
+        cannot be parsed as JSON are returned unchanged.
+        """
+        if isinstance(data, cls):
+            return data
+
+        if isinstance(data, str):
+            try:
+                data = json.loads(data)
+            except (json.JSONDecodeError, ValueError):
+                try:
+                    repaired = json_repair.loads(data)
+                except Exception:
+                    return data
+                if not isinstance(repaired, (dict, list)) or not repaired:
+                    return data
+                data = repaired
+
+        def is_tool_call(item: Any) -> bool:
+            return isinstance(item, dict) and "name" in item and "args" in item
+
+        if isinstance(data, dict):
+            if "tool_calls" in data:
+                return data
+            if is_tool_call(data):
+                return {"tool_calls": [data]}
+            return data
+
+        if isinstance(data, list) and all(is_tool_call(item) for item in data):
+            return {"tool_calls": data}
+
+        return data
+
+    @model_validator(mode="before")
+    @classmethod
+    def _normalize_input(cls, data: Any) -> Any:
+        return cls.validate_input(data)
