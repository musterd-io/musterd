+    def get_image_mimetype(self) -> str | None:
+        """Return the image mimetype, guessing and caching it when not set.
+
+        The guess only uses in-memory image data: the path or the URL are
+        never loaded, to avoid resource-intense operations.
+        """
+        if self.image_mimetype:
+            return self.image_mimetype
+
+        if self.image:
+            guess = filetype.guess(self.image)
+            if guess is None:
+                # the stored image data might be base64-encoded
+                try:
+                    guess = filetype.guess(base64.b64decode(self.image, validate=True))
+                except Exception:
+                    guess = None
+            self.image_mimetype = guess.mime if guess else None
+
+        return self.image_mimetype
+
