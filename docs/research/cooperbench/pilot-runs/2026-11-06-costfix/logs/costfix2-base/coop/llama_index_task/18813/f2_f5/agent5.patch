+def _check_max_bytes(
+    data_buffer: BytesIO, max_bytes: Optional[int], method_name: str
+) -> None:
+    """Raise a ValueError if the buffer is larger than max_bytes."""
+    if max_bytes is None:
+        return
+    size = data_buffer.getbuffer().nbytes
+    if size > max_bytes:
+        raise ValueError(
+            f"{method_name} exceeds maximum allowed size ({size} > {max_bytes})"
+        )
