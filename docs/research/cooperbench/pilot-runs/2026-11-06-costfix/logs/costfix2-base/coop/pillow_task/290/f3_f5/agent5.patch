+def test_quantize_lightness_factor_brighter():
+    image = hopper()
+    base = image.quantize()
+    bright = image.quantize(lightness_factor=1.2)
+
+    assert bright.tobytes() == base.tobytes()
+    for b, v in zip(base.getpalette(), bright.getpalette()):
+        assert v == min(255, round(b * 1.2))
+    assert bright.convert("RGB").getextrema() != base.convert("RGB").getextrema()
