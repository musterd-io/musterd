+def test_exif_transpose_logger_callable() -> None:
+    messages: list[str] = []
+    with Image.open("Tests/images/hopper_orientation_6.jpg") as im:
+        transposed_im = ImageOps.exif_transpose(im, logger=messages.append)
+    assert 0x0112 not in transposed_im.getexif()
+    assert any("ROTATE_270" in m for m in messages)
+    assert any("removed orientation" in m for m in messages)
+
+    messages.clear()
+    ImageOps.exif_transpose(hopper(), logger=messages.append)
+    assert any("no transformation needed" in m for m in messages)
+
+
+def test_exif_transpose_logger_standard(caplog: pytest.LogCaptureFixture) -> None:
+    logger = logging.getLogger("test_exif_transpose")
+    with caplog.at_level(logging.DEBUG, logger="test_exif_transpose"):
+        with Image.open("Tests/images/hopper_orientation_3.jpg") as im:
+            ImageOps.exif_transpose(im, in_place=True, logger=logger)
+    assert "ROTATE_180" in caplog.text
+    assert "completed in" in caplog.text
+
+
+def test_exif_transpose_no_logger() -> None:
+    with Image.open("Tests/images/hopper_orientation_6.jpg") as im:
+        assert ImageOps.exif_transpose(im, logger=None).size == (128, 128)
+
+
+def test_exif_transpose_xmp_tuple() -> None:
+    with Image.open("Tests/images/xmp_tags_orientation.png") as im:
+        assert im.getexif()[0x0112] == 3
+
+        im.info["xmp"] = (b"test",)
+        transposed_im = ImageOps.exif_transpose(im)
+        assert 0x0112 not in transposed_im.getexif()
+
+        transposed_im._reload_exif()
+        assert 0x0112 not in transposed_im.getexif()
