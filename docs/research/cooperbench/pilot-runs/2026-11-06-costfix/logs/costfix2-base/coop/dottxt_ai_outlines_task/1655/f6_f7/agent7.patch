 isbn = Regex(
     r"(?:ISBN(?:-1[03])?:? )?(?=[0-9X]{10}$|(?=(?:[0-9]+[- ]){3})[- 0-9X]{13}$|97[89][0-9]{10}$|(?=(?:[0-9]+[- ]){4})[- 0-9]{17}$)(?:97[89][- ]?)?[0-9]{1,5}[- ]?[0-9]+[- ]?[0-9]+[- ]?[0-9X]"
 )
+
+# Matches HTTP and HTTPS web URLs. The host can be a domain name (with
+# optional subdomains) or an IPv4 address, followed by an optional port,
+# path, query string and fragment. Whitespace is not allowed anywhere.
+url = Regex(
+    r"https?://(?:(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\.)+[a-zA-Z]{2,63}|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9]))(?::[0-9]{1,5})?(?:/[^\s?#]*)?(?:\?[^\s#]*)?(?:#[^\s]*)?"
+)
+
+# Matches 16-digit credit card numbers, either with no separators or grouped
+# in blocks of 4 digits separated consistently by spaces or by hyphens
+# (e.g. "1234567890123456", "1234 5678 9012 3456", "1234-5678-9012-3456").
+# Note that this does not validate the Luhn checksum.
+credit_card = Regex(
+    r"(\d{4}-\d{4}-\d{4}-\d{4}|\d{4} \d{4} \d{4} \d{4}|\d{16})"
+)
