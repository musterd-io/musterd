+    def add_alias(self, alias: str, target: str) -> None:
+        """Make the template ``target`` available under the name ``alias``.
+        Aliases are resolved once and do not chain. Adding an alias that
+        already exists replaces its target.
+        """
+        if "_aliases" not in self.__dict__:
+            self._aliases: t.Dict[str, str] = {}
+        self._aliases[alias] = target
+
+    def remove_alias(self, alias: str) -> None:
+        """Remove an alias added with :meth:`add_alias`. Removing an alias
+        that does not exist is a no-op.
+        """
+        self.__dict__.get("_aliases", {}).pop(alias, None)
+
+    def resolve_alias(self, name: str) -> str:
+        """Return the target template name for ``name`` if it is an alias,
+        otherwise return ``name`` unchanged.
+        """
+        return self.__dict__.get("_aliases", {}).get(name, name)
 
