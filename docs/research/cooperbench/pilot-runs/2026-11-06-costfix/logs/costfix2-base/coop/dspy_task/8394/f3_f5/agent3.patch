+# On-disk blob format: b"DSPC" magic + 1 codec byte + payload (pickle, possibly compressed).
+# Blobs without the magic header are legacy entries stored as raw Python objects / pickles.
+_MAGIC_HEADER = b"DSPC"
+_CODEC_NONE = 0x00
+_CODEC_GZIP = 0x01
+_CODEC_ZLIB = 0x02
+_CODEC_TO_BYTE = {None: _CODEC_NONE, "gzip": _CODEC_GZIP, "zlib": _CODEC_ZLIB}
+
+
+def _validate_codec(codec: Optional[str]) -> Optional[str]:
+    if codec not in _CODEC_TO_BYTE:
+        raise ValueError(f"Unsupported compression codec: {codec!r}. Expected one of 'gzip', 'zlib', or None.")
+    return codec
+
+
+def _encode_disk_value(value: Any, codec: Optional[str]) -> bytes:
+    """Pickle `value`, optionally compress it, and prepend the DSPC magic header."""
+    payload = cloudpickle.dumps(value)
+    if codec == "gzip":
+        payload = gzip.compress(payload)
+    elif codec == "zlib":
+        payload = zlib.compress(payload)
+    return _MAGIC_HEADER + bytes([_CODEC_TO_BYTE[codec]]) + payload
+
+
+def _decode_disk_value(raw: Any) -> Any:
+    """Decode a value read from disk. Values lacking the DSPC header are returned as legacy entries."""
+    if isinstance(raw, (bytes, bytearray, memoryview)):
+        raw = bytes(raw)
+        if raw[:4] == _MAGIC_HEADER and len(raw) >= 5:
+            codec_byte = raw[4]
+            payload = raw[5:]
+            if codec_byte == _CODEC_GZIP:
+                payload = gzip.decompress(payload)
+            elif codec_byte == _CODEC_ZLIB:
+                payload = zlib.decompress(payload)
+            elif codec_byte != _CODEC_NONE:
+                raise ValueError(f"Unknown DSPy cache codec byte: {codec_byte}")
+            return pickle.loads(payload)
+        # Legacy raw pickle bytes.
+        try:
+            return pickle.loads(raw)
+        except Exception:
+            return raw
+    # Legacy entry already unpickled by diskcache.
+    return raw
+
 
