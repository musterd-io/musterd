+
+    @staticmethod
+    def _translation_version_key(message: str) -> str:
+        return hashlib.md5(message.encode("utf-8")).hexdigest()
+
+    def _set_translation_version(self, message: str, version: str) -> None:
+        """Store a version identifier for a translation message."""
+        key = self._translation_version_key(message)
+        self._translation_versions[key] = version
+
+    def _get_translation_version(self, message: str) -> t.Optional[str]:
+        """Return the stored version for a message, or ``None``."""
+        key = self._translation_version_key(message)
+        return self._translation_versions.get(key)
+
+    def _compare_translation_versions(self, message1: str, message2: str) -> bool:
+        """Return ``True`` if both messages have the same stored version.
+        Unversioned messages never compare equal.
+        """
+        version1 = self._get_translation_version(message1)
+        version2 = self._get_translation_version(message2)
+        return version1 is not None and version2 is not None and version1 == version2
 
