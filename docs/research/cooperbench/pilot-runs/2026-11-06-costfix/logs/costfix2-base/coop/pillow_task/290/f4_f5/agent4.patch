@@ -85,3 +85,74 @@ def test_transparent_colors_equal():
     converted = im.quantize()
     converted_px = converted.load()
     assert converted_px[0, 0] == converted_px[0, 1]
+
+
+def test_lightness_factor_default():
+    image = hopper()
+    assert image.quantize(64).getpalette() == image.quantize(
+        64, lightness_factor=1.0
+    ).getpalette()
+
+
+def test_lightness_factor_brighter_and_darker():
+    image = hopper()
+    base = image.quantize(64).getpalette()
+
+    brighter = image.quantize(64, lightness_factor=1.2).getpalette()
+    assert brighter == [min(255, int(round(v * 1.2))) for v in base]
+
+    darker = image.quantize(64, lightness_factor=0.5).getpalette()
+    assert darker == [int(round(v * 0.5)) for v in base]
+
+    assert image.quantize(64, lightness_factor=100).getpalette()[:3] == [
+        255 if v else 0 for v in base[:3]
+    ]
+
+
+def test_lightness_factor_with_palette():
+    image = hopper()
+    palette = hopper("P")
+    base = image.quantize(palette=palette).getpalette()
+    converted = image.quantize(palette=palette, lightness_factor=1.1)
+    assert converted.getpalette() == [min(255, int(round(v * 1.1))) for v in base]
+    # Reference palette is not modified
+    assert palette.getpalette() == hopper("P").getpalette()
+
+
+def test_lightness_factor_rgba_preserves_alpha():
+    image = hopper("RGBA")
+    image.putpixel((0, 0), (10, 20, 30, 100))
+    converted = image.quantize(lightness_factor=1.5)
+    assert converted.convert("RGBA").getpixel((0, 0)) == (15, 30, 45, 100)
+
+
+@pytest.mark.parametrize("factor", (0, -1, -0.5))
+def test_lightness_factor_invalid(factor):
+    with pytest.raises(ValueError):
+        hopper().quantize(lightness_factor=factor)
+
+
+def test_error_threshold_reduces_colors():
+    image = hopper()
+    full = image.quantize(64)
+    reduced = image.quantize(64, error_threshold=200)
+    assert len(reduced.getcolors()) < len(full.getcolors())
+    assert image._quantize_error(reduced) <= 200
+
+
+def test_error_threshold_unreachable_uses_max_colors():
+    image = hopper()
+    converted = image.quantize(64, error_threshold=0)
+    assert len(converted.getcolors()) == len(image.quantize(64).getcolors())
+
+
+def test_error_threshold_simple_image():
+    image = Image.new("RGB", (16, 16), (255, 0, 0))
+    converted = image.quantize(256, error_threshold=0)
+    assert len(converted.getcolors()) == 1
+    assert converted.convert("RGB").getpixel((0, 0)) == (255, 0, 0)
+
+
+def test_error_threshold_invalid():
+    with pytest.raises(ValueError):
+        hopper().quantize(error_threshold=-1)
