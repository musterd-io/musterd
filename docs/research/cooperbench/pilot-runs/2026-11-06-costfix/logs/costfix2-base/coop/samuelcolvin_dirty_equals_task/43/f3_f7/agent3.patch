+class IsHash(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid hexadecimal hash string for a given algorithm.
+    """
+
+    _lengths = {
+        'md5': 32,
+        'sha1': 40,
+        'sha224': 56,
+        'sha256': 64,
+        'sha384': 96,
+        'sha512': 128,
+    }
+
+    def __init__(self, algorithm: str):
+        """
+        Args:
+            algorithm: The hash algorithm the value should match, one of
+                `md5`, `sha1`, `sha224`, `sha256`, `sha384` or `sha512` (case-insensitive).
+
+        ```py title="IsHash"
+        from dirty_equals import IsHash
+
+        assert 'd41d8cd98f00b204e9800998ecf8427e' == IsHash('md5')
+        assert 'da39a3ee5e6b4b0d3255bfef95601890afd80709' == IsHash('sha1')
+        assert 'd41d8cd98f00b204e9800998ecf8427e' != IsHash('sha1')
+        assert 'not a hash' != IsHash('md5')
+        ```
+        """
+        key = algorithm.lower() if isinstance(algorithm, str) else algorithm
+        if key not in self._lengths:
+            raise ValueError(
+                f'Unsupported hash algorithm: {algorithm!r}, must be one of {", ".join(self._lengths)}'
+            )
+        self.algorithm = algorithm
+        self.expected_length = self._lengths[key]
+        super().__init__(algorithm)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str) or len(other) != self.expected_length:
+            return False
+        return all(c in '0123456789abcdefABCDEF' for c in other)
