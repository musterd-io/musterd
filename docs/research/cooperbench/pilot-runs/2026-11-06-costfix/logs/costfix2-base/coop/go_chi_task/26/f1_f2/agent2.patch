new file mode 100644
index 0000000..b2949fc
--- /dev/null
+++ b/metrics.go
@@ -0,0 +1,58 @@
+package chi
+
+import (
+	"context"
+	"net/http"
+	"time"
+)
+
+// MetricsCollector receives a notification for every request routed to a
+// matching handler by a Mux.
+type MetricsCollector interface {
+	// RecordHit is called after the matched handler has finished serving
+	// the request. ctx is the request context, which carries the routing
+	// context (see RouteContext).
+	RecordHit(ctx context.Context, r *http.Request, duration time.Duration)
+}
+
+// RouteMetric describes a single route hit.
+type RouteMetric struct {
+	Pattern  string // matched route pattern, e.g. "/users/{id}"
+	Method   string
+	Path     string
+	Duration time.Duration
+	Params   map[string]string // URL parameters keyed by name, e.g. {"id": "123"}
+}
+
+// SimpleMetricsCollector is a MetricsCollector that invokes OnHit with a
+// RouteMetric for every route hit.
+type SimpleMetricsCollector struct {
+	OnHit func(RouteMetric)
+}
+
+// NewSimpleMetricsCollector returns a SimpleMetricsCollector calling onHit.
+func NewSimpleMetricsCollector(onHit func(RouteMetric)) *SimpleMetricsCollector {
+	return &SimpleMetricsCollector{OnHit: onHit}
+}
+
+// RecordHit implements MetricsCollector.
+func (c *SimpleMetricsCollector) RecordHit(ctx context.Context, r *http.Request, duration time.Duration) {
+	if c == nil || c.OnHit == nil {
+		return
+	}
+	metric := RouteMetric{
+		Method:   r.Method,
+		Path:     r.URL.Path,
+		Duration: duration,
+		Params:   map[string]string{},
+	}
+	if rctx := RouteContext(ctx); rctx != nil {
+		metric.Pattern = rctx.RoutePattern()
+		for i, k := range rctx.URLParams.Keys {
+			if i < len(rctx.URLParams.Values) {
+				metric.Params[k] = rctx.URLParams.Values[i]
+			}
+		}
+	}
+	c.OnHit(metric)
+}
diff --git a/metrics_test.go b/metrics_test.go
new file mode 100644
index 0000000..a9966e9
--- /dev/null
+++ b/metrics_test.go
@@ -0,0 +1,42 @@
+package chi
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+)
+
+func TestMetricsCollector(t *testing.T) {
+	var got []RouteMetric
+	r := NewRouter()
+	r.SetMetricsCollector(&SimpleMetricsCollector{OnHit: func(m RouteMetric) {
+		got = append(got, m)
+	}})
+	r.Get("/users/{id}", func(w http.ResponseWriter, r *http.Request) {
+		time.Sleep(5 * time.Millisecond)
+		w.Write([]byte("ok"))
+	})
+
+	ts := httptest.NewServer(r)
+	defer ts.Close()
+
+	if _, body := testRequest(t, ts, "GET", "/users/123", nil); body != "ok" {
+		t.Fatalf("unexpected body %q", body)
+	}
+	testRequest(t, ts, "GET", "/missing", nil)
+
+	if len(got) != 1 {
+		t.Fatalf("expected 1 metric, got %d", len(got))
+	}
+	m := got[0]
+	if m.Pattern != "/users/{id}" || m.Method != "GET" || m.Path != "/users/123" {
+		t.Fatalf("unexpected metric %+v", m)
+	}
+	if m.Params["id"] != "123" {
+		t.Fatalf("expected id param 123, got %v", m.Params)
+	}
+	if m.Duration < 5*time.Millisecond {
+		t.Fatalf("duration too short: %v", m.Duration)
+	}
+}
