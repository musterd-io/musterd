+    def shell_complete(self, ctx: Context, incomplete: str) -> list[CompletionItem]:
+        """Return a list of completions for the incomplete value. A
+        custom ``shell_complete`` callback takes precedence. Otherwise,
+        if ``auto_complete`` is enabled, smart context-based completion
+        is used, falling back to the type's completion.
+        """
+        if self._custom_shell_complete is None and self.auto_complete:
+            return self._smart_complete(ctx, incomplete)
+
+        return super().shell_complete(ctx, incomplete)
+
+    def _smart_complete(self, ctx: Context, incomplete: str) -> list[CompletionItem]:
+        """Determine a completion strategy from the option's name, type,
+        and execution context, and return matching completions.
+        """
+        from click.shell_completion import CompletionItem
+
+        # Explicit type-based completion (Choice, Path, File, ...) wins.
+        if isinstance(self.type, (types.Choice, types.Path, types.File)):
+            return self.type.shell_complete(ctx, self, incomplete)
+
+        names = [self.name or ""]
+        names.extend(opt.lstrip("-") for opt in self.opts)
+        names = [n.lower().replace("-", "_") for n in names if n]
+
+        for patterns, completer in _SMART_COMPLETION_REGISTRY:
+            if any(n in patterns for n in names):
+                results = completer(ctx, self, incomplete)
+
+                if results and isinstance(results[0], str):
+                    results = [CompletionItem(c) for c in results]
+
+                return t.cast("list[CompletionItem]", results)
+
+        return self.type.shell_complete(ctx, self, incomplete)
+
