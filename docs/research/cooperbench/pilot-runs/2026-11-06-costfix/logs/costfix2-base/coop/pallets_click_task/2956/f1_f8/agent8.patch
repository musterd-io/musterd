+        t.Callable[[Context, Parameter, str], list[t.Any]],
+    ]
+] = [
+    (frozenset({"user", "username", "owner"}), _complete_usernames),
+    (frozenset({"branch", "git_branch", "ref"}), _complete_git_branches),
+    (frozenset({"env", "envvar", "env_var", "environment"}), _complete_env_vars),
+    (frozenset({"dir", "directory", "folder"}), _complete_dirs),
+    (frozenset({"file", "filename", "path", "filepath"}), _complete_paths),
+]
