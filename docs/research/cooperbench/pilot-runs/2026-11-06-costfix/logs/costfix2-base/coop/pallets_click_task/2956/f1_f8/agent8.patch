+def _complete_usernames(
+    ctx: Context, param: Parameter, incomplete: str
+) -> list[str]:
+    names: list[str] = []
+
+    try:
+        import pwd
+
+        names = [p.pw_name for p in pwd.getpwall()]
+    except Exception:
+        user = os.environ.get("USER") or os.environ.get("USERNAME")
+
+        if user:
+            names = [user]
+
+    return sorted({n for n in names if n.startswith(incomplete)})
+
+
+def _complete_git_branches(
+    ctx: Context, param: Parameter, incomplete: str
+) -> list[str]:
+    import subprocess
+
+    try:
+        output = subprocess.run(
+            ["git", "branch", "-a", "--format=%(refname:short)"],
+            capture_output=True,
+            text=True,
+            timeout=5,
+            check=True,
+        ).stdout
+    except Exception:
+        return []
+
+    branches = [line.strip() for line in output.splitlines() if line.strip()]
+    return [b for b in branches if b.startswith(incomplete)]
+
+
+def _complete_env_vars(
+    ctx: Context, param: Parameter, incomplete: str
+) -> list[str]:
+    return sorted(k for k in os.environ if k.startswith(incomplete))
+
+
+def _complete_paths(
+    ctx: Context, param: Parameter, incomplete: str
+) -> list[CompletionItem]:
+    from click.shell_completion import CompletionItem
+
+    return [CompletionItem(incomplete, type="file")]
+
+
+def _complete_dirs(
+    ctx: Context, param: Parameter, incomplete: str
+) -> list[CompletionItem]:
+    from click.shell_completion import CompletionItem
+
+    return [CompletionItem(incomplete, type="dir")]
+
+
+#: Maps option name patterns to smart completion functions, used by
