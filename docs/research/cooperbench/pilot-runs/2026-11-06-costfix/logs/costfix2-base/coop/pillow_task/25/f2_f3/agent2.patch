+    def test_dry_run(self, tmp_path: Path) -> None:
+        temp_file = tmp_path / "temp.png"
+        im = hopper()
+        im.save(temp_file, dry_run=True)
+        assert not os.path.exists(temp_file)
+
+        im = Image.new("CMYK", (10, 10))
+        with pytest.raises(OSError):
+            im.save(tmp_path / "temp.png", dry_run=True)
+        assert not os.path.exists(tmp_path / "temp.png")
+
+    def test_save_preserve_readonly(self, tmp_path: Path) -> None:
+        data = bytearray(b"\xff")
+        im = Image.frombuffer("L", (1, 1), data, "raw", "L", 0, 1)
+        assert im.readonly
+
+        im.save(tmp_path / "temp.bmp", preserve_readonly=True)
+        assert im.readonly
+        data[0] = 64
+        assert im.getpixel((0, 0)) == 64
+
+        im.save(tmp_path / "temp2.bmp")
+        assert not im.readonly
+        data[0] = 128
+        assert im.getpixel((0, 0)) == 64
+
     def test_internals(self) -> None:
         im = Image.new("L", (100, 100))
         im.readonly = 1
