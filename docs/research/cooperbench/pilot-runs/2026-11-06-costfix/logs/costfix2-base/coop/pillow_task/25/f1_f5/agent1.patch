diff --git a/Tests/test_image.py b/Tests/test_image.py
index c2e850c36..29a27791f 100644
--- a/Tests/test_image.py
+++ b/Tests/test_image.py
@@ -1180,3 +1180,32 @@ class TestRegistry:
     def test_encode_registry_fail(self) -> None:
         with pytest.raises(OSError):
             Image._getencoder("RGB", "DoesNotExist", ("args",), extra=("extra",))
+
+
+@pytest.mark.parametrize("mode", ("RGB", "RGBA", "L", "P"))
+def test_save_mark_corners(mode: str, tmp_path: Path) -> None:
+    im = Image.new(mode, (10, 8), "white")
+    out = tmp_path / "temp.png"
+    im.save(out, mark_corners=True)
+
+    # The original image is not modified
+    assert im.getpixel((0, 0)) == im.getpixel((5, 5))
+
+    with Image.open(out) as reloaded:
+        rgb = reloaded.convert("RGB")
+        assert rgb.getpixel((0, 0))[0] > 50
+        if mode != "L":
+            assert rgb.getpixel((0, 0)) == (255, 0, 0)
+            assert rgb.getpixel((9, 7)) == (255, 0, 0)
+        assert rgb.getpixel((5, 5)) != rgb.getpixel((0, 0))
+
+
+def test_save_mark_corners_file_object() -> None:
+    im = Image.new("RGB", (4, 4), "blue")
+    b = io.BytesIO()
+    im.save(b, "PNG", mark_corners=True)
+    b.seek(0)
+    with Image.open(b) as reloaded:
+        assert reloaded.getpixel((0, 0)) == (255, 0, 0)
+        assert reloaded.getpixel((3, 3)) == (255, 0, 0)
+        assert reloaded.getpixel((1, 1)) == (0, 0, 255)
