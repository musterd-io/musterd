diff --git a/cors.go b/cors.go
new file mode 100644
index 0000000..e4df9a2
--- /dev/null
+++ b/cors.go
@@ -0,0 +1,154 @@
+package chi
+
+import (
+	"net/http"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// CORSOptions represents configuration for CORS middleware.
+type CORSOptions struct {
+	// AllowOrigin is the value of the Access-Control-Allow-Origin header.
+	AllowOrigin string
+
+	// AllowMethods lists the methods sent in Access-Control-Allow-Methods.
+	// When empty, the methods are detected from the routing tree.
+	AllowMethods []string
+
+	// AllowHeaders lists the headers sent in Access-Control-Allow-Headers.
+	AllowHeaders []string
+
+	// ExposeHeaders lists the headers sent in Access-Control-Expose-Headers.
+	ExposeHeaders []string
+
+	// MaxAge is the duration in seconds a preflight response may be cached.
+	MaxAge int
+
+	// AllowCredentials sets Access-Control-Allow-Credentials to true.
+	AllowCredentials bool
+}
+
+// DefaultCORSOptions returns the default CORS options.
+func DefaultCORSOptions() CORSOptions {
+	return CORSOptions{
+		AllowOrigin:  "*",
+		AllowHeaders: []string{"Accept", "Authorization", "Content-Type", "X-CSRF-Token"},
+		MaxAge:       3600,
+	}
+}
+
+// CORS returns a middleware that sets CORS headers on responses and answers
+// preflight OPTIONS requests with a 204 No Content.
+func CORS(options ...CORSOptions) func(http.Handler) http.Handler {
+	opts := DefaultCORSOptions()
+	if len(options) > 0 {
+		opts = options[0]
+	}
+
+	return func(next http.Handler) http.Handler {
+		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			setCORSHeaders(w, opts)
+
+			if r.Method == http.MethodOptions {
+				setCORSPreflightHeaders(w, r, opts)
+				w.WriteHeader(http.StatusNoContent)
+				return
+			}
+
+			next.ServeHTTP(w, r)
+		})
+	}
+}
+
+// EnableCORS adds CORS middleware with default options to the router.
+func (mx *Mux) EnableCORS() {
+	mx.EnableCORSWithOptions(DefaultCORSOptions())
+}
+
+// EnableCORSWithOptions adds CORS middleware with custom options to the router.
+func (mx *Mux) EnableCORSWithOptions(options CORSOptions) {
+	mx.Use(CORS(options))
+
+	// Answer preflight requests that reach the router as method-not-allowed,
+	// and report the allowed methods for any other 405.
+	mx.MethodNotAllowed(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == http.MethodOptions {
+			setCORSHeaders(w, options)
+			setCORSPreflightHeaders(w, r, options)
+			w.WriteHeader(http.StatusNoContent)
+			return
+		}
+		if methods := routeMethods(r); len(methods) > 0 {
+			w.Header().Set("Allow", strings.Join(methods, ", "))
+		}
+		w.WriteHeader(http.StatusMethodNotAllowed)
+	})
+}
+
+// WithCORS creates a new route group with CORS enabled.
+func (mx *Mux) WithCORS(fn func(r Router)) Router {
+	return mx.Group(func(r Router) {
+		r.Use(CORS())
+		if fn != nil {
+			fn(r)
+		}
+	})
+}
+
+func setCORSHeaders(w http.ResponseWriter, opts CORSOptions) {
+	origin := opts.AllowOrigin
+	if origin == "" {
+		origin = "*"
+	}
+	w.Header().Set("Access-Control-Allow-Origin", origin)
+	if opts.AllowCredentials {
+		w.Header().Set("Access-Control-Allow-Credentials", "true")
+	}
+	if len(opts.ExposeHeaders) > 0 {
+		w.Header().Set("Access-Control-Expose-Headers", strings.Join(opts.ExposeHeaders, ", "))
+	}
+}
+
+func setCORSPreflightHeaders(w http.ResponseWriter, r *http.Request, opts CORSOptions) {
+	methods := opts.AllowMethods
+	if len(methods) == 0 {
+		methods = routeMethods(r)
+	}
+	if len(methods) == 0 {
+		methods = []string{"GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"}
+	}
+	w.Header().Set("Access-Control-Allow-Methods", strings.Join(methods, ", "))
+	if len(opts.AllowHeaders) > 0 {
+		w.Header().Set("Access-Control-Allow-Headers", strings.Join(opts.AllowHeaders, ", "))
+	}
+	if opts.MaxAge > 0 {
+		w.Header().Set("Access-Control-Max-Age", strconv.Itoa(opts.MaxAge))
+	}
+}
+
+// routeMethods returns the methods routable for the request path, found by
+// matching each known method against the routing tree.
+func routeMethods(r *http.Request) []string {
+	rctx := RouteContext(r.Context())
+	if rctx == nil || rctx.Routes == nil {
+		return nil
+	}
+	path := r.URL.RawPath
+	if path == "" {
+		path = r.URL.Path
+	}
+	if path == "" {
+		path = "/"
+	}
+
+	var methods []string
+	for _, mt := range methodMap {
+		name := GetMethodName(mt)
+		if rctx.Routes.Match(NewRouteContext(), name, path) {
+			methods = append(methods, name)
+		}
+	}
+	sort.Strings(methods)
+	return methods
+}
diff --git a/middleware/allowed_methods.go b/middleware/allowed_methods.go
new file mode 100644
index 0000000..86fbbdf
--- /dev/null
+++ b/middleware/allowed_methods.go
@@ -0,0 +1,51 @@
+package middleware
+
+import (
+	"net/http"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// SetAllowHeader adds the Allow header for 405 responses based on
+// registered methods for the requested path.
+//
+// This middleware is useful when the router is configured with a custom
+// MethodNotAllowed handler, or for other routers that do not set the Allow
+// header themselves.
+func SetAllowHeader(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		rctx := chi.RouteContext(r.Context())
+		if rctx == nil || rctx.Routes == nil {
+			next.ServeHTTP(w, r)
+			return
+		}
+
+		url := r.URL.RawPath
+		if url == "" {
+			url = r.URL.Path
+		}
+
+		if rctx.Routes.Match(chi.NewRouteContext(), r.Method, url) {
+			next.ServeHTTP(w, r)
+			return
+		}
+
+		for _, m := range []string{
+			http.MethodGet,
+			http.MethodHead,
+			http.MethodPost,
+			http.MethodPut,
+			http.MethodPatch,
+			http.MethodDelete,
+			http.MethodConnect,
+			http.MethodOptions,
+			http.MethodTrace,
+		} {
+			if rctx.Routes.Match(chi.NewRouteContext(), m, url) {
+				w.Header().Add("Allow", m)
+			}
+		}
+
+		next.ServeHTTP(w, r)
+	})
+}
