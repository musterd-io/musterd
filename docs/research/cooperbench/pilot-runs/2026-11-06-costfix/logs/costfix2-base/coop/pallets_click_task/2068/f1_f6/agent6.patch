+        priority = self.process_priority
+
+        if priority is None:
+            return {}
+
+        if WIN:
+            import subprocess
+
+            flag = getattr(subprocess, _WIN_PRIORITY_CLASSES[priority], None)
+
+            if flag is None:
+                return {}
+
