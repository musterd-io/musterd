+/// Extracts `count` grapheme clusters from the start or end of a string.
+fn take_graphemes(s: &str, count: i64, from_end: bool) -> StrResult<Value> {
+    if count < 1 {
+        bail!("count must be at least 1");
+    }
+    let graphemes: Vec<&str> = s.graphemes(true).collect();
+    let len = graphemes.len();
+    let n = usize::try_from(count).unwrap_or(usize::MAX);
+    if n > len {
+        bail!("not enough characters (requested {count}, but string only has {len})");
+    }
+    let slice = if from_end { &graphemes[len - n..] } else { &graphemes[..n] };
+    Ok(Value::Array(slice.iter().map(|&g| Value::Str(g.into())).collect()))
+}
