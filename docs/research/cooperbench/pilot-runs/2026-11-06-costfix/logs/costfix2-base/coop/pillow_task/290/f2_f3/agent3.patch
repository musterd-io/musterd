+    def _sort_palette(self, sort_palette):
+        from . import ImagePalette
+
+        if sort_palette == "brightness":
+
+            def key(color):
+                return color[0] * 299 + color[1] * 587 + color[2] * 114
+
+        elif sort_palette == "rgb":
+
+            def key(color):
+                return tuple(color[:3])
+
+        elif callable(sort_palette):
+            key = sort_palette
+        else:
+            raise ValueError(f"unknown sort_palette value: {sort_palette!r}")
+
+        mode = self.palette.mode
+        channels = len(mode)
+        palette_bytes = bytes(self.palette.palette)
+        entries = [
+            tuple(palette_bytes[i : i + channels])
+            for i in range(0, len(palette_bytes) - channels + 1, channels)
+        ]
+        # only sort the entries that are in use, leaving any padding at the end
+        used = min(self.getextrema()[1] + 1, len(entries))
+        # sorted() is stable, so equal keys keep their original order
+        order = sorted(range(used), key=lambda i: key(entries[i]))
+        order += range(used, len(entries))
+
+        new_positions = list(range(256))
+        for new_index, old_index in enumerate(order):
+            new_positions[old_index] = new_index
+
