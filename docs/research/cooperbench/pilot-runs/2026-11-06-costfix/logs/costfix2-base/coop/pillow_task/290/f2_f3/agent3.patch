@@ -85,3 +85,65 @@ def test_transparent_colors_equal():
     converted = im.quantize()
     converted_px = converted.load()
     assert converted_px[0, 0] == converted_px[0, 1]
+
+
+def test_max_colors():
+    image = hopper()
+    converted = image.quantize(colors=100, max_colors=50)
+    assert converted.mode == "P"
+    assert len(converted.getcolors()) <= 50
+
+    converted = image.quantize(colors=20, max_colors=50)
+    assert len(converted.getcolors()) <= 20
+
+    # Default behaviour is unchanged
+    assert image.quantize(colors=100).tobytes() == image.quantize(
+        colors=100, max_colors=100
+    ).tobytes()
+
+
+def test_max_colors_invalid():
+    image = hopper()
+    with pytest.raises(ValueError):
+        image.quantize(colors=100, max_colors=0)
+    with pytest.raises(ValueError):
+        image.quantize(colors=100, max_colors=257)
+
+
+@pytest.mark.parametrize("sort_palette", ("brightness", "rgb"))
+def test_sort_palette(sort_palette):
+    image = hopper()
+    unsorted = image.quantize(colors=16)
+    converted = image.quantize(colors=16, sort_palette=sort_palette)
+    assert converted.mode == "P"
+
+    # Pixels still map to the same colors
+    assert converted.convert("RGB").tobytes() == unsorted.convert("RGB").tobytes()
+
+    palette = converted.getpalette()[: 16 * 3]
+    colors = [tuple(palette[i : i + 3]) for i in range(0, len(palette), 3)]
+    if sort_palette == "brightness":
+        keys = [r * 299 + g * 587 + b * 114 for r, g, b in colors]
+    else:
+        keys = colors
+    assert keys == sorted(keys)
+
+
+def test_sort_palette_callable():
+    image = hopper()
+    converted = image.quantize(colors=16, sort_palette=lambda color: -color[0])
+    palette = converted.getpalette()[: 16 * 3]
+    reds = palette[::3]
+    assert reds == sorted(reds, reverse=True)
+
+
+def test_sort_palette_rgba():
+    image = hopper("RGBA")
+    unsorted = image.quantize(colors=16)
+    converted = image.quantize(colors=16, sort_palette="brightness")
+    assert converted.convert("RGBA").tobytes() == unsorted.convert("RGBA").tobytes()
+
+
+def test_sort_palette_invalid():
+    with pytest.raises(ValueError):
+        hopper().quantize(sort_palette="unknown")
