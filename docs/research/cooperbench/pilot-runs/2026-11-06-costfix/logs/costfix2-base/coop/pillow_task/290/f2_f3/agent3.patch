+        im.frombytes(self.tobytes().translate(bytes(new_positions)))
+        new_palette = b"".join(bytes(entries[i]) for i in order)
+        im.im.putpalette("RGB", b"".join(bytes(entries[i][:3]) for i in order))
+        if mode == "RGBA":
