+def _monitor_search_paths(
+    loader_ref: "weakref.ref[FileSystemLoader]",
+    stop: threading.Event,
+    interval: float,
+) -> None:
+    """Poll a loader's search paths and invalidate cached templates when
+    files are modified, deleted, or added. Only a weak reference to the
+    loader is held, so the thread exits once the loader is collected or
+    no environments are tracked anymore.
+    """
+    loader = loader_ref()
+
+    if loader is None:
+        return
+
+    snapshot = loader._scan_search_paths()
+    del loader
+
+    while not stop.wait(interval):
+        loader = loader_ref()
+
+        if loader is None or not loader._environments:
+            return
+
+        try:
+            current = loader._scan_search_paths()
+            changed = [
+                path
+                for path in snapshot.keys() | current.keys()
+                if snapshot.get(path) != current.get(path)
+            ]
+            snapshot = current
+
+            if changed:
+                loader._on_template_changed(changed)
+        except Exception:
+            pass
+
+        del loader
