+    def _mark_corners(self) -> None:
+        """Set the top-left and bottom-right pixels to red."""
+        if self.width == 0 or self.height == 0:
+            return
+        from . import ImageColor
+
+        self._ensure_mutable()
+        red: float | tuple[int, ...]
+        if self.mode == "P":
+            red = (255, 0, 0)
+        elif self.mode == "PA":
+            red = (255, 0, 0, 255)
+        elif self.mode == "CMYK":
+            red = (0, 255, 255, 0)
+        else:
+            red = ImageColor.getcolor("red", self.mode)
+        self.putpixel((0, 0), red)
+        self.putpixel((self.width - 1, self.height - 1), red)
