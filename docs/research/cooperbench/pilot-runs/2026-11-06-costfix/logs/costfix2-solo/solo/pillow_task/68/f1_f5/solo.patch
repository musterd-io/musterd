diff --git a/Tests/test_imageops.py b/Tests/test_imageops.py
index 3621aa50f..ea8f782ed 100644
--- a/Tests/test_imageops.py
+++ b/Tests/test_imageops.py
@@ -580,3 +580,29 @@ def test_autocontrast_preserve_one_color(color: tuple[int, int, int]) -> None:
         img, cutoff=10, preserve_tone=True
     )  # single color 10 cutoff
     assert_image_equal(img, out)
+
+
+def test_exif_transpose_with_xmp_tuple() -> None:
+    with Image.open("Tests/images/xmp_tags_orientation.png") as im:
+        assert im.getexif()[0x0112] == 3
+
+        im.info["xmp"] = (b"test",)
+        transposed_im = ImageOps.exif_transpose(im)
+        assert 0x0112 not in transposed_im.getexif()
+
+
+def test_exif_transpose_logger() -> None:
+    messages: list[str] = []
+    with Image.open("Tests/images/xmp_tags_orientation.png") as im:
+        ImageOps.exif_transpose(im, logger=messages.append)
+    assert any("ROTATE_180" in m for m in messages)
+    assert any("Orientation" in m for m in messages)
+
+
+def test_exif_transpose_standard_logger(caplog: pytest.LogCaptureFixture) -> None:
+    import logging
+
+    caplog.set_level(logging.DEBUG, logger="test_exif_transpose")
+    with Image.open("Tests/images/xmp_tags_orientation.png") as im:
+        ImageOps.exif_transpose(im, logger=logging.getLogger("test_exif_transpose"))
+    assert "ROTATE_180" in caplog.text
