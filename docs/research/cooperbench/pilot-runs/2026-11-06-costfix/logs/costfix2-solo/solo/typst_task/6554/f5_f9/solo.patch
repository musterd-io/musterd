+/// Takes `n` graphemes from the start or end of a list as an array value.
+fn take_graphemes(graphemes: &[&str], n: usize, from_end: bool) -> StrResult<Value> {
+    if n == 0 {
+        bail!("count must be at least 1");
+    }
+    if n > graphemes.len() {
+        bail!(
+            "not enough characters (requested {}, but string only has {})",
+            n,
+            graphemes.len()
+        );
+    }
+    let slice = if from_end {
+        &graphemes[graphemes.len() - n..]
+    } else {
+        &graphemes[..n]
+    };
+    Ok(Value::Array(slice.iter().map(|&g| Value::Str(g.into())).collect()))
+}
