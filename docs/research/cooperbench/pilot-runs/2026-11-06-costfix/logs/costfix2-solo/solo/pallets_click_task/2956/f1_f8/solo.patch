 UUID = UUIDParameterType()
 
 
+def _smart_complete_users(incomplete: str) -> list[CompletionItem]:
+    from click.shell_completion import CompletionItem
+
+    names: list[str] = []
+
+    try:
+        import pwd
+
+        names = [p.pw_name for p in pwd.getpwall()]
+    except (ImportError, OSError):
+        for key in ("USER", "USERNAME", "LOGNAME"):
+            value = os.environ.get(key)
+
+            if value:
+                names.append(value)
+
+    return [
+        CompletionItem(n)
+        for n in sorted(set(names))
+        if n.startswith(incomplete)
+    ]
+
+
+def _smart_complete_git_branches(incomplete: str) -> list[CompletionItem]:
+    import subprocess
+
+    from click.shell_completion import CompletionItem
+
+    try:
+        result = subprocess.run(
+            ["git", "branch", "-a", "--format=%(refname:short)"],
+            capture_output=True,
+            text=True,
+            timeout=2,
+        )
+    except (OSError, subprocess.SubprocessError):
+        return []
+
+    if result.returncode != 0:
+        return []
+
+    branches = [
+        b.strip()
+        for b in result.stdout.splitlines()
+        if b.strip() and not b.strip().startswith("(")
+    ]
+    return [
+        CompletionItem(b)
+        for b in dict.fromkeys(branches)
+        if b.startswith(incomplete)
+    ]
+
+
+def _smart_complete_files(incomplete: str) -> list[CompletionItem]:
+    from click.shell_completion import CompletionItem
+
+    return [CompletionItem(incomplete, type="file")]
+
+
+def _smart_complete_dirs(incomplete: str) -> list[CompletionItem]:
+    from click.shell_completion import CompletionItem
+
+    return [CompletionItem(incomplete, type="dir")]
+
+
+def _smart_complete_envvars(incomplete: str) -> list[CompletionItem]:
+    from click.shell_completion import CompletionItem
+
+    return [CompletionItem(k) for k in sorted(os.environ) if k.startswith(incomplete)]
+
+
+#: Maps option name patterns to smart completion functions. Used by
+#: options with ``auto_complete=True``.
+_SMART_COMPLETION_REGISTRY: list[
+    tuple[frozenset[str], t.Callable[[str], list[CompletionItem]]]
+] = [
+    (frozenset({"user", "username", "owner"}), _smart_complete_users),
+    (frozenset({"branch", "git_branch"}), _smart_complete_git_branches),
+    (
+        frozenset({"file", "filename", "filepath", "path", "input", "output"}),
+        _smart_complete_files,
+    ),
+    (frozenset({"dir", "directory", "folder"}), _smart_complete_dirs),
+    (frozenset({"env", "envvar", "env_var"}), _smart_complete_envvars),
+]
+
+
+def get_smart_completer(
+    names: cabc.Iterable[str],
+) -> t.Callable[[str], list[CompletionItem]] | None:
+    """Find a smart completion function matching any of the given
+    option names, or ``None`` if no pattern matches.
+    """
+    names = list(names)
+
+    for patterns, completer in _SMART_COMPLETION_REGISTRY:
+        if any(n in patterns for n in names):
+            return completer
+
+    return None
+
+
