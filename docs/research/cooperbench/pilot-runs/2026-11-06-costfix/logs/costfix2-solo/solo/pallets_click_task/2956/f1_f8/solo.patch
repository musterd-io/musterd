+    def shell_complete(self, ctx: Context, incomplete: str) -> list[CompletionItem]:
+        """Return completions for the incomplete value. A custom
+        ``shell_complete`` callback takes precedence. Otherwise, if
+        ``auto_complete`` is enabled, smart context-based completion is
+        used before falling back to the type's completion.
+        """
+        if self._custom_shell_complete is None and self.auto_complete:
+            return self._smart_complete(ctx, incomplete)
+
+        return super().shell_complete(ctx, incomplete)
+
+    def _smart_complete(self, ctx: Context, incomplete: str) -> list[CompletionItem]:
+        """Choose a completion strategy based on the option's name,
+        type, and the current environment.
+        """
+        from click.shell_completion import CompletionItem
+
+        # Types with their own specific completion (choices, paths)
+        # already know best.
+        if isinstance(self.type, (types.Choice, types.Path, types.File)):
+            return self.type.shell_complete(ctx, self, incomplete)
+
+        names = [self.name or ""]
+        names.extend(o.lstrip("-").replace("-", "_") for o in self.opts)
+        names = [n.lower() for n in names if n]
+
+        completer = types.get_smart_completer(names)
+
+        if completer is not None:
+            return completer(incomplete)
+
+        return self.type.shell_complete(ctx, self, incomplete)
+
