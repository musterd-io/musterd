+/// Validates the `repeat` argument of `str.first` and `str.last`.
+fn check_repeat(repeat: i64) -> StrResult<usize> {
+    if repeat < 1 {
+        return Err("repeat must be at least 1".into());
+    }
+    Ok(usize::try_from(repeat).unwrap_or(usize::MAX))
+}
+
+/// The error message when a string has fewer characters than requested.
+#[cold]
+fn not_enough_characters(requested: usize, available: usize) -> EcoString {
+    eco_format!(
+        "not enough characters (requested {requested}, but string only has {available})"
+    )
+}
