+    def _quantize_error(self, quantized):
+        """Mean square error between this image and a quantized version."""
+        from . import ImageChops
+
+        mode = self.mode if self.mode in ("L", "RGB", "RGBA") else "RGB"
+        original = self if self.mode == mode else self.convert(mode)
+        diff = ImageChops.difference(original, quantized.convert(mode))
+        histogram = diff.histogram()
+        bands = len(mode)
+        total = sum((i % 256) ** 2 * count for i, count in enumerate(histogram))
+        pixels = diff.size[0] * diff.size[1] * bands
+        return total / pixels if pixels else 0
+
+    def _adjust_palette_lightness(self, factor):
+        from . import ImagePalette
+
+        mode = self.im.getpalettemode()
+        channels = len(mode)
+        data = bytearray(self.im.getpalette(mode, mode))
+        for i in range(len(data)):
+            # Leave the alpha channel unchanged
+            if mode == "RGBA" and i % channels == 3:
+                continue
+            data[i] = max(0, min(255, int(round(data[i] * factor))))
+        if mode == "RGBA":
+            self.im.putpalette("RGBX", bytes(data))
+            self.im.putpalettealphas(bytes(data[3::4]))
+        else:
+            self.im.putpalette(mode, bytes(data))
+        self.palette = ImagePalette.ImagePalette(mode, self.im.getpalette(mode, mode))
+
