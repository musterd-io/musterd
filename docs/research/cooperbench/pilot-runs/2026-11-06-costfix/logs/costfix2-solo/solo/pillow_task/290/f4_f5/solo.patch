@@ -85,3 +85,68 @@ def test_transparent_colors_equal():
     converted = im.quantize()
     converted_px = converted.load()
     assert converted_px[0, 0] == converted_px[0, 1]
+
+
+def test_quantize_error_threshold():
+    image = hopper()
+
+    # No threshold uses the requested number of colors
+    converted = image.quantize(64)
+    assert len(converted.getcolors()) == 64
+
+    # A loose threshold uses fewer colors
+    loose = image.quantize(64, error_threshold=1000)
+    assert len(loose.getcolors()) < 64
+    assert image._quantize_error(loose) <= 1000
+
+    # An unreachable threshold falls back to the maximum number of colors
+    strict = image.quantize(64, error_threshold=0)
+    assert len(strict.getcolors()) == 64
+
+
+def test_quantize_error_threshold_invalid():
+    with pytest.raises(ValueError):
+        hopper().quantize(error_threshold=-1)
+
+
+def test_quantize_lightness_factor():
+    image = hopper()
+    default = image.quantize(16)
+    unchanged = image.quantize(16, lightness_factor=1.0)
+    assert default.getpalette() == unchanged.getpalette()
+
+    brighter = image.quantize(16, lightness_factor=1.5)
+    darker = image.quantize(16, lightness_factor=0.5)
+    for d, b, k in zip(default.getpalette(), brighter.getpalette(),
+                       darker.getpalette()):
+        assert b == min(255, round(d * 1.5))
+        assert k == round(d * 0.5)
+
+
+def test_quantize_lightness_factor_clamped():
+    palette = hopper().quantize(16, lightness_factor=100).getpalette()
+    assert all(0 <= v <= 255 for v in palette)
+
+
+def test_quantize_lightness_factor_rgba_keeps_alpha():
+    image = hopper("RGBA")
+    default = image.quantize(16)
+    darker = image.quantize(16, lightness_factor=0.5)
+    assert default.im.getpalette("RGBA", "RGBA")[3::4] == darker.im.getpalette(
+        "RGBA", "RGBA"
+    )[3::4]
+
+
+def test_quantize_lightness_factor_with_palette():
+    image = hopper()
+    palette = image.quantize(8)
+    original = palette.getpalette()
+    brighter = image.quantize(palette=palette, lightness_factor=1.2)
+    assert palette.getpalette() == original
+    assert brighter.getpalette()[:3] == [min(255, round(v * 1.2)) for v in original[:3]]
+
+
+@pytest.mark.parametrize("factor", (0, -1))
+def test_quantize_lightness_factor_invalid(factor):
+    with pytest.raises(ValueError):
+        hopper().quantize(lightness_factor=factor)
