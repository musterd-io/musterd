+    def _priority_popen_kwargs(self) -> dict[str, t.Any]:
+        """Build extra ``Popen`` arguments to set the editor's process
+        priority. Returns an empty dict if no priority is requested or
+        the platform doesn't support it.
+        """
+        import subprocess
+
+        priority = self.process_priority
+
+        if priority is None:
+            return {}
+
+        if WIN:
+            flag = getattr(subprocess, _PRIORITY_WIN_CLASS[priority], None)
+
+            if flag is None:
+                return {}
+
+            return {"creationflags": flag}
+
+        if not hasattr(os, "nice"):
+            return {}
+
+        increment = _PRIORITY_NICE[priority]
+
+        if increment == 0:
+            return {}
+
+        def set_priority() -> None:
+            # Failing to change the priority (for example, raising it
+            # without privileges) must not prevent the editor launching.
+            try:
+                os.nice(increment)
+            except OSError:
+                pass
+
+        return {"preexec_fn": set_priority}
+
