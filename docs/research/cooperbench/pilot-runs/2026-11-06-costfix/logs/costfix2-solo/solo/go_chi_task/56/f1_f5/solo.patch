+// addMethodsAllowed records the methods registered on the given endpoints
+// into the routing context, keeping them sorted and free of duplicates.
+func (x *Context) addMethodsAllowed(eps endpoints) {
+	for mt, ep := range eps {
+		if ep == nil || ep.handler == nil {
+			continue
+		}
+		if _, ok := reverseMethodMap[mt]; !ok {
+			continue
+		}
+		i := sort.Search(len(x.methodsAllowed), func(i int) bool { return x.methodsAllowed[i] >= mt })
