+// EnableCORS enables CORS on the router using DefaultCORSOptions.
+func (mx *Mux) EnableCORS() {
+	mx.EnableCORSWithOptions(DefaultCORSOptions())
+}
+
+// EnableCORSWithOptions enables CORS on the router with the given options.
+// Preflight OPTIONS requests are answered with a 204 and the methods
+// available for the requested route.
+func (mx *Mux) EnableCORSWithOptions(options CORSOptions) {
+	mx.Use(CORS(options))
+	mx.MethodNotAllowed(corsMethodNotAllowed(options))
+}
+
+// WithCORS creates a new inline-Mux group with CORS enabled using
+// DefaultCORSOptions.
+func (mx *Mux) WithCORS(fn func(r Router)) Router {
+	options := DefaultCORSOptions()
+	im := mx.With(CORS(options)).(*Mux)
+	im.MethodNotAllowed(corsMethodNotAllowed(options))
+	if fn != nil {
+		fn(im)
+	}
+	return im
+}
