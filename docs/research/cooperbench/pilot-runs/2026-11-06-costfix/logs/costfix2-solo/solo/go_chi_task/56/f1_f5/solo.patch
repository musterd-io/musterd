index 0000000..6fd65c6
--- /dev/null
+++ b/cors.go
@@ -0,0 +1,154 @@
+package chi
+
+import (
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// CORSOptions configures the CORS middleware.
+type CORSOptions struct {
+	// AllowOrigin is the value of the Access-Control-Allow-Origin header.
+	AllowOrigin string
+
+	// AllowMethods lists the methods sent in Access-Control-Allow-Methods
+	// on preflight requests. When empty, the methods registered for the
+	// requested route are detected automatically.
+	AllowMethods []string
+
+	// AllowHeaders lists the headers sent in Access-Control-Allow-Headers.
+	AllowHeaders []string
+
+	// ExposeHeaders lists the headers sent in Access-Control-Expose-Headers.
+	ExposeHeaders []string
+
+	// MaxAge is how long the results of a preflight request can be cached.
+	MaxAge time.Duration
+
+	// AllowCredentials sets Access-Control-Allow-Credentials to true.
+	AllowCredentials bool
+}
+
+// DefaultCORSOptions returns a permissive set of CORS options.
+func DefaultCORSOptions() CORSOptions {
+	return CORSOptions{
+		AllowOrigin:  "*",
+		AllowHeaders: []string{"Accept", "Authorization", "Content-Type", "X-CSRF-Token"},
+		MaxAge:       time.Hour,
+	}
+}
+
+// corsMethods are the methods probed when detecting the methods
+// available for a route.
+var corsMethods = []string{
+	http.MethodGet,
+	http.MethodHead,
+	http.MethodPost,
+	http.MethodPut,
+	http.MethodPatch,
+	http.MethodDelete,
+	http.MethodOptions,
+}
+
+// CORS returns a middleware that sets CORS headers on responses and
+// answers preflight OPTIONS requests with a 204.
+func CORS(options CORSOptions) func(http.Handler) http.Handler {
+	return func(next http.Handler) http.Handler {
+		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			setCORSHeaders(w, options)
+			if r.Method == http.MethodOptions {
+				preflight(w, r, options, detectMethods(r))
+				return
+			}
+			next.ServeHTTP(w, r)
+		})
+	}
+}
+
+// corsMethodNotAllowed returns a 405 handler which answers preflight
+// requests that reach it (eg. within inline groups) and otherwise responds
+// with a 405 including the Allow header.
+func corsMethodNotAllowed(options CORSOptions) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		var allowed []string
+		if rctx := RouteContext(r.Context()); rctx != nil {
+			for _, m := range rctx.methodsAllowed {
+				if name := GetMethodName(m); name != "" {
+					allowed = append(allowed, name)
+				}
+			}
+		}
+		if r.Method == http.MethodOptions {
+			setCORSHeaders(w, options)
+			preflight(w, r, options, allowed)
+			return
+		}
+		for _, m := range allowed {
+			w.Header().Add("Allow", m)
+		}
+		w.WriteHeader(http.StatusMethodNotAllowed)
+	}
+}
+
+func setCORSHeaders(w http.ResponseWriter, options CORSOptions) {
+	h := w.Header()
+	origin := options.AllowOrigin
+	if origin == "" {
+		origin = "*"
+	}
+	h.Set("Access-Control-Allow-Origin", origin)
+	if origin != "*" {
+		h.Add("Vary", "Origin")
+	}
+	if options.AllowCredentials {
+		h.Set("Access-Control-Allow-Credentials", "true")
+	}
+	if len(options.ExposeHeaders) > 0 {
+		h.Set("Access-Control-Expose-Headers", strings.Join(options.ExposeHeaders, ", "))
+	}
+}
+
+func preflight(w http.ResponseWriter, r *http.Request, options CORSOptions, detected []string) {
+	h := w.Header()
+	methods := options.AllowMethods
+	if len(methods) == 0 {
+		methods = detected
+	}
+	if len(methods) == 0 {
+		methods = corsMethods
+	}
+	h.Set("Access-Control-Allow-Methods", strings.Join(methods, ", "))
+	if len(options.AllowHeaders) > 0 {
+		h.Set("Access-Control-Allow-Headers", strings.Join(options.AllowHeaders, ", "))
+	} else if reqHeaders := r.Header.Get("Access-Control-Request-Headers"); reqHeaders != "" {
+		h.Set("Access-Control-Allow-Headers", reqHeaders)
+	}
+	if options.MaxAge > 0 {
+		h.Set("Access-Control-Max-Age", strconv.Itoa(int(options.MaxAge/time.Second)))
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+// detectMethods returns the methods available for the request path on the
+// router found in the request routing context.
+func detectMethods(r *http.Request) []string {
+	rctx := RouteContext(r.Context())
+	if rctx == nil || rctx.Routes == nil {
+		return nil
+	}
+	path := rctx.RoutePath
+	if path == "" {
+		path = r.URL.RawPath
+		if path == "" {
+			path = r.URL.Path
+		}
+	}
+	var methods []string
+	for _, m := range corsMethods {
+		if rctx.Routes.Match(NewRouteContext(), m, path) {
+			methods = append(methods, m)
+		}
+	}
+	return methods
+}
diff --git a/middleware/allowed_methods.go b/middleware/allowed_methods.go
new file mode 100644
index 0000000..e87e9bd
--- /dev/null
+++ b/middleware/allowed_methods.go
@@ -0,0 +1,50 @@
+package middleware
+
+import (
+	"net/http"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// SetAllowHeader adds the Allow header for 405 responses based on
+// registered methods for the requested path.
+//
+// This middleware is a no-op on requests whose method matches a route.
+func SetAllowHeader(next http.Handler) http.Handler {
+	fn := func(w http.ResponseWriter, r *http.Request) {
+		rctx := chi.RouteContext(r.Context())
+		if rctx == nil || rctx.Routes == nil {
+			next.ServeHTTP(w, r)
+			return
+		}
+
+		url := r.URL.RawPath
+		if url == "" {
+			url = r.URL.Path
+		}
+
+		if rctx.Routes.Match(chi.NewRouteContext(), r.Method, url) {
+			next.ServeHTTP(w, r)
+			return
+		}
+
+		for _, method := range []string{
+			http.MethodGet,
+			http.MethodHead,
+			http.MethodPost,
+			http.MethodPut,
+			http.MethodPatch,
+			http.MethodDelete,
+			http.MethodConnect,
+			http.MethodOptions,
+			http.MethodTrace,
+		} {
+			if rctx.Routes.Match(chi.NewRouteContext(), method, url) {
+				w.Header().Add("Allow", method)
+			}
+		}
+
+		next.ServeHTTP(w, r)
+	}
+	return http.HandlerFunc(fn)
+}
