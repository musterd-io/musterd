+    def _adjust_quantized_palette(self, colors, sort_palette, lightness_factor):
+        if sort_palette is None and lightness_factor == 1:
+            return self
+
+        from . import ImagePalette
+
+        mode = self.palette.mode
+        channels = len(mode)
+        data = bytes(self.palette.tobytes())
+        entries = [
+            tuple(data[i : i + channels]) for i in range(0, len(data), channels)
+        ]
+        if len(entries[-1]) != channels:
+            entries.pop()
+
+        if sort_palette is not None:
+            count = len(entries) if colors is None else min(colors, len(entries))
+            if sort_palette == "brightness":
+
+                def key(i):
+                    r, g, b = entries[i][:3]
+                    return 0.299 * r + 0.587 * g + 0.114 * b
+
+            else:
+
+                def key(i):
+                    return entries[i][:3]
+
+            order = sorted(range(count), key=key)
+            order += range(count, len(entries))
+
+            # remap pixel values so they point to the new palette positions
+            lut = list(range(256))
+            for new_index, old_index in enumerate(order):
+                lut[old_index] = new_index
+            im = self._new(self.im.point(lut, None))
+            entries = [entries[i] for i in order]
+        else:
+            im = self.copy()
+
+        if lightness_factor != 1:
+            entries = [
+                tuple(
+                    min(255, max(0, int(round(v * lightness_factor))))
+                    for v in entry[:3]
+                )
+                + entry[3:]
+                for entry in entries
+            ]
+
+        palette_bytes = bytes(v for entry in entries for v in entry)
+        im.palette = ImagePalette.ImagePalette(mode, palette_bytes)
+        im.im.putpalette("RGB", bytes(v for entry in entries for v in entry[:3]))
+        if mode == "RGBA":
+            im.im.putpalettealphas(bytes(entry[3] for entry in entries))
         return im
 
