+
+
+def _palette_entries(im, count):
+    palette = im.getpalette()[: count * 3]
+    return [tuple(palette[i : i + 3]) for i in range(0, len(palette), 3)]
+
+
+@pytest.mark.parametrize("sort_palette", ("brightness", "rgb"))
+def test_quantize_sort_palette(sort_palette):
+    image = hopper()
+    unsorted = image.quantize(8)
+    converted = image.quantize(8, sort_palette=sort_palette)
+    assert_image_equal(converted.convert("RGB"), unsorted.convert("RGB"))
+
+    entries = _palette_entries(converted, 8)
+    assert sorted(entries) == sorted(_palette_entries(unsorted, 8))
+    if sort_palette == "rgb":
+        assert entries == sorted(entries)
+    else:
+        brightness = [0.299 * r + 0.587 * g + 0.114 * b for r, g, b in entries]
+        assert brightness == sorted(brightness)
+
+
+def test_quantize_sort_palette_rgba():
+    image = hopper("RGBA")
+    unsorted = image.quantize(8)
+    converted = image.quantize(8, sort_palette="rgb")
+    assert_image_equal(converted.convert("RGBA"), unsorted.convert("RGBA"))
+
+
+def test_quantize_sort_palette_invalid():
+    with pytest.raises(ValueError):
+        hopper().quantize(8, sort_palette="invalid")
+
+
+@pytest.mark.parametrize("factor", (0.5, 1.2, 10))
+def test_quantize_lightness_factor(factor):
+    image = hopper()
+    original = _palette_entries(image.quantize(8), 8)
+    adjusted = _palette_entries(image.quantize(8, lightness_factor=factor), 8)
+    for orig, adj in zip(original, adjusted):
+        for o, a in zip(orig, adj):
+            assert a == min(255, max(0, round(o * factor)))
+
+
+@pytest.mark.parametrize("factor", (0, -1))
+def test_quantize_lightness_factor_invalid(factor):
+    with pytest.raises(ValueError):
+        hopper().quantize(8, lightness_factor=factor)
