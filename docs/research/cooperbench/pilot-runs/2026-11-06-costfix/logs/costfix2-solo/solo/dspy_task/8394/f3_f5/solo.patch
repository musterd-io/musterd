+# On-disk blob format: b"DSPC" + 1 codec byte + payload (possibly compressed pickle).
+_MISSING = object()
+_MAGIC = b"DSPC"
+_CODEC_NONE = 0x00
+_CODEC_GZIP = 0x01
+_CODEC_ZLIB = 0x02
+_CODEC_TO_BYTE = {None: _CODEC_NONE, "gzip": _CODEC_GZIP, "zlib": _CODEC_ZLIB}
+
+
+def _validate_codec(codec: Optional[str]) -> None:
+    if codec not in _CODEC_TO_BYTE:
+        raise ValueError(f"Unsupported compression codec: {codec!r}. Expected one of 'gzip', 'zlib', or None.")
+
+
+def _encode(value: Any, codec: Optional[str]) -> bytes:
+    """Serialize `value` into a magic-header-prefixed (optionally compressed) pickle."""
+    _validate_codec(codec)
+    payload = cloudpickle.dumps(value)
+    if codec == "gzip":
+        payload = gzip.compress(payload)
+    elif codec == "zlib":
+        payload = zlib.compress(payload)
+    return _MAGIC + bytes([_CODEC_TO_BYTE[codec]]) + payload
+
+
+def _decode(blob: Any) -> Any:
+    """Decode a value read from disk. Header-less values are treated as legacy entries."""
+    if isinstance(blob, (bytes, bytearray, memoryview)):
+        data = bytes(blob)
+        if data[:4] == _MAGIC and len(data) >= 5:
+            codec = data[4]
+            payload = data[5:]
+            if codec == _CODEC_GZIP:
+                payload = gzip.decompress(payload)
+            elif codec == _CODEC_ZLIB:
+                payload = zlib.decompress(payload)
+            elif codec != _CODEC_NONE:
+                raise ValueError(f"Unknown DSPy cache codec byte: {codec}")
+            return pickle.loads(payload)
+        # Legacy raw pickle bytes.
+        try:
+            return pickle.loads(data)
+        except Exception:
+            return blob
+    # Legacy entry already unpickled by DiskCache.
+    return blob
+
 
