+/// A character class used by `str.first` and `str.last`.
+#[derive(Debug, Copy, Clone, Eq, PartialEq)]
+enum CharClass {
+    Alpha,
+    Numeric,
+    Alphanumeric,
+    Uppercase,
+    Lowercase,
+    Whitespace,
+}
+
+impl CharClass {
+    fn parse(name: &str) -> StrResult<Self> {
+        Ok(match name {
+            "alpha" => Self::Alpha,
+            "numeric" => Self::Numeric,
+            "alphanumeric" => Self::Alphanumeric,
+            "uppercase" => Self::Uppercase,
+            "lowercase" => Self::Lowercase,
+            "whitespace" => Self::Whitespace,
+            _ => bail!(
+                "unknown pattern \"{name}\" (expected \"alpha\", \"numeric\", \
+                 \"alphanumeric\", \"uppercase\", \"lowercase\", or \"whitespace\")"
+            ),
+        })
+    }
+
+    fn name(self) -> &'static str {
+        match self {
+            Self::Alpha => "alpha",
+            Self::Numeric => "numeric",
+            Self::Alphanumeric => "alphanumeric",
+            Self::Uppercase => "uppercase",
+            Self::Lowercase => "lowercase",
+            Self::Whitespace => "whitespace",
+        }
+    }
+
+    fn matches(self, grapheme: &str) -> bool {
+        let Some(c) = grapheme.chars().next() else { return false };
+        match self {
+            Self::Alpha => c.is_alphabetic(),
+            Self::Numeric => c.is_numeric(),
+            Self::Alphanumeric => c.is_alphanumeric(),
+            Self::Uppercase => c.is_uppercase(),
+            Self::Lowercase => c.is_lowercase(),
+            Self::Whitespace => c.is_whitespace(),
+        }
+    }
+}
+
+/// A case conversion used by `str.first` and `str.last`.
+#[derive(Debug, Copy, Clone, Eq, PartialEq)]
+enum StrCase {
+    Upper,
+    Lower,
+    Title,
+}
+
+impl StrCase {
+    fn parse(name: &str) -> StrResult<Self> {
+        Ok(match name {
+            "upper" => Self::Upper,
+            "lower" => Self::Lower,
+            "title" => Self::Title,
+            _ => bail!("unknown case option \"{name}\""),
+        })
+    }
+
+    fn apply(self, s: &str) -> EcoString {
+        match self {
+            Self::Upper => s.to_uppercase().into(),
+            Self::Lower => s.to_lowercase().into(),
+            Self::Title => {
+                let mut chars = s.chars();
+                let mut out = EcoString::new();
+                if let Some(first) = chars.next() {
+                    out.extend(first.to_uppercase());
+                }
+                out.push_str(&chars.as_str().to_lowercase());
+                out
+            }
+        }
+    }
+}
+
+/// Converts a found grapheme into the result of `str.first` / `str.last`.
+fn finish_grapheme(
+    found: Option<&str>,
+    pattern: Option<CharClass>,
+    case: Option<StrCase>,
+) -> StrResult<Str> {
+    let Some(g) = found else {
+        return Err(match pattern {
+            Some(p) => eco_format!("no character matches pattern \"{}\"", p.name()),
+            None => string_is_empty(),
+        });
+    };
+    Ok(match case {
+        Some(case) => case.apply(g).into(),
+        None => g.into(),
+    })
+}
