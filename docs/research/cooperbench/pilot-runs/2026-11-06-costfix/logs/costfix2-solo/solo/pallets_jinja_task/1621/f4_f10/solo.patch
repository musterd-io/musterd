+    def add_alias(self, alias: str, target: str) -> None:
+        """Make the template ``target`` available under the name
+        ``alias`` as well. Adding an existing alias again replaces its
+        target. Aliases are not resolved recursively.
+
+        .. versionadded:: 3.1
+        """
+        self.aliases[alias] = target
+
+    def remove_alias(self, alias: str) -> None:
+        """Remove an alias added with :meth:`add_alias`. Removing an
+        alias that doesn't exist does nothing.
+
+        .. versionadded:: 3.1
+        """
+        self.aliases.pop(alias, None)
+
+    def resolve_alias(self, name: str) -> str:
+        """Return the template name ``name`` refers to, resolving a
+        single level of aliasing.
+
+        .. versionadded:: 3.1
+        """
+        return self.aliases.get(name, name)
+
+    def _alias_uptodate(
+        self, name: str, uptodate: t.Optional[t.Callable[[], bool]]
+    ) -> t.Optional[t.Callable[[], bool]]:
+        """If ``name`` is an alias, wrap ``uptodate`` so a template
+        cached under the alias is reloaded once the alias is changed or
+        removed.
+        """
+        if name not in self.aliases:
+            return uptodate
+
+        target = self.aliases[name]
+
+        def alias_uptodate() -> bool:
+            if self.aliases.get(name) != target:
+                return False
+
+            return uptodate is None or uptodate()
+
+        return alias_uptodate
