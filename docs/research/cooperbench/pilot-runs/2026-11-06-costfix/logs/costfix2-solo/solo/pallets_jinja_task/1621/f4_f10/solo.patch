+        """Mapping of alias names to the template names they refer to.
+        Created lazily so subclasses don't need to call the base
+        ``__init__``.
+        """
+        try:
+            return self.__dict__["_aliases"]  # type: ignore[no-any-return]
+        except KeyError:
