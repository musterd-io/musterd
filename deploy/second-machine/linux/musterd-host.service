# The wake actuator (`musterd host`): wakes this machine's enrolled seats and stands up the seats
# `musterd move --to` sends here. Runs from the runtime checkout so a moved seat's Workspace can be a
# worktree of it. The Linux twin of studio.sandrise.musterd-host.
[Unit]
Description=musterd wake actuator
After=musterd-daemon.service
Wants=musterd-daemon.service

[Service]
WorkingDirectory=%h/.musterd/runtime
Environment=PATH=%h/.opencode/bin:%h/.npm-global/bin:%h/.local/share/pnpm/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node %h/.musterd/runtime/packages/cli/dist/bin.js host
# A restart (the refresher's, after a build) must not kill a seat mid-wake: the harness is a
# detached child, and the default control-group kill would take it down with the loop.
KillMode=process
Restart=always
RestartSec=5
StandardOutput=append:%h/.musterd/host.log
StandardError=append:%h/.musterd/host.err.log

[Install]
WantedBy=default.target
