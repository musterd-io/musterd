{
  "name": "@musterd/whiteboard",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone shared whiteboard for human+agent brainstorming: provider-agnostic port, Squig (vendored, ADR 537) as its canvas, the board service, and its own whiteboard_* MCP server (ADR 330). Deliberately imports nothing from @musterd/* — extractable to its own repository at any time.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "whiteboard": "./dist/mcp/index.js",
    "agent-whiteboard-mcp": "./dist/mcp/index.js",
    "agent-whiteboard-service": "./dist/service.js"
  },
  "files": [
    "dist",
    "SKILL.md",
    "vendor"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "dev:service": "tsx src/service.ts",
    "test": "vitest run",
    "vendor:squig": "node scripts/vendor-squig.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@resvg/resvg-js": "2.6.2",
    "sharp": "0.35.4",
    "tslib": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vite": "8.1.0",
    "vitest": "^4.1.11"
  }
}
