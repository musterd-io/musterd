{
  "name": "@musterd/protocol",
  "version": "0.5.0",
  "description": "musterd protocol: shared types + zod schemas (the wire contract)",
  "license": "MIT",
  "homepage": "https://musterd.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/musterd-io/musterd.git",
    "directory": "packages/protocol"
  },
  "bugs": "https://github.com/musterd-io/musterd/issues",
  "keywords": [
    "agents",
    "multi-agent",
    "coordination",
    "mcp",
    "team",
    "protocol",
    "zod",
    "schemas"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build-stamp": {
      "types": "./dist/build-stamp.d.ts",
      "default": "./dist/build-stamp.js"
    },
    "./project": {
      "types": "./dist/project.d.ts",
      "default": "./dist/project.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "default": "./dist/model.js"
    },
    "./note-seal": {
      "types": "./dist/note-seal.d.ts",
      "default": "./dist/note-seal.js"
    },
    "./posture": {
      "types": "./dist/posture.d.ts",
      "default": "./dist/posture.js"
    },
    "./hue": {
      "types": "./dist/hue.d.ts",
      "default": "./dist/hue.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts",
      "default": "./dist/wire.js"
    },
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "default": "./dist/calendar.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/stamp-build.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "smol-toml": "^1.9.0",
    "zod": "^3.24.1"
  }
}
