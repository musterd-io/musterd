{
  "name": "@musterd/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "musterd on the phone — the sealed ask client and the phone authenticator (ADR 676). Expo on React Native's New Architecture; every ask arrives sealed through the away relay and every answer is signed on this phone.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "eas-build-post-install": "pnpm --filter @musterd/protocol build"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@musterd/protocol": "workspace:*",
    "expo": "~58.0.17",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0"
  }
}
