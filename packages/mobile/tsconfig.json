{
  // The repo's strictness first, then Expo's module and JSX settings (ADR 520 Consequences).
  "extends": ["../../tsconfig.base.json", "expo/tsconfig.base"],
  "compilerOptions": {
    "declaration": false,
    "sourceMap": false,
    "types": ["react"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "expo-env.d.ts"],
  // Like every package's tsconfig: tests run under vitest, they are not compiled by tsc —
  // and the mobile tests import node:crypto, which app code must never see.
  "exclude": ["src/**/*.test.ts"]
}
