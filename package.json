{
  "name": "musterd-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "node scripts/format.ts --write",
    "format:check": "node scripts/format.ts --check && pnpm roadmap:check && pnpm roadmap-truth:check && pnpm arch-trees:check && pnpm obs-evals:check && pnpm adr-numbers:check && pnpm guidance:check && pnpm vocab:check && pnpm claims:check && pnpm tokens:check && pnpm migrations:check && pnpm source-nul:check && pnpm build-context:check && pnpm wiki:check && pnpm intents:check && pnpm controls:check && pnpm watch:check && pnpm ledger:check && pnpm tour:check",
    "adr:next": "node --disable-warning=ExperimentalWarning scripts/adr-next.ts",
    "bench:cli-start": "node --disable-warning=ExperimentalWarning scripts/bench-cli-start.ts",
    "adr-numbers:check": "node --disable-warning=ExperimentalWarning scripts/check-adr-numbers.ts",
    "migrations:check": "node --disable-warning=ExperimentalWarning scripts/check-migrations.ts",
    "source-nul:check": "node --disable-warning=ExperimentalWarning scripts/check-source-nul.ts",
    "build-context:check": "node --disable-warning=ExperimentalWarning scripts/check-build-context.ts",
    "dist:check": "node --disable-warning=ExperimentalWarning scripts/check-dist-freshness.ts",
    "npm:downloads": "node --disable-warning=ExperimentalWarning scripts/npm-downloads.ts",
    "traction": "node --disable-warning=ExperimentalWarning scripts/traction.ts",
    "vocab:check": "node --disable-warning=ExperimentalWarning scripts/check-vocab.ts",
    "claims:check": "node --disable-warning=ExperimentalWarning scripts/check-claims.ts",
    "tokens:check": "node --disable-warning=ExperimentalWarning scripts/check-css-tokens.ts",
    "wiki:index": "node --disable-warning=ExperimentalWarning scripts/wiki-index.ts",
    "wiki:check": "node --disable-warning=ExperimentalWarning scripts/check-wiki.ts",
    "ledger:check": "node --disable-warning=ExperimentalWarning scripts/check-ledger.ts",
    "intents:check": "node --disable-warning=ExperimentalWarning scripts/check-intents.ts",
    "goals:audit": "node --disable-warning=ExperimentalWarning scripts/goals-audit.ts",
    "controls:check": "node --disable-warning=ExperimentalWarning scripts/check-controls.ts",
    "watch:check": "node --disable-warning=ExperimentalWarning scripts/check-watches.ts",
    "wiki:probe": "node --disable-warning=ExperimentalWarning scripts/wiki-probe.ts",
    "perf:check": "node --disable-warning=ExperimentalWarning scripts/perf/check-budgets.ts",
    "a11y:contrast": "node scripts/a11y/contrast-sweep.mjs",
    "a11y:targets": "node scripts/a11y/target-size-sweep.mjs",
    "a11y:targets:check": "node scripts/a11y/target-size-gate.mjs",
    "scene:pixel-check": "node scripts/perf/scene-pixel-check.mjs",
    "a11y:check": "node scripts/a11y/contrast-gate.mjs",
    "context:check": "node --disable-warning=ExperimentalWarning scripts/context/check-budgets.ts",
    "guidance:check": "node --disable-warning=ExperimentalWarning scripts/check-guidance.ts",
    "roadmap:gen": "node --disable-warning=ExperimentalWarning scripts/gen-roadmap.ts",
    "roadmap:check": "node --disable-warning=ExperimentalWarning scripts/gen-roadmap.ts --check",
    "tour:gen": "node --disable-warning=ExperimentalWarning scripts/gen-tour.ts",
    "tour:check": "node --disable-warning=ExperimentalWarning scripts/gen-tour.ts --check",
    "roadmap-truth:check": "node --disable-warning=ExperimentalWarning scripts/check-roadmap-truth.ts",
    "steward:scan": "node --disable-warning=ExperimentalWarning scripts/steward/scan.ts",
    "steward:notify": "node --disable-warning=ExperimentalWarning scripts/steward/notify.ts",
    "radar:sweep": "node --disable-warning=ExperimentalWarning scripts/radar/sweep.ts",
    "liveness:sweep": "node --disable-warning=ExperimentalWarning scripts/research/adr-166-slot-sweep.ts",
    "wakes:repeats": "node --disable-warning=ExperimentalWarning scripts/research/adr-250-repeat-wakes.ts",
    "delivery:measure": "node --disable-warning=ExperimentalWarning scripts/research/delivery-measurement.ts",
    "adr250:asks-per-pr": "node --disable-warning=ExperimentalWarning scripts/research/adr-250-asks-per-pr.ts",
    "adr250:capability-miss": "node --disable-warning=ExperimentalWarning scripts/research/adr-250-capability-miss.ts",
    "adr250:repeat-wakes": "node --disable-warning=ExperimentalWarning scripts/research/adr-250-repeat-wakes.ts",
    "disputes:readout": "node --disable-warning=ExperimentalWarning scripts/research/sycophancy-readout.ts",
    "sycophancy:readout": "pnpm disputes:readout",
    "style:readout": "node --disable-warning=ExperimentalWarning scripts/research/style-readout.ts",
    "next:readout": "node --disable-warning=ExperimentalWarning scripts/research/next-readout.ts",
    "critique:experiment": "node --disable-warning=ExperimentalWarning scripts/research/critique-channel-experiment.ts",
    "wake:rail": "node --disable-warning=ExperimentalWarning scripts/research/wake-contract-rail.ts",
    "corpus:snapshot": "node --disable-warning=ExperimentalWarning scripts/corpus/snapshot.ts",
    "dataset:export": "node --disable-warning=ExperimentalWarning scripts/dataset/export.ts",
    "dataset:exn-snapshot": "node --disable-warning=ExperimentalWarning scripts/dataset/exn-snapshot.ts",
    "release": "node --disable-warning=ExperimentalWarning scripts/release.ts",
    "bump-brew-formula": "node --disable-warning=ExperimentalWarning scripts/bump-brew-formula.ts",
    "arch-trees:check": "node --disable-warning=ExperimentalWarning scripts/check-arch-trees.ts --check",
    "obs-evals:check": "node --disable-warning=ExperimentalWarning scripts/check-obs-evals.ts --check",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "coverage:merge": "vitest run --merge-reports=coverage-blobs --coverage",
    "test:scenarios": "vitest run tests/scenarios",
    "test:codex-cli-real": "vitest run tests/codex-cli.acceptance.test.ts",
    "typecheck": "pnpm dist:check && pnpm -r exec tsc --noEmit && pnpm exec tsc -p content/tsconfig.json && pnpm exec tsc -p scripts/tsconfig.json",
    "change-adr:check": "node --disable-warning=ExperimentalWarning scripts/check-change-adr.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.4",
    "@musterd/mcp": "workspace:*",
    "@musterd/protocol": "workspace:*",
    "@musterd/server": "workspace:*",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.15.0",
    "prettier": "^3.8.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.61.1",
    "ulid": "^2.3.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "@opentelemetry/propagator-jaeger@<2.9.0": ">=2.9.0",
      "@grpc/grpc-js": "1.14.5",
      "brace-expansion@^1.0.0": "1.1.21",
      "brace-expansion@^5.0.0": "5.0.12",
      "esbuild@<0.28.1": ">=0.28.1",
      "js-yaml@<4.3.2": "4.3.2",
      "seroval": "1.6.3",
      "source-map-js": "1.2.2",
      "uuid@^7.0.0": "11.1.1",
      "vite@<6.4.3": "^6.4.3"
    },
    "patchedDependencies": {
      "node-forge@1.4.0": "patches/node-forge@1.4.0.patch",
      "braces@3.0.3": "patches/braces@3.0.3.patch"
    }
  }
}
